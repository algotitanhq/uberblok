    gaugeLabel: "La caché, 16 bloques: MRU desde la izquierda, MFU desde la derecha, el objetivo de MRU como una línea",
  },
}[lang];
const S = { ...Object.fromEntries(Object.entries(S0).map(([k, v]) => [k, lang === "fr" ? fr(v) : v])), lang } as unknown as ArcStrings;
const t = UI[lang];
const s0 = opening();
const gapName = `arc-gap-${lang}`;
---

<figure class="arc" data-arc data-strings={JSON.stringify(S)} aria-label={S.figure}>
  <div class="stepbar" hidden>
    <button class="btn btn--primary" type="button" data-act="next" aria-describedby={`arc-queue-${lang}`}>{S.next}</button>
    <div class="say">
      <p class="queue" id={`arc-queue-${lang}`} data-queue>{queueLine(S, [], null, 0, "N1")}</p>
      <p class="narration" data-narration aria-live="polite"></p>
    </div>
  </div>
  <div class="arc-bar" hidden>
    <div class="buttons">
      <button class="btn" type="button" data-act="scan">{S.scanBtn}</button>
      <button class="btn" type="button" data-act="hot">{S.hotBtn}</button>
      <button class="btn" type="button" data-act="rest" disabled>{S.rest}</button>
      <button class="btn" type="button" data-act="reset">{S.reset}</button>
    </div>
    <fieldset class="gap">
      <legend>{S.gapLabel}</legend>
      <label><input type="radio" name={gapName} value="1000" checked /> {S.gap1}</label>
      <label><input type="radio" name={gapName} value="10" /> {S.gap10}</label>
    </fieldset>
    <p class="clock" data-clock>{clock(s0, S)}</p>
    <p class="hint muted">{S.hint}</p>
  </div>
  <p class="visually-hidden" data-summary>{summary(s0, S)}</p>
  <div class="arc-gauge" role="img" aria-label={S.gaugeLabel}>
    <div data-gauge set:html={gauge(s0, S)} />
    <p class="balance" data-balance>{balance(s0, S)}</p>
  </div>
  <div class="arc-board" data-board set:html={board(s0, S, false)} />
  <ul class="arc-legend" aria-hidden="true">
    <li><span class="chip mfu">H1</span>{S.legendLive}</li>
    <li><span class="chip mru_ghost">S1</span>{S.legendGhost}</li>
    <li><span class="chip gone">S1</span>{S.legendGone}</li>
    <li class="js-only" hidden><span class="chip mru hit">S2</span>{S.legendHit}</li>
    <li class="js-only" hidden><span class="chip mru_ghost out">S1</span>{S.legendOut}</li>
  </ul>
  <noscript><p class="muted">{t.noScript}</p></noscript>
  <section class="arc-log" aria-labelledby={`arc-log-${lang}`} hidden>
    <h3 id={`arc-log-${lang}`}>{S.logLabel}</h3>
    <ol data-log><li class="muted">{S.logEmpty}</li></ol>
  </section>
  <details class="text-version">
    <summary>{t.textVersion}</summary>
    <div data-describe set:html={describe(s0, S)} />
  </details>
</figure>

<script>
  import { strings, wait, reducedMotion } from "../lib/svg";
  import { opening, read, next, HOT, type Arc, type Ev } from "../lib/arc";
  import { board, gauge, balance, clock, describe, summary, eventLine, eventClass, marks, narrate, queueLine, NO_MARKS, type ArcStrings, type Marks } from "../lib/arc-view";

  for (const root of document.querySelectorAll<HTMLElement>("[data-arc]")) {
    const S = strings<ArcStrings>(root);
    const q = <E extends Element = HTMLElement>(sel: string) => root.querySelector(sel) as E;
    const boardEl = q("[data-board]");
    const logEl = q("[data-log]");
    const narration = q("[data-narration]");
    let s: Arc = opening();
    let run = 0;
    // The reads still to come of a scan or of the hot set: one per press of Next read.
    let queue: string[] = [];
    let kind: "scan" | "hot" | null = null;
    let total = 0;
    const gap = () => Number(root.querySelector<HTMLInputElement>("input[type=radio]:checked")?.value ?? 1000);
    // The name Next read gives a new block, without taking it from the model's counter.
    const nextNew = () => `N${s.seq.N + 1}`;

    const keyOf = (el: Element | null) => {
      if (!(el instanceof HTMLElement) || !root.contains(el)) return null;
      if (el.dataset.act) return `[data-act="${el.dataset.act}"]`;
      if (el.dataset.id) return `button[data-id="${el.dataset.id}"]`;
      return null;
    };

    function render(m: Marks = NO_MARKS, focusKey: string | null = keyOf(document.activeElement)) {
      boardEl.innerHTML = board(s, S, true, m);
      q("[data-gauge]").innerHTML = gauge(s, S);
      q("[data-balance]").textContent = balance(s, S);
      q(".arc-gauge").classList.toggle("hit", m.balance);
      q("[data-clock]").textContent = clock(s, S);
      q("[data-summary]").textContent = summary(s, S);
      q("[data-describe]").innerHTML = describe(s, S);
      q("[data-queue]").textContent = queueLine(S, queue, kind, total, nextNew());
      q<HTMLButtonElement>('[data-act="rest"]').disabled = queue.length < 2;
      if (focusKey) {
        const el = root.querySelector<HTMLElement>(focusKey);
        // A disabled button cannot keep the focus: hand it to Next read.
        (el && !(el as HTMLButtonElement).disabled ? el : q('[data-act="next"]')).focus({ preventScroll: true });
      }
    }

    // FLIP: each chip that changed list slides from where it was; a new one fades in.
    const rects = () => {
      const m = new Map<string, DOMRect>();
      for (const c of boardEl.querySelectorAll<HTMLElement>("[data-id]")) m.set(c.dataset.id!, c.getBoundingClientRect());
      return m;
    };

    // On a phone the figure is taller than the screen: after a read, bring the
    // block read into view if it is not, above the bar with Next read, which
    // sticks to the bottom (as in the TXG room, D24.1). A chip may still be
    // gliding from its old place: measure where it lands.
    const phone = matchMedia("(max-width: 40rem)");
    function show(el: Element | null) {
      if (!el || !phone.matches) return;
      const r = el.getBoundingClientRect();
      const dy = new DOMMatrix(getComputedStyle(el).transform).m42;
      const top = r.top - dy;
      const bottom = r.bottom - dy;
      const room = Math.min(q(".stepbar").getBoundingClientRect().top, innerHeight) - 8;
      if (top >= 8 && bottom <= room) return;
      window.scrollBy({ top: top < 8 ? top - 8 : bottom - room, behavior: reducedMotion() ? "auto" : "smooth" });
    }

    /** Reads `ids` in order, the first after the chosen gap, the others 1 ms apart, as a scan does. */
    async function act(ids: string[], first = gap()) {
      const me = ++run;
      const before = rects();
      const ev: Ev[] = [];
      ids.forEach((id, i) => {
        s.now += i ? 1 : first;
        ev.push(...read(s, id));
      });
      const m = marks(ev);
      render(m);
      if (!reducedMotion()) {
        for (const c of boardEl.querySelectorAll<HTMLElement>("[data-id]")) {
          const from = before.get(c.dataset.id!);
          const to = c.getBoundingClientRect();
          if (!from) c.animate([{ opacity: 0, transform: "translateY(-6px)" }, { opacity: 1, transform: "none" }], { duration: 420, easing: "cubic-bezier(0.2, 0.7, 0.2, 1)" });
          else if (Math.abs(from.left - to.left) > 1 || Math.abs(from.top - to.top) > 1)
            c.animate([{ transform: `translate(${from.left - to.left}px, ${from.top - to.top}px)` }, { transform: "none" }], { duration: 560, easing: "cubic-bezier(0.2, 0.7, 0.2, 1)" });
        }
      }
      // Cleared first, so that the same sentence twice is announced twice.
      narration.textContent = "";
      const said = ids.length === 1 ? narrate(S, ev) : summary(s, S);
      requestAnimationFrame(() => (narration.textContent = said));
      const hit = m.hit[m.hit.length - 1];
      requestAnimationFrame(() => show(hit ? boardEl.querySelector(`[data-id="${hit}"]`) : null));
      logEl.replaceChildren();
      for (let i = 0; i < ev.length; i++) {
        const li = document.createElement("li");
        li.className = eventClass(ev[i]);
        li.innerHTML = eventLine(S, ev[i]);
        logEl.append(li);
        if (ev.length < 12 && !reducedMotion()) {
          await wait(70);
          if (me !== run) return;
        }
      }
    }

    // A scan or the hot set: its first read now, the others one per Next read.
    // Selecting a block meanwhile ends it (below).
    function start(ids: string[], k: "scan" | "hot") {
      kind = k;
      total = ids.length;
      queue = ids.slice(1);
      if (!queue.length) kind = null;
      void act([ids[0]]);
    }
    function step() {
      if (!queue.length) return void act(next(s, "N"));
      const id = queue.shift()!;
      const k = kind;
      if (!queue.length) kind = null;
      // Within a scan or the hot set, reads are 1 ms apart.
      void act([id], k ? 1 : gap());
    }

    root.addEventListener("click", (e) => {
      const el = (e.target as Element).closest<HTMLElement>("button");
      if (!el || !root.contains(el)) return;
      const d = el.dataset;
      if (d.act === "next") step();
      else if (d.act === "scan") start(next(s, "S", 12), "scan");
      else if (d.act === "hot") start(HOT, "hot");
      else if (d.act === "rest") {
        const ids = queue;
        queue = [];
        kind = null;
        void act(ids, 1);
      } else if (d.act === "reset") {
        run++;
        s = opening();
        queue = [];
        kind = null;
        logEl.innerHTML = `<li class="muted">${S.logEmpty}</li>`;
        narration.textContent = "";
        render();
      } else if (d.id) {
        // Selecting a block ends a scan or a hot set under way, so that the reads
        // of a queue stay 1 ms apart, as in the hand-checked sequence.
        queue = [];
        kind = null;
        void act([d.id]);
      }
    });

    render(NO_MARKS, null);
    for (const el of root.querySelectorAll<HTMLElement>(".arc-bar, .stepbar, .arc-log, .js-only")) el.hidden = false;
  }
</script>

