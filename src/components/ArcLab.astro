    logEmpty: "Nada todavía. El estado inicial: el conjunto caliente H1 a H6 se leyó dos veces, con un segundo de intervalo.",
    legendLive: "bloque en memoria",
    legendGhost: "solo la cabecera",
    legendGone: "olvidado",
    legendHit: "el bloque recién leído",
