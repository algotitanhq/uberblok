    blk1: "{n} bloque",
    blkN: "{n} bloques",
    hdr1: "{n} cabecera",
    hdrN: "{n} cabeceras",
    ghostMeta: "{n}, sin datos · como máximo {cap} · aciertos fantasma {hits}",
    head: "cabeza, el más reciente",
    tail: "cola, el primero en salir",
