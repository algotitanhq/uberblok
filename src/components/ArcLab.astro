---
// The figure of the ARC room: the data lists of MRU, MFU and their ghosts, the
// blocks forgotten, and a gauge of arc_c with the MRU target. The visitor
// reads blocks, one read per press of Next read; src/lib/arc.ts (a
// transcription of arc_access, arc_evict, arc_evict_adj and arc_evict_hdr)
// decides every outcome, and src/lib/arc-view.ts draws it, at build time for
// the opening state (readable without JavaScript) and in the browser after.
// Each read outlines the block read and the blocks it pushed out (D25.1).
// Refs: ANALYSIS.md, room "The ARC"; simplifications: DECISIONS.md D6.2.
import type { Lang } from "../lib/rooms";
import { UI } from "../lib/ui";
import { fr } from "../lib/fr";
import { opening } from "../lib/arc";
import { board, gauge, balance, clock, describe, summary, queueLine, type ArcStrings } from "../lib/arc-view";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const S0 = {
