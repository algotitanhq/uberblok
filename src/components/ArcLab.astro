---
// The figure of the ARC room: the data lists of MRU, MFU and their ghosts, the
// blocks forgotten, and a gauge of arc_c with the MRU target. The visitor
// reads blocks; src/lib/arc.ts (a transcription of arc_access, arc_evict,
// arc_evict_adj and arc_evict_hdr) decides every outcome, and
// src/lib/arc-view.ts draws it, at build time for the opening state (readable
// without JavaScript) and in the browser after. Refs: ANALYSIS.md, room
// "The ARC"; simplifications: DECISIONS.md D6.2.
import type { Lang } from "../lib/rooms";
import { UI } from "../lib/ui";
import { gh } from "../lib/openzfs";
import { fr } from "../lib/fr";
import { opening } from "../lib/arc";
import { board, gauge, balance, clock, describe, summary, type ArcStrings } from "../lib/arc-view";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const A = "module/zfs/arc.c";
const refs = {
  anon: gh(A, 5381, 5397),
  mintime: gh(A, 5423, 5428),
  ghostMru: gh(A, 5437, 5449),
  mfu: gh(A, 5450, 5459),
  ghostMfu: gh(A, 5466, 5472),
  hits: gh(A, 4479, 4497),
  adj: gh(A, 4405, 4442),
  order: gh(A, 4543, 4556),
  hdr: gh(A, 3876, 3882),
  ghosts: gh(A, 4569, 4582),
