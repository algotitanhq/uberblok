---
// Figure 1 of the copy-on-write room: rewrite one data block and watch the
// change climb to the uberblock, the old tree left intact until the commit.
// Every step maps to code listed in ANALYSIS.md (room "Copy-on-write"):
//   new address      zio_write_compress, zio.c L2102-L2104
//   checksum in bp   zio_checksum_compute, zio_checksum.c L417
//   parent dirtied   dbuf_dirty(parent, tx), dbuf.c L2552
//   commit           vdev_uberblock_sync, vdev_label.c L1782-L1784
//   free or keep     dsl_dataset_block_kill, dsl_dataset.c L294, L332-L345
import type { Lang } from "../lib/rooms";
import { UI } from "../lib/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const S = {
  en: {
    figure: "A file’s block tree under one uberblock",
    modify: "Data block to modify",
    next: "Next step",
    play: "Play",
    crash: "Cut the power",
    snapshot: "Take a snapshot",
    snapshotTaken: "Snapshot of txg {txg} taken",
    reset: "Reset",
    step: "Step {n} of 5",
    idle: "The pool is at txg {txg}. Pick a data block, then press Next step to change it.",
    picked: "D{k} is picked. Press Next step to change it.",
    s1: "The new D{k} is written to free space, at {addr}. The old D{k} stays at {old}, untouched.",
    s2: "{p} holds the pointer to D{k}: its address and its checksum. That pointer has changed, so a new copy of {p} is written as well, at {addr}.",
    s3: "The same goes for R, the top of the file’s tree, now at {addr}. The pool still uses the old tree, because the uberblock of txg {txg} points to it.",
    s4: "The uberblock of txg {txg1} is written to slot {slot} of the ring. From now on the pool uses the new tree. The blocks that did not change belong to both trees.",
    s5free: "Nothing uses the replaced blocks any more, so they are freed: {list}.",
    s5dead: "The snapshot still uses the replaced blocks ({list}). They stay on disk, in grey, until the snapshot is destroyed.",
    s5mixed: "The snapshot keeps the replaced blocks it uses ({kept}). The others are freed ({freed}).",
    snapped: "Snapshot of txg {txg} taken. It keeps this tree as it is: the blocks marked S stay on disk as long as the snapshot exists, even after the file changes.",
    crashed: "Power lost before the uberblock of txg {txg1} was written. On import, ZFS takes the newest valid uberblock, txg {txg}, and finds its tree intact. The new blocks, in red, cannot be reached from it, so their space is still free. No fsck is needed. Writes an application forced with fsync are then replayed from the ZIL.",
    table: "Block pointers of the newest tree",
    from: "Pointer",
    dva: "Address",
    birth: "Birth",
    cksum: "Checksum",
    tableNote: "Changed pointers are marked. Checksums are real fletcher4 values over the demo blocks (last 8 hex digits of 64 shown).",
    ub: "uberblock",
    changed: "changed",
    prevUb: "previous",
    keptBySnap: "snapshot",
    keyPicked: "picked block",
    keyNew: "new copy",
    keyOld: "old copy, still on disk",
    keyPin: "kept by the snapshot",
    keyOrphan: "written, never committed",
    aria: "Tree: uberblock at txg {txg}, root R, indirect blocks I0 and I1, data blocks D0 to D3.",
  },
  fr: {
    figure: "L’arbre de blocs d’un fichier sous un uberblock",
    modify: "Bloc de données à modifier",
    next: "Étape suivante",
    play: "Tout dérouler",
    crash: "Couper le courant",
    snapshot: "Prendre un instantané",
    snapshotTaken: "Instantané du txg {txg} pris",
    reset: "Recommencer",
    step: "Étape {n} sur 5",
    idle: "Le pool est au txg {txg}. Choisissez un bloc de données, puis appuyez sur Étape suivante pour le modifier.",
    picked: "D{k} est choisi. Appuyez sur Étape suivante pour le modifier.",
    s1: "Le nouveau D{k} est écrit dans l’espace libre, en {addr}. L’ancien D{k} reste en {old}, intact.",
    s2: "{p} contient le pointeur vers D{k} : son adresse et sa somme de contrôle. Ce pointeur a changé, donc une nouvelle copie de {p} est écrite aussi, en {addr}.",
    s3: "Même chose pour R, le sommet de l’arbre du fichier, désormais en {addr}. Le pool utilise toujours l’ancien arbre, car l’uberblock du txg {txg} pointe vers lui.",
    s4: "L’uberblock du txg {txg1} est écrit dans la case {slot} de l’anneau. À partir de là, le pool utilise le nouvel arbre. Les blocs qui n’ont pas changé appartiennent aux deux arbres.",
    s5free: "Plus rien n’utilise les blocs remplacés, ils sont donc libérés : {list}.",
    s5dead: "L’instantané utilise encore les blocs remplacés ({list}). Ils restent sur le disque, en gris, jusqu’à la destruction de l’instantané.",
    s5mixed: "L’instantané garde les blocs remplacés qu’il utilise ({kept}). Les autres sont libérés ({freed}).",
    snapped: "Instantané du txg {txg} pris. Il garde cet arbre tel quel : les blocs marqués S restent sur le disque tant que l’instantané existe, même quand le fichier change.",
    crashed: "Courant coupé avant l’écriture de l’uberblock du txg {txg1}. À l’import, ZFS prend l’uberblock valide le plus récent, celui du txg {txg}, et trouve son arbre intact. Les nouveaux blocs, en rouge, ne sont pas atteignables depuis lui, et leur place reste libre. Aucun fsck n’est nécessaire. Les écritures forcées avec fsync sont ensuite rejouées depuis le ZIL.",
    table: "Pointeurs de bloc de l’arbre le plus récent",
    from: "Pointeur",
    dva: "Adresse",
    birth: "Naissance",
    cksum: "Somme de contrôle",
    tableNote: "Les pointeurs modifiés sont marqués. Les sommes sont de vraies valeurs fletcher4 calculées sur les blocs de démonstration (8 derniers chiffres hexadécimaux sur 64).",
    ub: "uberblock",
    changed: "modifié",
    prevUb: "précédent",
    keptBySnap: "instantané",
    keyPicked: "bloc choisi",
    keyNew: "nouvelle copie",
    keyOld: "ancienne copie, encore sur le disque",
    keyPin: "gardé par l’instantané",
    keyOrphan: "écrit, jamais validé",
    aria: "Arbre : uberblock au txg {txg}, racine R, blocs indirects I0 et I1, blocs de données D0 à D3.",
  },
  es: {
    figure: "El árbol de bloques de un archivo bajo un uberblock",
    modify: "Bloque de datos que modificar",
    next: "Paso siguiente",
    play: "Iniciar",
    crash: "Cortar la corriente",
    snapshot: "Tomar una instantánea",
    snapshotTaken: "Instantánea del txg {txg} tomada",
    reset: "Reiniciar",
    step: "Paso {n} de 5",
    idle: "El pool está en el txg {txg}. Elige un bloque de datos y pulsa Paso siguiente para cambiarlo.",
    picked: "D{k} está elegido. Pulsa Paso siguiente para cambiarlo.",
    s1: "El nuevo D{k} se escribe en espacio libre, en {addr}. El antiguo D{k} sigue en {old}, intacto.",
    s2: "{p} guarda el puntero a D{k}: su dirección y su suma de comprobación. Ese puntero ha cambiado, así que también se escribe una copia nueva de {p}, en {addr}.",
    s3: "Lo mismo pasa con R, la cima del árbol del archivo, ahora en {addr}. El pool sigue usando el árbol antiguo, porque el uberblock del txg {txg} apunta a él.",
    s4: "El uberblock del txg {txg1} se escribe en la ranura {slot} del anillo. A partir de ahí, el pool usa el árbol nuevo. Los bloques que no cambiaron pertenecen a los dos árboles.",
    s5free: "Ya nada usa los bloques sustituidos, así que se liberan: {list}.",
    s5dead: "La instantánea sigue usando los bloques sustituidos ({list}). Se quedan en el disco, en gris, hasta que se destruya la instantánea.",
    s5mixed: "La instantánea conserva los bloques sustituidos que usa ({kept}). Los demás se liberan ({freed}).",
    snapped: "Instantánea del txg {txg} tomada. Conserva este árbol tal como está: los bloques marcados con S se quedan en el disco mientras exista la instantánea, aunque el archivo cambie.",
    crashed: "La corriente se cortó antes de escribir el uberblock del txg {txg1}. Al importar, ZFS toma el uberblock válido más reciente, el del txg {txg}, y encuentra su árbol intacto. Los bloques nuevos, en rojo, no se pueden alcanzar desde él, así que su espacio sigue libre. No hace falta fsck. Las escrituras forzadas con fsync se vuelven a aplicar después desde el ZIL.",
    table: "Punteros de bloque del árbol más reciente",
    from: "Puntero",
    dva: "Dirección",
    birth: "Nacimiento",
    cksum: "Suma de comprobación",
    tableNote: "Los punteros modificados están marcados. Las sumas son valores fletcher4 reales calculados sobre los bloques de demostración (se muestran los 8 últimos dígitos hexadecimales de 64).",
    ub: "uberblock",
    changed: "modificado",
    prevUb: "anterior",
    keptBySnap: "instantánea",
    keyPicked: "bloque elegido",
    keyNew: "copia nueva",
    keyOld: "copia antigua, aún en el disco",
    keyPin: "conservado por la instantánea",
    keyOrphan: "escrito, nunca confirmado",
    aria: "Árbol: uberblock en el txg {txg}, raíz R, bloques indirectos I0 e I1, bloques de datos D0 a D3.",
  },
}[lang];
const t = UI[lang];
const textVersion = {
  en: [
    "The tree has an uberblock at the top, a root indirect block R, two indirect blocks I0 and I1, and four data blocks D0 to D3. Each block pointer holds the child’s address, its birth txg and its checksum.",
    "Rewriting a data block writes a new copy at a new address; the old copy stays where it is.",
    "Its parent now needs a new pointer (new address, new checksum), so the parent is copied too, and so on up to R.",
    "Writing the new uberblock to the next slot of the ring is the commit. Before it, a power cut leaves the old tree intact and current; after it, the pool uses the new tree.",
    "A snapshot keeps the tree of its txg: every block it reaches stays on disk. Replaced blocks are freed, unless the snapshot still uses them: then they stay, on the dataset’s deadlist, the list of blocks that only snapshots still hold.",
  ],
  fr: [
    "L’arbre a un uberblock au sommet, un bloc indirect racine R, deux blocs indirects I0 et I1, et quatre blocs de données D0 à D3. Chaque pointeur de bloc contient l’adresse de l’enfant, son txg de naissance et sa somme de contrôle.",
    "Réécrire un bloc de données écrit une nouvelle copie à une nouvelle adresse ; l’ancienne copie reste en place.",
    "Son parent a alors besoin d’un nouveau pointeur (nouvelle adresse, nouvelle somme) : le parent est copié à son tour, et ainsi de suite jusqu’à R.",
    "C’est l’écriture du nouvel uberblock dans la case suivante de l’anneau qui valide le txg. Avant elle, une coupure de courant laisse l’ancien arbre intact et toujours actif ; après elle, le pool utilise le nouvel arbre.",
    "Un instantané garde l’arbre de son txg : chaque bloc qu’il atteint reste sur le disque. Les blocs remplacés sont libérés, sauf si l’instantané les utilise encore : ils restent alors dans la deadlist du dataset, la liste des blocs que seuls les instantanés retiennent.",
  ],
  es: [
    "El árbol tiene un uberblock en la cima, un bloque indirecto raíz R, dos bloques indirectos I0 e I1, y cuatro bloques de datos D0 a D3. Cada puntero de bloque contiene la dirección del hijo, su txg de nacimiento y su suma de comprobación.",
    "Reescribir un bloque de datos escribe una copia nueva en una dirección nueva; la copia antigua se queda donde está.",
    "Su padre necesita entonces un puntero nuevo (dirección nueva, suma nueva), así que el padre también se copia, y así sucesivamente hasta R.",
    "Escribir el nuevo uberblock en la ranura siguiente del anillo es la confirmación. Antes de ella, un corte de corriente deja el árbol antiguo intacto y vigente; después de ella, el pool usa el árbol nuevo.",
    "Una instantánea conserva el árbol de su txg: cada bloque al que llega se queda en el disco. Los bloques sustituidos se liberan, salvo que la instantánea aún los use: entonces se quedan, en la deadlist del dataset, la lista de bloques que solo retienen las instantáneas.",
  ],
}[lang];
---

<figure class="cow" data-cow data-strings={JSON.stringify(S)}>
  <div class="layout">
    <div class="canvas">
      <svg viewBox="0 0 420 356" role="img" aria-label={S.figure}></svg>
      <ul class="key" hidden>
        <li><span class="swatch swatch--picked"></span>{S.keyPicked}</li>
        <li><span class="swatch swatch--new"></span>{S.keyNew}</li>
        <li><span class="swatch swatch--old"></span>{S.keyOld}</li>
        <li><span class="swatch swatch--pin">S</span>{S.keyPin}</li>
        <li><span class="swatch swatch--orphan"></span>{S.keyOrphan}</li>
      </ul>
      <noscript><p class="muted">{t.noScript}</p></noscript>
    </div>
    <div class="side">
      <div class="controls" hidden>
        <fieldset class="segmented">
          <legend>{S.modify}</legend>
          {
            [0, 1, 2, 3].map((k) => (
              <label>
                <input type="radio" name={`cow-leaf-${lang}`} value={k} checked={k === 2} />D{k}
              </label>
            ))
          }
        </fieldset>
        <div class="buttons">
          <button class="btn btn--primary" type="button" data-act="next">{S.next}</button>
          <button class="btn" type="button" data-act="play">{S.play}</button>
          <button class="btn" type="button" data-act="crash" disabled>{S.crash}</button>
          <button class="btn" type="button" data-act="snap">{S.snapshot}</button>
          <button class="btn" type="button" data-act="reset">{S.reset}</button>
        </div>
      </div>
      <p class="stepno" aria-hidden="true"></p>
      <p class="narration" aria-live="polite"></p>
    </div>
  </div>
  <div class="ptrs" hidden tabindex="0" role="region" aria-label={S.table}>
    <table>
      <caption>{S.table}</caption>
      <thead>
        <tr><th scope="col">{S.from}</th><th scope="col">{S.dva}</th><th scope="col">{S.birth}</th><th scope="col">{S.cksum}</th></tr>
      </thead>
      <tbody></tbody>
    </table>
    <p class="note">{S.tableNote}</p>
  </div>
  <details class="text-version">
    <summary>{t.textVersion}</summary>
    <ol>{textVersion.map((x) => <li>{x}</li>)}</ol>
  </details>
</figure>

<script>
  import { s, h, strings, fill, wait } from "../lib/svg";
  import { fletcher4, block, shortCksum, type Cksum } from "../lib/fletcher4";

  type St = "live" | "new" | "old" | "snap" | "freed" | "prevub" | "orphan";
  interface V {
    key: string;
    id: string;
    ver: number;
    birth: number;
    addr: number;
    kids: string[];
    bytes: Uint8Array;
    cksum: Cksum;
    state: St;
  }
  type S = Record<string, string>;

  const POS: Record<string, [number, number]> = {
    ub: [152, 8], r: [152, 98], i0: [56, 188], i1: [248, 188],
    d0: [8, 278], d1: [104, 278], d2: [200, 278], d3: [296, 278],
  };
  const PARENT: Record<string, string> = { d0: "i0", d1: "i0", d2: "i1", d3: "i1", i0: "r", i1: "r", r: "ub" };
  const W = 78, H = 46, OFF = 16;
  const label = (id: string) => (id === "ub" ? "UB" : id.toUpperCase());
  const hex = (a: number) => `0:${a.toString(16)}`;

  for (const root of document.querySelectorAll<HTMLElement>("[data-cow]")) {
    const t = strings<S>(root);
    const svg = root.querySelector("svg")!;
    const narration = root.querySelector<HTMLElement>(".narration")!;
    const stepno = root.querySelector<HTMLElement>(".stepno")!;
    const tbody = root.querySelector("tbody")!;
    const btn = (a: string) => root.querySelector<HTMLButtonElement>(`[data-act="${a}"]`)!;
    const radios = [...root.querySelectorAll<HTMLInputElement>('input[type="radio"]')];

    let vs: V[] = [];
    let txg = 41;
    let step = 0;
    let leaf = 2;
    let nextAddr = 0x40000;
    let snapTxg = 0;
    let pinned = new Set<string>();
    let busy = false;

    const get = (key: string) => vs.find((v) => v.key === key)!;
    const head = (id: string) => [...vs].reverse().find((v) => v.id === id && (v.state === "live" || v.state === "new"))!;

    function encode(kids: string[]): Uint8Array {
      // A parent's bytes are its block pointers: address, birth, checksum.
      const buf = new Uint8Array(kids.length * 48);
      const dv = new DataView(buf.buffer);
      kids.forEach((k, i) => {
        const c = get(k);
        dv.setBigUint64(i * 48, BigInt(c.addr), true);
        dv.setBigUint64(i * 48 + 8, BigInt(c.birth), true);
        c.cksum.forEach((w, j) => dv.setBigUint64(i * 48 + 16 + j * 8, w, true));
      });
      return buf;
    }

    function make(id: string, ver: number, birth: number, addr: number, kids: string[], state: St): V {
      const bytes = id.startsWith("d") ? block(`${label(id)} version ${ver}, txg ${birth}`) : encode(kids);
      const v = { key: `${id}@${ver}`, id, ver, birth, addr, kids, bytes, cksum: fletcher4(bytes), state };
      vs.push(v);
      return v;
    }

    function init() {
      vs = [];
      txg = 41;
      step = 0;
      nextAddr = 0x40000;
      snapTxg = 0;
      pinned = new Set();
      const births = [38, 40, 39, 41];
      const addrs = [0x12000, 0x2a000, 0x1c000, 0x31000];
      births.forEach((b, k) => make(`d${k}`, 1, b, addrs[k], [], "live"));
      make("i0", 1, 40, 0x2c000, ["d0@1", "d1@1"], "live");
      make("i1", 1, 41, 0x33000, ["d2@1", "d3@1"], "live");
      make("r", 1, 41, 0x35000, ["i0@1", "i1@1"], "live");
      make("ub", 1, 41, 41 % 32, ["r@1"], "live");
    }

    const vars = (extra: Record<string, string | number> = {}) => ({
      txg, txg1: txg + 1, k: leaf, slot: (txg + 1) % 32, p: label(PARENT[`d${leaf}`]), ...extra,
    });

    const say = (text: string) => narration.replaceChildren(text);

    // Blocks written before a power cut stay drawn, in red, until the next action. Then they
    // leave the list, so the next rewrite of the same block cannot reuse their key.
    const dropOrphans = () => {
      vs = vs.filter((v) => v.state !== "orphan");
    };

    function draw() {
      svg.replaceChildren();
      const shown = vs.filter((v) => v.state !== "freed");
      const offsets = new Map<string, number>();
      const seen: Record<string, number> = {};
      for (const v of shown) {
        seen[v.id] = (seen[v.id] ?? -1) + 1;
        offsets.set(v.key, Math.min(seen[v.id], 2) * OFF);
      }
      // A card with a newer version in front of it shows a one-line label in
      // the strip that stays visible above the front card.
      // After a power cut the unreachable blocks are drawn underneath, so the tree the pool
      // came back to stays whole on top.
      const behind = new Set(shown.filter((v) => shown.some((w) => w.id === v.id && w !== v && w.state !== "orphan" && offsets.get(w.key)! > offsets.get(v.key)!)).map((v) => v.key));
      shown.sort((a, b) => Number(b.state === "orphan") - Number(a.state === "orphan"));
      const at = (v: V): [number, number] => {
        const [x, y] = POS[v.id], o = offsets.get(v.key)!;
        return [x + o, y + o];
      };
      const edges = s("g", { class: "edges" });
      const cards = s("g", { class: "cards" });
      for (const v of shown) {
        const [x, y] = at(v);
        for (const k of v.kids) {
          const c = get(k);
          if (c.state === "freed") continue;
          const [cx, cy] = at(c);
          edges.append(s("path", { d: `M ${x + W / 2} ${y + H} C ${x + W / 2} ${y + H + 22}, ${cx + W / 2} ${cy - 22}, ${cx + W / 2} ${cy}`, class: `edge edge--${v.state}` }));
        }
        const tag = v.state === "snap" ? t.keptBySnap : v.state === "prevub" ? t.prevUb : `txg ${v.birth}`;
        const sub = v.id === "ub" ? `slot ${v.addr}` : hex(v.addr);
        // The opaque underlay hides the outline of the card behind (the new card's fill is translucent).
        const picked = v.id === `d${leaf}` && (v.state === "live" || v.state === "new") && !(step > 0 && step < 5);
        const pickable = v.id.startsWith("d") && v.state === "live" && !busy && !(step > 0 && step < 5);
        const g = s("g", { class: `card card--${v.state}${picked ? " card--picked" : ""}${pickable ? " card--pickable" : ""}`, transform: `translate(${x} ${y})`, "data-leaf": pickable ? v.id.slice(1) : undefined },
          s("rect", { width: W, height: H, rx: 4, class: "under" }),
          s("rect", { width: W, height: H, rx: 4 }),
        );
        // The pick wears a ring of its own, so the accent outline keeps meaning "new copy".
        if (picked) g.prepend(s("rect", { x: -3, y: -3, width: W + 6, height: H + 6, rx: 6, class: "ring" }));
        if (v.state === "orphan") {
          // An unreachable card shows only its outline from under the live one; the legend names it.
        } else if (behind.has(v.key)) g.append(s("text", { x: 6, y: 12, class: "strip" }, `${label(v.id)} · ${tag}`));
        else
          g.append(
            s("text", { x: 8, y: 18, class: "name" }, label(v.id)),
            s("text", { x: W - 7, y: 18, class: "tag", "text-anchor": "end" }, tag),
            s("text", { x: 8, y: 36, class: "addr" }, sub),
          );
        // A block the snapshot reaches carries an S until it is freed.
        if (pinned.has(v.key) && !behind.has(v.key))
          g.append(s("g", { class: "pin" }, s("rect", { x: W - 18, y: H - 18, width: 13, height: 13, rx: 3 }), s("text", { x: W - 11.5, y: H - 8, "text-anchor": "middle" }, "S")));
        cards.append(g);
      }
      svg.append(edges, cards);
      // A strip label may run over the front card's top edge, short of the next card; a longer one is squeezed rather than shrunk.
      for (const el of svg.querySelectorAll<SVGTextElement>(".strip"))
        if (el.getComputedTextLength() > W + OFF - 10) el.setAttribute("textLength", String(W + OFF - 10)), el.setAttribute("lengthAdjust", "spacingAndGlyphs");
      svg.setAttribute("aria-label", fill(t.aria, vars()));
      table();
      const writing = step > 0 && step < 5;
      btn("crash").disabled = busy || !(step >= 1 && step <= 3);
      btn("next").disabled = busy;
      btn("play").disabled = busy;
      btn("snap").disabled = busy || writing || snapTxg > 0;
      btn("snap").textContent = snapTxg ? fill(t.snapshotTaken, { txg: snapTxg }) : t.snapshot;
      btn("reset").disabled = busy;
      radios.forEach((r) => (r.disabled = busy || writing));
      stepno.textContent = writing || step === 5 ? fill(t.step, { n: step }) : "";
    }

    function table() {
      const rows: HTMLTableRowElement[] = [];
      const walk = (p: V) => {
        for (const k of p.kids) {
          const c = get(k);
          const changed = c.state === "new" || ((step === 4 || step === 5) && c.ver > 1 && c.birth === txg);
          rows.push(
            h("tr", { class: changed ? "changed" : undefined },
              h("th", { scope: "row" }, `${p.id === "ub" ? t.ub : label(p.id)} → ${label(c.id)}`, changed ? h("span", { class: "visually-hidden" }, ` (${t.changed})`) : ""),
              h("td", {}, hex(c.addr)),
              h("td", {}, String(c.birth)),
              h("td", {}, h("code", {}, `…${shortCksum(c.cksum)}`)),
            ),
          );
          if (c.kids.length) walk(c);
        }
      };
      walk(head("ub"));
      tbody.replaceChildren(...rows);
    }

    function rewrite(id: string, kids: string[]) {
      const old = head(id);
      old.state = "old";
      const v = make(id, old.ver + 1, txg + 1, nextAddr, kids, "new");
      nextAddr += 0x2000;
      return { v, old };
    }

    function advance() {
      const d = `d${leaf}`, p = PARENT[d];
      dropOrphans();
      if (step === 0 || step === 5) {
        if (step === 5) step = 0;
        const { v, old } = rewrite(d, []);
        step = 1;
        say(fill(t.s1, vars({ addr: hex(v.addr), old: hex(old.addr) })));
      } else if (step === 1) {
        const kids = head(p).kids.map((k) => (get(k).id === d ? head(d).key : k));
        const { v } = rewrite(p, kids);
        step = 2;
        say(fill(t.s2, vars({ addr: hex(v.addr) })));
      } else if (step === 2) {
        const kids = head("r").kids.map((k) => (get(k).id === p ? head(p).key : k));
        const { v } = rewrite("r", kids);
        step = 3;
        say(fill(t.s3, vars({ addr: hex(v.addr) })));
      } else if (step === 3) {
        const old = head("ub");
        // Only the previous uberblock is drawn; older ones are still in the ring.
        for (const v of vs) if (v.id === "ub" && v.state === "prevub") v.state = "freed";
        old.state = "prevub";
        const v = make("ub", old.ver + 1, txg + 1, (txg + 1) % 32, [head("r").key], "new");
        v.addr = (txg + 1) % 32;
        step = 4;
        say(fill(t.s4, vars()));
        txg += 1;
        for (const x of vs) if (x.state === "new") x.state = "live";
      } else if (step === 4) {
        const replaced = vs.filter((v) => v.state === "old");
        const kept = replaced.filter((v) => snapTxg && v.birth <= snapTxg);
        const freed = replaced.filter((v) => !kept.includes(v));
        kept.forEach((v) => (v.state = "snap"));
        freed.forEach((v) => (v.state = "freed"));
        const names = (l: V[]) => l.map((v) => label(v.id)).join(", ");
        step = 5;
        if (kept.length && freed.length) say(fill(t.s5mixed, { kept: names(kept), freed: names(freed) }));
        else if (kept.length) say(fill(t.s5dead, { list: names(kept) }));
        else say(fill(t.s5free, { list: names(freed) }));
      }
      draw();
    }

    function crash() {
      for (const v of vs) if (v.state === "new") v.state = "orphan";
      for (const v of vs) if (v.state === "old") v.state = "live";
      say(fill(t.crashed, vars()));
      step = 0;
      draw();
    }

    btn("next").addEventListener("click", advance);
    btn("crash").addEventListener("click", crash);
    btn("snap").addEventListener("click", () => {
      dropOrphans();
      snapTxg = txg;
      pinned = new Set(vs.filter((v) => v.state === "live").map((v) => v.key));
      say(fill(t.snapped, { txg }));
      draw();
    });
    btn("reset").addEventListener("click", () => {
      init();
      say(fill(t.idle, vars()));
      draw();
    });
    btn("play").addEventListener("click", async () => {
      busy = true;
      draw();
      do {
        advance();
        busy = true;
        draw();
        await wait(1400);
      } while (step !== 5);
      busy = false;
      draw();
      btn("next").focus();
    });
    radios.forEach((r) =>
      r.addEventListener("change", () => {
        leaf = Number(r.value);
        if (step === 5) step = 0;
        dropOrphans();
        say(fill(t.picked, vars()));
        draw();
      }),
    );

    // A data block in the drawing can be picked with the pointer too; the radios are the keyboard path.
    svg.addEventListener("click", (e) => {
      const card = (e.target as Element).closest<SVGGElement>("[data-leaf]");
      const radio = card && radios[Number(card.dataset.leaf)];
      if (!radio || radio.disabled || radio.checked) return;
      radio.checked = true;
      radio.dispatchEvent(new Event("change"));
    });

    init();
    say(fill(t.idle, vars()));
    root.querySelector<HTMLElement>(".controls")!.hidden = false;
    root.querySelector<HTMLElement>(".ptrs")!.hidden = false;
    root.querySelector<HTMLElement>(".key")!.hidden = false;
    draw();
  }
</script>

