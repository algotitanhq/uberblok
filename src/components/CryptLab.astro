---
// The encryption figure of the compression, dedup and encryption room: the 16
// words of a block pointer for four kinds of block, as spa.h lays them out;
// then a small encrypted file (dnode block, indirect block, three data
// blocks) read and scrubbed with its key loaded or not, with a bit that can
// be flipped on disk. src/lib/transforms.ts decides every outcome,
// src/lib/transforms-view.ts draws it. Refs: ANALYSIS.md, room "Compression,
// dedup, encryption", excerpts 3, 11 to 15; simplifications: DECISIONS.md D10.2.
import type { Lang } from "../lib/rooms";
import { UI } from "../lib/ui";
import { gh } from "../lib/openzfs";
import { fr } from "../lib/fr";
import { cryptFile } from "../lib/transforms";
import { wordsGrid, kindLine, cryptFileView, type TrStrings } from "../lib/transforms-view";
import { TRANSFORMS_STRINGS } from "../lib/transforms-strings";
import "../styles/transforms.css";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const SPA = "include/sys/spa.h";
const Z = "module/zfs/zio.c";
const refs = {
  k_plain: gh(SPA, 123, 186),
  k_encrypted: gh(SPA, 188, 225),
  k_authenticated: gh(Z, 5146, 5153),
  k_indirect: gh(Z, 5123, 5131),
  truncated: gh("module/zfs/zio_checksum.c", 508, 526),
  eacces: gh("module/zfs/dsl_crypt.c", 2818, 2823),
  scrub: gh("module/zfs/dsl_scan.c", 4841),
  clear: gh("module/os/linux/zfs/zio_crypt.c", 115, 120),
};
const S = { ...Object.fromEntries(Object.entries(TRANSFORMS_STRINGS[lang]).map(([k, v]) => [k, lang === "fr" ? fr(v) : v])), refs, lang } as unknown as TrStrings;
const t = UI[lang];
const KINDS = [
  ["plain", S.kindPlain],
  ["encrypted", S.kindEncrypted],
  ["authenticated", S.kindAuth],
  ["indirect", S.kindIndirect],
] as const;
const K0 = "encrypted";
const f0 = cryptFile([S.fileText0, S.fileText1, S.fileText2], "core", S.bonusText);
---

<figure class="cr" data-crypt data-strings={JSON.stringify(S)} aria-label={S.eFigure}>
  <div class="tr-bar" hidden>
    <div class="buttons" role="group" aria-label={S.kindLabel}>
      <span class="glabel">{S.kindLabel}</span>
      {KINDS.map(([k, l]) => <button class="btn" type="button" data-kind={k} aria-pressed={k === K0 ? "true" : "false"}>{l}</button>)}
    </div>
  </div>
  <div class="cr-grid">
    <div class="panel">
      <p class="kline" data-kline set:html={kindLine(S, K0)} />
      <div data-words set:html={wordsGrid(S, K0)} />
    </div>
    <div class="panel">
      <h3>{S.fileLabel}</h3>
      <div class="tr-bar" hidden>
        <div class="buttons">
          <button class="btn" type="button" data-key aria-pressed="true">{S.keyBtn}</button>
          <button class="btn btn--primary" type="button" data-act="scrub">{S.scrubBtn}</button>
          <button class="btn" type="button" data-act="read">{S.readBtn}</button>
          <button class="btn btn--danger" type="button" data-flip aria-pressed="false">{S.flipBtn}</button>
        </div>
      </div>
      <div data-file set:html={cryptFileView(S, f0, { key: true, flip: false, scrub: null, read: null })} />
    </div>
  </div>
  <p class="tr-now" data-now aria-hidden="true" hidden></p>
  <p class="visually-hidden" data-live aria-live="polite"></p>
  <noscript><p class="muted">{S.eNoScript}</p></noscript>
  <details class="text-version">
    <summary>{t.textVersion}</summary>
    <div data-describe>
      {KINDS.map(([k]) => <p set:html={kindLine(S, k).replace(/ ?<a class="see"[^>]*>[^<]*<\/a>/g, "")} />)}
      <p>{S.keyOffLine}</p>
    </div>
  </details>
</figure>

<script>
  import { strings, reducedMotion } from "../lib/svg";
  import { cryptFile, flipped, scrub, type BpKind, type CryptFile } from "../lib/transforms";
  import { wordsGrid, kindLine, cryptFileView, cryptLine, readAll, type CryptUi, spoken, type TrStrings } from "../lib/transforms-view";

  for (const root of document.querySelectorAll<HTMLElement>("[data-crypt]")) {
    const S = strings<TrStrings>(root);
    const q = <E extends Element = HTMLElement>(sel: string) => root.querySelector(sel) as E;
    const clean = cryptFile([S.fileText0, S.fileText1, S.fileText2], "core", S.bonusText);
    let kind: BpKind = "encrypted";
    const ui: CryptUi = { key: true, flip: false, scrub: null, read: null };
    const file = (): CryptFile => (ui.flip ? { ...clean, data: [clean.data[0], flipped(clean.data[1]), clean.data[2]] } : clean);

    /**
     * The visible line, and one announcement per action: the live region is
     * emptied, then filled on the next frame, so that the same text twice is
     * announced twice; it reads the line without its code links.
     */
    function say(html: string) {
      const el = q("[data-now]");
      el.hidden = false;
      el.innerHTML = html;
      const live = q("[data-live]");
      live.textContent = "";
      requestAnimationFrame(() => (live.textContent = spoken(html)));
    }

    function renderWords() {
      q("[data-words]").innerHTML = wordsGrid(S, kind);
      q("[data-kline]").innerHTML = kindLine(S, kind);
      for (const b of root.querySelectorAll<HTMLElement>("[data-kind]")) b.setAttribute("aria-pressed", String(b.dataset.kind === kind));
      if (!reducedMotion()) for (const tr of root.querySelectorAll<HTMLElement>("[data-words] tr.diff")) tr.animate([{ backgroundColor: "var(--accent-soft)", opacity: 0.3 }, { opacity: 1 }], { duration: 480, easing: "ease-out" });
    }

    function renderFile() {
      q("[data-file]").innerHTML = cryptFileView(S, file(), ui);
      q("[data-key]").setAttribute("aria-pressed", String(ui.key));
      q("[data-flip]").setAttribute("aria-pressed", String(ui.flip));
      if (!reducedMotion()) for (const el of root.querySelectorAll<HTMLElement>("[data-file] .sc, [data-file] .readout")) el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 320, easing: "ease-out" });
    }

    root.addEventListener("click", (e) => {
      const el = (e.target as Element).closest<HTMLElement>("button");
      if (!el || !root.contains(el)) return;
      if (el.dataset.kind) {
        kind = el.dataset.kind as BpKind;
        renderWords();
        say(kindLine(S, kind));
        return;
      }
      let act = "";
      if (el.hasAttribute("data-key")) {
        ui.key = !ui.key;
        act = "key";
      } else if (el.hasAttribute("data-flip")) {
        ui.flip = !ui.flip;
        act = "flip";
      } else if (el.dataset.act === "scrub") {
        ui.scrub = scrub(file());
        act = "scrub";
      } else if (el.dataset.act === "read") {
        ui.read = readAll(file(), ui.key);
        act = "read";
      } else return;
      // A change of key or disk makes the last scrub and read stale: they are cleared.
      if (act === "key" || act === "flip") {
        ui.scrub = null;
        ui.read = null;
      }
      renderFile();
      say(cryptLine(S, act, ui));
    });

    renderWords();
    renderFile();
    for (const b of root.querySelectorAll<HTMLElement>(".tr-bar")) b.hidden = false;
  }
</script>

<style>
  .cr-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
  }
  .kline {
    font-size: var(--step--1);
    margin: 0 0 var(--space-3);
  }
  @media (max-width: 56rem) {
    .cr-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
