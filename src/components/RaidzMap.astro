const S = Object.fromEntries(Object.entries(S0).map(([k, v]) => [k, lang === "fr" ? fr(v) : v])) as RzStrings;
const t = UI[lang];
// The default layout, rendered at build time: raidz2 on 6 children, 4K
// sectors, a 24 KiB block, which is not a multiple of the data width.
const D = { psize: 24576, nparity: 2, dcols: 6, ashift: 12, b: 0 };
const L = mapAlloc(D.psize, D.ashift, D.dcols, D.nparity, D.b * 2 ** D.ashift);
const id = `rz-${lang}`;
// The sizes the reader can write next, one press each.
const SIZES = [4096, 8192, 32768, 131072];
---

<figure class="rz" data-raidz data-strings={JSON.stringify(S)} data-lang={lang}>
  <form class="rz-controls" hidden>
    <label class="num">
      <span>{S.psize}</span>
      <input type="number" name="psize" min="512" max="131072" step="512" value={D.psize} inputmode="numeric" aria-describedby={`${id}-hint`} />
      <small id={`${id}-hint`} class="muted">{S.psizeHint}</small>
    </label>
    <fieldset class="segmented">
      <legend>{S.parity}</legend>
      {
        [1, 2, 3].map((p) => (
          <label>
            <input type="radio" name="nparity" value={p} checked={p === D.nparity} />
            raidz{p}
          </label>
        ))
      }
    </fieldset>
    <label class="num">
      <span>{S.children}</span>
      <input type="number" name="dcols" min="2" max="16" step="1" value={D.dcols} inputmode="numeric" />
    </label>
    <label class="num">
      <span>{S.ashift}</span>
      <select name="ashift">
        {[9, 10, 11, 12, 13, 14, 15, 16].map((a) => <option value={a} selected={a === D.ashift}>{`${a} (${2 ** a} ${S.unitB})`}</option>)}
      </select>
    </label>
    <label class="num">
      <span>{S.start}</span>
      <input type="number" name="b" min="0" max="100000000" step="1" value={D.b} inputmode="numeric" />
    </label>
  </form>
  <div class="rz-write" hidden>
    <span class="rz-write-label" id={`${id}-write`}>{S.write}</span>
    <div class="buttons" role="group" aria-labelledby={`${id}-write`}>
      {
        SIZES.map((n) => (
          <button class="btn" type="button" data-size={n}>
            {bytes(n, lang)}
          </button>
        ))
      }
      <button class="btn" type="button" data-act="clear">{S.clear}</button>
    </div>
  </div>
  <p class="rz-summary" data-summary set:html={summary(L, S, lang)} />
  <div class="rz-map" role="img" aria-label={`${S.figure}. ${summary(L, S, lang)}`} data-map set:html={grid(L, S)} />
  <ul class="rz-legend" aria-hidden="true">
    <li><span class="cell d d0">0</span>{S.legendData}</li>
    <li><span class="cell p">P</span>{S.legendParity}</li>
    <li><span class="cell k"></span>{S.legendSkip}</li>
    <li data-legend-old hidden><span class="cell o o0">A</span>{S.legendOld}</li>
    <li><span class="cell e"></span>{S.legendFree}</li>
  </ul>
  <p class="rz-note muted" data-write-note aria-live="polite"></p>
  <details class="rz-numbers">
    <summary>{S.numbers}</summary>
    <div data-readout set:html={readout(L, lang)} />
  </details>
  <noscript><p class="muted">{t.noScript}</p></noscript>
  <div class="rz-read" hidden>
    <h3>{S.damage}</h3>
    <ul class="rz-health" data-health></ul>
    <div class="buttons">
      <button class="btn btn--primary" type="button" data-act="read">{S.read}</button>
      <button class="btn" type="button" data-act="finish" hidden>{S.finish}</button>
      <button class="btn" type="button" data-act="heal">{S.reset}</button>
    </div>
    <ul class="rz-legend rz-legend-read" aria-hidden="true">
      <li><span class="cell d lit"></span>{S.legendRead}</li>
      <li><span class="cell d rebuilt"></span>{S.legendRebuilt}</li>
      <li><span class="cell d sim"></span>{S.legendSim}</li>
      <li><span class="cell d fixed"></span>{S.legendFixed}</li>
    </ul>
    <p class="rz-stepof muted" data-stepof></p>
    <ol class="rz-steps" data-steps></ol>
    <p class="visually-hidden" data-live aria-live="polite"></p>
  </div>
  <details class="text-version">
    <summary>{t.textVersion}</summary>
    <div data-describe set:html={describe(L, S, lang)} />
  </details>
</figure>

<script>
  import { strings, fill, wait, reducedMotion } from "../lib/svg";
  import { mapAlloc, readBlock, type Health, type Layout } from "../lib/raidz";
  import { grid, readout, describe, summary, readPlan, blockName, bytes, type RzStrings, type ReadStep } from "../lib/raidz-view";

  /** Blocks written before the live one that the figure keeps: older ones scroll off. */
  const MAX_OLDER = 11;

  for (const root of document.querySelectorAll<HTMLElement>("[data-raidz]")) {
    const S = strings<RzStrings>(root);
    const lang = root.dataset.lang ?? "en";
    const q = <E extends Element = HTMLElement>(sel: string) => root.querySelector(sel) as E;
    const form = q<HTMLFormElement>(".rz-controls");
    const map = q("[data-map]");
    const healthList = q("[data-health]");
    const steps = q("[data-steps]");
    const readBtn = q<HTMLButtonElement>("[data-act=read]");
    const finishBtn = q<HTMLButtonElement>("[data-act=finish]");
    const stepOf = q("[data-stepof]");
    const live = q("[data-live]");
    const note = q("[data-write-note]");
    let L: Layout;
    let older: Layout[] = [];
    let olderSizes: number[] = []; // psize of each block written before the live one
    let health: Health[] = [];
    let plan: ReadStep[] = [];
    let at = 0; // steps of the plan shown so far
    let run = 0; // bumps on every change, so a running animation stops

    const val = (n: string) => Number((form.elements.namedItem(n) as HTMLInputElement | RadioNodeList).value);
    const input = (n: string) => form.elements.namedItem(n) as HTMLInputElement;

    function inputs() {
      const nparity = val("nparity");
      input("dcols").min = String(nparity + 1);
      let dcols = Math.round(val("dcols")) || 6;
      dcols = Math.min(16, Math.max(nparity + 1, dcols));
      const ashift = val("ashift");
      let psize = Math.round(val("psize") / 512) * 512 || 512;
      psize = Math.min(131072, Math.max(512, psize));
      const b = Math.min(1e8, Math.max(0, Math.round(val("b")) || 0));
      return { psize, nparity, dcols, ashift, b };
    }

    function cells(dev?: number) {
      return [...map.querySelectorAll<HTMLElement>(dev === undefined ? ".cell" : `.cell[data-dev="${dev}"]`)];
    }
    /** The live block's cells of columns `cs` (skip sectors left out). */
    const colCells = (cs: number[] = []) =>
      cells().filter((c) => c.dataset.c !== undefined && cs.includes(Number(c.dataset.c)) && !c.classList.contains("k"));

    /** Lay every block out again, one after the other from sector b: older ones, then the live one. */
    function layout() {
      const v = inputs();
      const sector = 2 ** v.ashift;
      let off = v.b * sector;
      older = olderSizes.map((ps) => {
        const B = mapAlloc(ps, v.ashift, v.dcols, v.nparity, off);
        off += B.asize;
        return B;
      });
      L = mapAlloc(v.psize, v.ashift, v.dcols, v.nparity, off);
    }

    function draw() {
      run++;
      layout();
      map.innerHTML = grid(L, S, older);
      const name = blockName(older.length);
      const sum = summary(L, S, lang, name);
      q("[data-summary]").innerHTML = sum;
      map.setAttribute("aria-label", `${S.figure}. ${sum}`);
      q("[data-readout]").innerHTML = readout(L, lang);
      q("[data-describe]").innerHTML = describe(L, S, lang, older);
      q("[data-legend-old]").hidden = older.length === 0;
      for (const btn of root.querySelectorAll<HTMLButtonElement>("[data-size]"))
        btn.setAttribute("aria-label", fill(S.writeSize, { size: bytes(Number(btn.dataset.size), lang), name }));
      note.textContent = "";
      if (health.length !== L.dcols) health = Array(L.dcols).fill("ok");
      drawHealth();
      clearRead();
    }

    function drawHealth() {
      healthList.replaceChildren(
        ...health.map((h, d) => {
          const li = document.createElement("li");
          const label = document.createElement("label");
          const sel = document.createElement("select");
          for (const [k, txt] of [["ok", S.hOk], ["missing", S.hMissing], ["corrupt", S.hCorrupt]]) {
            const o = document.createElement("option");
            o.value = k;
            o.textContent = txt;
            o.selected = k === h;
            sel.append(o);
          }
          sel.addEventListener("change", () => {
            health[d] = sel.value as Health;
            clearRead();
          });
          label.append(fill(S.childN, { d }), sel);
          li.append(label);
          return li;
        }),
      );
      paintHealth();
    }

    function paintHealth() {
      for (const c of cells()) {
        const d = Number(c.dataset.dev);
        c.classList.toggle("gone", health[d] === "missing");
        c.classList.toggle("bad", health[d] === "corrupt");
        c.classList.remove("sim", "fixed", "pending", "lit", "rebuilt");
      }
      for (const h of map.querySelectorAll<HTMLElement>(".h")) {
        const d = Number(h.dataset.dev);
        h.classList.toggle("gone", health[d] === "missing");
        h.classList.toggle("bad", health[d] === "corrupt");
      }
    }

    function clearRead() {
      run++;
      plan = [];
      at = 0;
      steps.replaceChildren();
      stepOf.textContent = "";
      live.textContent = "";
      readBtn.textContent = S.read;
      finishBtn.hidden = true;
      paintHealth();
    }

    /** Write a block of `size` after the live one: the live one joins the older blocks. */
    async function write(size: number) {
      olderSizes.push(inputs().psize);
      if (olderSizes.length > MAX_OLDER) {
        // The oldest block scrolls off: block A's start moves past it.
        const gone = older[0];
        olderSizes.shift();
        input("b").value = String(gone.b + gone.asize / 2 ** gone.ashift);
      }
      input("psize").value = String(size);
      draw();
      const me = run;
      note.textContent = fill(S.writing, { name: blockName(older.length), prev: blockName(older.length - 1) });
      if (reducedMotion()) return;
      const mine = cells().filter((c) => c.dataset.n !== undefined);
      mine.sort((a, b) => Number(a.dataset.n) - Number(b.dataset.n));
      for (const c of mine) c.classList.add("pending");
      const dt = Math.max(12, Math.min(90, 1400 / mine.length));
      for (const c of mine) {
        await wait(dt);
        if (me !== run) return;
        c.classList.remove("pending");
      }
    }

    /** Show the plan's next step: its line, and its marks on the map. */
    function show(s: ReadStep) {
      for (const c of cells()) c.classList.remove("sim", "lit", "rebuilt");
      for (const c of colCells(s.lit)) c.classList.add("lit");
      for (const c of colCells(s.rebuilt)) c.classList.add("rebuilt");
      if (s.sim) for (const c of cells()) if (c.dataset.c !== undefined && s.sim.includes(Number(c.dataset.dev))) c.classList.add("sim");
      for (const c of colCells(s.fixed)) c.classList.add("fixed");
      const e = document.createElement("li");
      e.innerHTML = s.html;
      e.className = [s.kind, s.tone ?? ""].join(" ").trim();
      steps.append(e);
      for (const old of steps.querySelectorAll("li.current")) old.classList.remove("current");
      e.classList.add("current");
      live.textContent = e.textContent ?? "";
    }

    function next() {
      if (!plan.length || at >= plan.length) {
        clearRead();
        plan = readPlan(L, readBlock(L, health), S, health);
      }
      show(plan[at++]);
      const done = at >= plan.length;
      stepOf.textContent = fill(S.stepOf, { i: at, n: plan.length });
      readBtn.textContent = done ? S.again : S.next;
      finishBtn.hidden = done;
    }

    function finish() {
      while (at < plan.length) show(plan[at++]);
      stepOf.textContent = fill(S.stepOf, { i: at, n: plan.length });
      readBtn.textContent = S.again;
      finishBtn.hidden = true;
      readBtn.focus();
    }

    form.addEventListener("submit", (e) => e.preventDefault());
    form.addEventListener("input", draw);
    form.addEventListener("change", draw);
    for (const btn of root.querySelectorAll<HTMLButtonElement>("[data-size]")) btn.addEventListener("click", () => write(Number(btn.dataset.size)));
    q("[data-act=clear]").addEventListener("click", () => {
      olderSizes = [];
      draw();
    });
    readBtn.addEventListener("click", next);
    finishBtn.addEventListener("click", finish);
    q("[data-act=heal]").addEventListener("click", () => {
      health = Array(L.dcols).fill("ok");
      drawHealth();
      clearRead();
    });

    draw();
    form.hidden = false;
    q(".rz-write").hidden = false;
    q(".rz-read").hidden = false;
  }
</script>

