    rRepaired: "Reescritura con los datos buenos: {cols}.",
    rParityChecked: "La paridad leída pero no usada se regenera y se compara: es correcta.",
    rUndetected:
      "Queda paridad errónea en {cols}: esta lectura no la necesitaba y no la ha comprobado. Un scrub lee todas las columnas y la detectaría.",
    rFail: "Ninguna combinación se verifica: la lectura falla con un error de suma de comprobación.",
    rFailTooMany: "La lectura falla.",
    resilverYes: "Resilver de {list}: este bloque se reescribe, toca un hijo al que le faltan escrituras.",
    resilverAll: "Resilver de {list}: este bloque se reescribe, abarca todos los hijos.",
    resilverNo: "Resilver de {list}: este bloque se omite, a ninguno de los s + nparity hijos a partir de f le faltan escrituras.",
    attemptsMore: "… {n} combinaciones más …",
    attemptsLabel: "Combinaciones probadas",
  },
}[lang];
const S = { ...Object.fromEntries(Object.entries(S0).map(([k, v]) => [k, lang === "fr" ? fr(v) : v])), refs } as unknown as RzStrings;
const t = UI[lang];
// The default layout, rendered at build time: raidz2 on 6 children, 4K
// sectors, a 24 KiB block, which is not a multiple of the data width.
const D = { psize: 24576, nparity: 2, dcols: 6, ashift: 12, b: 0 };
const L = mapAlloc(D.psize, D.ashift, D.dcols, D.nparity, D.b * 2 ** D.ashift);
const id = `rz-${lang}`;
---

<figure class="rz" data-raidz data-strings={JSON.stringify(S)} data-lang={lang}>
  <form class="rz-controls" hidden>
    <label class="num">
      <span>{S.psize}</span>
      <input type="number" name="psize" min="512" max="131072" step="512" value={D.psize} inputmode="numeric" aria-describedby={`${id}-hint`} />
      <small id={`${id}-hint`} class="muted">{S.psizeHint}</small>
    </label>
    <fieldset class="segmented">
      <legend>{S.parity}</legend>
      {
        [1, 2, 3].map((p) => (
          <label>
            <input type="radio" name="nparity" value={p} checked={p === D.nparity} />
            raidz{p}
          </label>
        ))
      }
    </fieldset>
    <label class="num">
      <span>{S.children}</span>
      <input type="number" name="dcols" min="2" max="16" step="1" value={D.dcols} inputmode="numeric" />
    </label>
    <label class="num">
      <span>{S.ashift}</span>
      <select name="ashift">
        {[9, 10, 11, 12, 13, 14, 15, 16].map((a) => <option value={a} selected={a === D.ashift}>{`${a} (${2 ** a} ${S.unitB})`}</option>)}
      </select>
    </label>
    <label class="num">
      <span>{S.start}</span>
      <input type="number" name="b" min="0" max="100000000" step="1" value={D.b} inputmode="numeric" />
    </label>
  </form>
  <p class="rz-summary" data-summary set:html={summary(L, S, lang)} />
  <div class="rz-map" role="img" aria-label={`${S.figure}. ${summary(L, S, lang)}`} data-map set:html={grid(L, S)} />
  <ul class="rz-legend" aria-hidden="true">
    <li><span class="cell d d0">0</span>{S.legendData}</li>
    <li><span class="cell p">P</span>{S.legendParity}</li>
    <li><span class="cell k"></span>{S.legendSkip}</li>
    <li><span class="cell e"></span>{S.legendFree}</li>
  </ul>
  <div class="rz-write" hidden>
    <button class="btn btn--primary" type="button" data-act="write">{S.write}</button>
    <p class="muted" data-write-note aria-live="polite"></p>
  </div>
  <div data-readout set:html={readout(L, S, lang)} />
  <noscript><p class="muted">{t.noScript}</p></noscript>
  <div class="rz-read" hidden>
    <h3>{S.damage}</h3>
    <ul class="rz-health" data-health></ul>
    <div class="buttons">
      <button class="btn btn--primary" type="button" data-act="read">{S.read}</button>
      <button class="btn" type="button" data-act="heal">{S.reset}</button>
    </div>
    <ol class="rz-steps" data-steps></ol>
    <div class="rz-attempts" data-attempts hidden>
      <h4>{S.attemptsLabel}</h4>
      <ol></ol>
    </div>
    <p class="rz-result" data-result aria-live="polite"></p>
  </div>
  <details class="text-version">
    <summary>{t.textVersion}</summary>
    <div data-describe set:html={describe(L, S, lang)} />
  </details>
</figure>

<script>
  import { strings, fill, wait, reducedMotion } from "../lib/svg";
  import { mapAlloc, readBlock, needResilver, type Health, type Layout } from "../lib/raidz";
  import { grid, readout, describe, summary, readSteps, attemptText, type RzStrings } from "../lib/raidz-view";

  for (const root of document.querySelectorAll<HTMLElement>("[data-raidz]")) {
    const S = strings<RzStrings>(root);
    const lang = root.dataset.lang ?? "en";
    const q = <E extends Element = HTMLElement>(sel: string) => root.querySelector(sel) as E;
    const form = q<HTMLFormElement>(".rz-controls");
    const map = q("[data-map]");
    const healthList = q("[data-health]");
    const steps = q("[data-steps]");
    const attemptsBox = q("[data-attempts]");
    const result = q("[data-result]");
    let L: Layout;
    let health: Health[] = [];
    let run = 0; // bumps on every change, so a running animation stops

    const val = (n: string) => Number((form.elements.namedItem(n) as HTMLInputElement | RadioNodeList).value);

    function inputs() {
      const nparity = val("nparity");
      const dc = form.elements.namedItem("dcols") as HTMLInputElement;
      dc.min = String(nparity + 1);
      let dcols = Math.round(val("dcols")) || 6;
      dcols = Math.min(16, Math.max(nparity + 1, dcols));
      const ashift = val("ashift");
      let psize = Math.round(val("psize") / 512) * 512 || 512;
      psize = Math.min(131072, Math.max(512, psize));
      const b = Math.min(1e8, Math.max(0, Math.round(val("b")) || 0));
      return { psize, nparity, dcols, ashift, b };
    }

    function cells(dev?: number) {
      return [...map.querySelectorAll<HTMLElement>(dev === undefined ? ".cell" : `.cell[data-dev="${dev}"]`)];
    }

    function draw() {
      run++;
      const v = inputs();
      L = mapAlloc(v.psize, v.ashift, v.dcols, v.nparity, v.b * 2 ** v.ashift);
      map.innerHTML = grid(L, S);
      const sum = summary(L, S, lang);
      q("[data-summary]").innerHTML = sum;
      map.setAttribute("aria-label", `${S.figure}. ${sum}`);
      q("[data-readout]").innerHTML = readout(L, S, lang);
      q("[data-describe]").innerHTML = describe(L, S, lang);
      q("[data-write-note]").textContent = "";
      if (health.length !== L.dcols) health = Array(L.dcols).fill("ok");
      drawHealth();
      clearRead();
    }

    function drawHealth() {
      healthList.replaceChildren(
        ...health.map((h, d) => {
          const li = document.createElement("li");
          const label = document.createElement("label");
          const sel = document.createElement("select");
          for (const [k, txt] of [["ok", S.hOk], ["missing", S.hMissing], ["corrupt", S.hCorrupt]]) {
            const o = document.createElement("option");
            o.value = k;
            o.textContent = txt;
            o.selected = k === h;
            sel.append(o);
          }
          sel.addEventListener("change", () => {
            health[d] = sel.value as Health;
            clearRead();
          });
          label.append(fill(S.childN, { d }), sel);
          li.append(label);
          return li;
        }),
      );
      paintHealth();
    }

    function paintHealth() {
      for (const c of cells()) {
        const d = Number(c.dataset.dev);
        c.classList.toggle("gone", health[d] === "missing");
        c.classList.toggle("bad", health[d] === "corrupt");
        c.classList.remove("sim", "fixed", "pending", "lit");
      }
      for (const h of map.querySelectorAll<HTMLElement>(".h")) {
        const d = Number(h.dataset.dev);
        h.classList.toggle("gone", health[d] === "missing");
        h.classList.toggle("bad", health[d] === "corrupt");
      }
    }

    function clearRead() {
      run++;
      steps.replaceChildren();
      attemptsBox.hidden = true;
      attemptsBox.querySelector("ol")!.replaceChildren();
      result.textContent = "";
      paintHealth();
    }

    const li = (html: string) => {
      const e = document.createElement("li");
      e.innerHTML = html;
      return e;
    };

    async function write() {
      const me = ++run;
      paintHealth();
      const all = cells().filter((c) => c.dataset.n !== undefined);
      all.sort((a, b) => Number(a.dataset.n) - Number(b.dataset.n));
      q("[data-write-note]").textContent = S.writing;
      if (reducedMotion()) return;
      for (const c of all) c.classList.add("pending");
      const dt = Math.max(12, Math.min(90, 1400 / all.length));
      for (const c of all) {
        await wait(dt);
        if (me !== run) return;
        c.classList.remove("pending");
      }
      await wait(150);
      if (me !== run) return;
      for (const c of all) c.classList.add("lit");
      await wait(500);
      for (const c of all) c.classList.remove("lit");
    }

    async function read() {
      const me = ++run;
      steps.replaceChildren();
      result.textContent = "";
      const box = attemptsBox.querySelector("ol")!;
      box.replaceChildren();
      attemptsBox.hidden = true;
      paintHealth();
      const R = readBlock(L, health);
      const out = readSteps(L, R, S);
      for (const s of out.steps) {
        steps.append(li(s));
        await wait(260);
        if (me !== run) return;
      }
      if (R.attempts.length) {
        attemptsBox.hidden = false;
        const N = R.attempts.length;
        const show = N <= 16 ? [...R.attempts.keys()] : [...Array(12).keys(), ...[N - 3, N - 2, N - 1]];
        let shown = -1;
        for (const i of show) {
          if (i > shown + 1) box.append(li(fill(S.attemptsMore, { n: i - shown - 1 })));
          shown = i;
          const a = R.attempts[i];
          const e = li(attemptText(L, a, S));
          e.className = a.outcome;
          box.append(e);
          for (const c of cells()) c.classList.toggle("sim", a.tgts.includes(Number(c.dataset.dev)) && c.dataset.n !== undefined);
          await wait(i < 12 ? 320 : 120);
          if (me !== run) return;
        }
        for (const c of cells()) c.classList.remove("sim");
      }
      for (const c of cells()) if (R.repaired.includes(Number(c.dataset.c)) && c.dataset.n !== undefined && !c.classList.contains("k")) c.classList.add("fixed");
      let html = out.result;
      const missing = health.map((h, d) => (h === "missing" ? d : -1)).filter((d) => d >= 0);
      if (missing.length) {
        const list = missing.map((d) => fill(S.childN, { d })).join(", ");
        const all = L.s + L.nparity >= L.dcols;
        html += " " + fill(all ? S.resilverAll : needResilver(L, missing) ? S.resilverYes : S.resilverNo, { list }) + ` <a href="${S.refs.resilver}">(${S.see})</a>`;
      }
      result.innerHTML = html;
    }

    form.addEventListener("submit", (e) => e.preventDefault());
    form.addEventListener("input", draw);
    form.addEventListener("change", draw);
    q("[data-act=write]").addEventListener("click", write);
    q("[data-act=read]").addEventListener("click", read);
    q("[data-act=heal]").addEventListener("click", () => {
      health = Array(L.dcols).fill("ok");
      drawHealth();
      clearRead();
    });

    draw();
    form.hidden = false;
    q(".rz-write").hidden = false;
    q(".rz-read").hidden = false;
  }
</script>

