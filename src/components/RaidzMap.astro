import { UI } from "../lib/ui";
import { fr } from "../lib/fr";
import { mapAlloc } from "../lib/raidz";
import { grid, readout, describe, summary, bytes, type RzStrings } from "../lib/raidz-view";

interface Props {
  lang: Lang;
}
