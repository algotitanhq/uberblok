---
// The figure of the RAID-Z room: the map vdev_raidz_map_alloc builds for one
// block, for the visitor's psize, parity, children, ashift and start sector,
// then a read of that block with damaged children. It runs src/lib/raidz.ts
// (the arithmetic and the read path's decisions of vdev_raidz.c) and draws
// with src/lib/raidz-view.ts, which also renders the default layout at build
// time: without JavaScript the page shows that layout and its numbers. The refs
// are listed in ANALYSIS.md, room "RAID-Z"; what is simplified: DECISIONS.md D4.1.
import type { Lang } from "../lib/rooms";
import { UI } from "../lib/ui";
import { gh } from "../lib/openzfs";
import { fr } from "../lib/fr";
import { mapAlloc } from "../lib/raidz";
import { grid, readout, describe, summary, type RzStrings } from "../lib/raidz-view";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const V = "module/zfs/vdev_raidz.c";
const refs = {
  s: gh(V, 617, 619),
  f: gh(V, 621),
  o: gh(V, 623),
  q: gh(V, 634),
  r: gh(V, 640),
  bc: gh(V, 643),
  tot: gh(V, 649),
  cols: gh(V, 655, 662),
  nskip: gh(V, 699, 700),
  asize: gh(V, 2315, 2317),
  columns: gh(V, 677, 696),
  skipPlace: gh(V, 509, 580),
  swap: gh(V, 725, 734),
  write: gh(V, 2443, 2462),
  enxio: gh(V, 2522, 2531),
  readRow: gh(V, 2573, 2588),
  known: gh(V, 3712, 3739),
  cksum: gh(V, 3865),
  readAll: gh(V, 3886, 3910),
  combrec: gh(V, 3523, 3558),
  tooMany: gh(V, 3510, 3520),
  unrecoverable: gh(V, 3959, 3963),
  repair: gh(V, 3166, 3210),
  parityVerify: gh(V, 3132, 3163),
  scrub: gh(V, 2580, 2582),
  resilver: gh(V, 4011, 4037),
