    aRebuilt: "reconstrucción de {cols} a partir de {parity},",
    aOk: "la suma de comprobación se verifica.",
    aCksum: "la suma de comprobación falla.",
    aEinval: "{tgts}: con los errores conocidos, {dead} columnas muertas, más de {np}: EINVAL, probar con un fallo más.",
