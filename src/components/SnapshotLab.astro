const t = UI[lang];
const s0 = opening();
const sum = summary(s0, S);
---

<figure class="sn" data-snaps data-strings={JSON.stringify(S)} data-lang={lang} aria-label={S.figure}>
  <div class="sn-bar" hidden>
    <p class="txg"><span class="muted">{S.openTxg}</span> <strong data-txg>{s0.txg}</strong></p>
    <div class="buttons">
      <button class="btn btn--primary" type="button" data-act="sync">{S.sync.replace("{txg}", String(s0.txg))}</button>
      <button class="btn" type="button" data-act="snapshot">{S.snapshot}</button>
      <button class="btn" type="button" data-act="reset">{S.reset}</button>
    </div>
    <p class="sn-waiting muted" data-waiting set:html={waiting(s0, S)} />
  </div>
  <p class="sn-did" data-did set:html={S.didOpening} />
  <p class="visually-hidden" data-summary>{sum}</p>
  <p class="visually-hidden" data-say aria-live="polite"></p>
  <div class="sn-board" data-board set:html={board(s0, S, false)} />
  <div class="sn-quick" data-quick role="group" hidden set:html={quickRow(s0, S, null)} />
  <ul class="sn-legend" aria-hidden="true">
    <li><span class="chip">A<sub>8</sub></span>{S.legendBirth}</li>
    <li><span class="chip root">R<sub>8</sub></span>{S.legendRoot}</li>
    <li><span class="chip c">A<sub>12</sub></span>{S.legendClone}</li>
    <li><span class="chip pin">A<sub>8</sub></span>{S.legendPin}</li>
    <li><span class="chip hit">A<sub>8</sub></span>{S.legendHit}</li>
    <li><span class="chip sel">A<sub>8</sub></span>{S.legendSel}</li>
    <li><span class="chip gone">A<sub>8</sub></span>{S.legendFreed}</li>
  </ul>
  <noscript><p class="muted">{t.noScript}</p></noscript>
  <div class="sn-panels" hidden>
    <section class="sn-owner" aria-labelledby={`sn-owner-${lang}`}>
      <h3 id={`sn-owner-${lang}`}>{S.ownerLabel}</h3>
      <div data-owner set:html={ownerPanel(s0, S, null, true)} />
    </section>
    <section class="sn-log" aria-labelledby={`sn-log-${lang}`}>
      <h3 id={`sn-log-${lang}`}>{S.logLabel}</h3>
      <p class="muted" data-log-empty>{S.logEmpty.replace("{txg}", String(s0.txg))}</p>
      <ol data-log></ol>
    </section>
  </div>
  <details class="text-version">
    <summary>{t.textVersion}</summary>
    <div data-describe set:html={describe(s0, S)} />
  </details>
</figure>

<script>
  import { strings, fill, wait, reducedMotion } from "../lib/svg";
  import { opening, sync, change, cancelChange, ask, cancelTask, taskRefusal, type State, type Change, type Dir } from "../lib/snapshots";
  import { board, describe, summary, waiting, ownerPanel, quickRow, eventLine, didLine, touched, type SnStrings } from "../lib/snapshots-view";

  for (const root of document.querySelectorAll<HTMLElement>("[data-snaps]")) {
    const S = strings<SnStrings>(root);
    const q = <E extends Element = HTMLElement>(sel: string) => root.querySelector(sel) as E;
    const boardEl = q("[data-board]");
    const ownerEl = q("[data-owner]");
    const quickEl = q("[data-quick]");
    const logEl = q("[data-log]");
    // One live region, one announcement per action: what the action did, in one text.
    const say = (text: string) => (q("[data-say]").textContent = text.replace(/\s+/g, " ").trim());
    const syncBtn = q<HTMLButtonElement>("[data-act=sync]");
    const snapBtn = q<HTMLButtonElement>("[data-act=snapshot]");
    let s: State = opening();
    let selected: number | null = null;
    let freedLast: number[] = [];
    // The blocks the last sync changed, ringed until the next action.
    let last = new Set<number>();
    let run = 0;

    // Keep focus on the same control across a re-render.
    const keyOf = (el: Element | null) => {
      if (!(el instanceof HTMLElement) || !root.contains(el)) return null;
      for (const a of ["data-act", "data-task", "data-cancel-task", "data-write", "data-change", "data-cancel"]) if (el.hasAttribute(a)) return `[${a}="${el.getAttribute(a)}"]`;
      if (el.dataset.b !== undefined) return `[data-b="${el.dataset.b}"][data-at="${el.dataset.at}"]`;
      return null;
    };

    function render(focusKey: string | null = keyOf(document.activeElement)) {
      boardEl.innerHTML = board(s, S, true, freedLast, last);
      if (selected !== null && s.blocks[selected]?.freed !== undefined && !freedLast.includes(selected)) selected = null;
      for (const c of boardEl.querySelectorAll<HTMLElement>("[data-b]")) {
        const on = Number(c.dataset.b) === selected;
        c.classList.toggle("sel", on);
        if (c.tagName === "BUTTON") c.setAttribute("aria-pressed", String(on));
      }
      ownerEl.innerHTML = ownerPanel(s, S, selected, true);
      quickEl.innerHTML = quickRow(s, S, selected);
      // Landing on an action reads which block it acts on: "B8 selected:, group".
      quickEl.setAttribute("aria-label", (quickEl.querySelector(".q-name")?.textContent ?? quickEl.textContent ?? "").trim());
      const emptyLog = q("[data-log-empty]");
      emptyLog.hidden = logEl.childElementCount > 0;
      emptyLog.textContent = fill(S.logEmpty, { txg: s.txg });
      q("[data-txg]").textContent = String(s.txg);
      syncBtn.textContent = fill(S.sync, { txg: s.txg });
      const why = taskRefusal(s, { kind: "snapshot" });
      snapBtn.disabled = !!why;
      snapBtn.title = why === "EAGAIN" ? S.snapEagain : why === "limit" ? S.snapLimit : "";
      q("[data-waiting]").innerHTML = waiting(s, S) + (why === "limit" ? ` ${S.snapLimit}` : "");
      q("[data-summary]").textContent = summary(s, S);
      q("[data-describe]").innerHTML = describe(s, S);
      if (focusKey) {
        const el = root.querySelector<HTMLElement>(focusKey);
        if (el) el.focus({ preventScroll: true });
        else {
          // The control was replaced: a change by its Cancel, a Cancel by the Overwrite of the
          // same dataset and slot, an empty slot's Write by the Sync button.
          const m = focusKey.match(/^\[data-(change|cancel)="(\w+):(\d+)/);
          const alt = m ? (m[1] === "change" ? `[data-cancel="${m[2]}:${m[3]}"]` : `[data-change="${m[2]}:${m[3]}:write"]`) : focusKey.startsWith("[data-write") ? "[data-act=sync]" : null;
          if (alt) (root.querySelector<HTMLElement>(alt) ?? quickEl.querySelector<HTMLElement>("button"))?.focus({ preventScroll: true });
        }
      }
    }

    // FLIP: each chip that moved (tree -> deadlist, or into a new row) slides from where it was.
    function rects() {
      const m = new Map<string, DOMRect>();
      // The copies in a snapshot's "destroying it frees" line are not where a block lives.
      for (const c of boardEl.querySelectorAll<HTMLElement>("[data-b]:not([data-at^='only:'])")) m.set(`${c.dataset.b}|${c.dataset.at}`, c.getBoundingClientRect());
      const byBlock = new Map<string, DOMRect>();
      for (const [k, r] of m) byBlock.set(k.split("|")[0], r);
      return { m, byBlock };
    }

    async function doSync() {
      const me = ++run;
      const before = rects();
      const ev = sync(s);
      freedLast = ev.flatMap((e) => (e.k === "kill" && e.freed ? [e.block] : e.k === "destroy" ? e.freed : []));
      last = touched(ev);
      q("[data-did]").innerHTML = didLine(s, S, ev);
      render();
      logEl.replaceChildren();
      q("[data-log-empty]").hidden = true;
      if (!reducedMotion()) {
        for (const c of boardEl.querySelectorAll<HTMLElement>("[data-b]:not([data-at^='only:'])")) {
          const k = `${c.dataset.b}|${c.dataset.at}`;
          if (before.m.has(k)) continue;
          const from = before.byBlock.get(c.dataset.b!);
          if (!from) {
            c.animate([{ opacity: 0, transform: "translateY(-6px)" }, { opacity: 1, transform: "none" }], { duration: 420, easing: "cubic-bezier(0.2, 0.7, 0.2, 1)" });
            continue;
          }
          const to = c.getBoundingClientRect();
          c.animate([{ transform: `translate(${from.left - to.left}px, ${from.top - to.top}px)` }, { transform: "none" }], { duration: 640, easing: "cubic-bezier(0.2, 0.7, 0.2, 1)" });
        }
        for (const c of boardEl.querySelectorAll<HTMLElement>(".freed .chip")) c.animate([{ opacity: 1 }, { opacity: 0.45 }], { duration: 900, fill: "none" });
      }
      // Another action during the replay writes the rest of the log at once.
      for (const e of ev) {
        const li = document.createElement("li");
        li.className = e.k === "kill" ? (e.freed ? "free" : "dead") : e.k;
        li.innerHTML = eventLine(s, S, e);
        logEl.append(li);
        if (me === run) await wait(e.k === "born" ? 60 : 140);
      }
      // The summary only; the steps stay in the log below, for whoever wants them.
      if (me === run) say(q("[data-did]").textContent ?? "");
    }

    root.addEventListener("click", (e) => {
      const el = (e.target as Element).closest<HTMLElement>("button");
      if (!el || !root.contains(el)) return;
      const d = el.dataset;
      if (d.act === "sync") return void doSync();
      // Selecting a block lets a sync's log finish and keeps its ring; any other action
      // stops the log and clears the ring.
      if (d.b === undefined) {
        run++;
        last = new Set();
      }
      if (d.act === "snapshot") ask(s, { kind: "snapshot" });
      else if (d.act === "reset") {
        s = opening();
        selected = null;
        freedLast = [];
        logEl.replaceChildren();
        q("[data-did]").innerHTML = S.didOpening;
      } else if (d.b !== undefined) {
        selected = Number(d.b);
      } else if (d.write) {
        const [dir, slot] = d.write.split(":");
        change(s, dir as Dir, Number(slot), "write");
      } else if (d.change) {
        const [dir, slot, c] = d.change.split(":");
        change(s, dir as Dir, Number(slot), c as Change);
      } else if (d.cancel) {
        const [dir, slot] = d.cancel.split(":");
        cancelChange(s, dir as Dir, Number(slot));
      } else if (d.task) {
        const [kind, id] = d.task.split(":");
        ask(s, kind === "clone" ? { kind: "clone", origin: id } : { kind: "destroy", snap: id });
      } else if (d.cancelTask !== undefined) cancelTask(s, Number(d.cancelTask));
      else return;
      render();
      // The actions for the selected block sit right under the board: from the keyboard, focus
      // the first one (a pointer click, e.detail > 0, leaves focus where it is).
      if (d.b !== undefined && (e as MouseEvent).detail === 0) quickEl.querySelector<HTMLElement>("button")?.focus({ preventScroll: true });
      say((d.b !== undefined ? ownerEl : d.act === "reset" ? q("[data-summary]") : q("[data-waiting]")).textContent ?? "");
    });

    render(null);
    q(".sn-bar").hidden = false;
    q(".sn-panels").hidden = false;
    quickEl.hidden = false;
  }
</script>

<style>
  .sn {
    margin: var(--space-6) 0 0;
  }
  .sn-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    align-items: center;
    margin-bottom: var(--space-4);
  }
  .sn-bar[hidden],
  .sn-panels[hidden] {
    display: none;
  }
  .txg {
    font-variant-numeric: tabular-nums;
  }
  .txg strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-2);
    color: var(--accent);
  }
  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .sn-did {
    max-width: 48rem;
    min-height: 3em;
    margin-bottom: var(--space-4);
  }
  .sn-did :global(sub) {
    font-size: 0.72em;
  }
  .sn-waiting {
    flex-basis: 100%;
    font-size: var(--step--1);
    max-width: 48rem;
    min-height: 1.5em;
  }
  .sn-board :global(.board) {
    display: grid;
    gap: var(--space-3);
  }
  .sn-board :global(.ds) {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: var(--space-3) var(--space-4);
    display: grid;
    gap: var(--space-2);
  }
  .sn-board :global(.ds.head) {
    border-color: var(--line-strong);
  }
  .sn-board :global(.ds.clone) {
    border-style: dashed;
    border-color: var(--line-strong);
  }
  .sn-board :global(header) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    align-items: baseline;
  }
  .sn-board :global(h3) {
    margin: 0;
    font-family: var(--font-body);
    letter-spacing: 0;
    font-size: var(--step-0);
    font-weight: 600;
  }
  .sn-board :global(h3 code) {
    font-size: 1em;
  }
  .sn-board :global(.kind) {
    font-family: var(--font-caption);
    font-style: italic;
    color: var(--fg-muted);
    font-size: var(--step-0);
  }
  .sn-board :global(.meta) {
    font-size: var(--step--1);
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }
  .sn-board :global(.meta strong) {
    color: var(--fg);
  }
  .sn-board :global(.acts) {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    margin-left: auto;
  }
  .sn-board :global(.tree),
  .sn-board :global(.dl) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }
  .sn-board :global(.lbl) {
    font-size: var(--step--1);
    color: var(--fg-muted);
    min-width: 4.6rem;
  }
  .sn-board :global(.arrow) {
    color: var(--fg-faint);
  }
  .sn-board :global(.slots) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .sn-board :global(.slot),
  .sn-board :global(.slot-none) {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }
  .sn-board :global(.slot-none) {
    justify-content: center;
  }
  .sn-board :global(.slot-none),
  .sn-board :global(.slot-empty) {
    font-size: var(--step--1);
    color: var(--fg-faint);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    padding: 0 0.7em;
    min-height: 44px;
    min-width: 3.4rem;
    display: inline-flex;
    align-items: center;
    background: transparent;
    font: inherit;
    font-size: var(--step--1);
  }
  .sn-board :global(.slot-empty) {
    color: var(--accent);
    border-color: var(--accent);
    cursor: pointer;
  }
  .sn-board :global(.dl ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .sn-board :global(.entry) {
    display: inline-flex;
    gap: var(--space-1);
    align-items: center;
    border-left: 2px solid var(--line-strong);
    padding-left: var(--space-2);
    min-height: 44px;
  }
  .sn-board :global(.entry.empty) {
    border-left-color: var(--line);
  }
  .sn-board :global(.key) {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
    margin-right: 2px;
  }
  .sn-board :global(.none) {
    font-size: 0.75rem;
    color: var(--fg-faint);
  }
  .chip,
  .sn-board :global(.chip) {
    font: inherit;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--fg);
    background: var(--surface-2);
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    min-width: 2.9rem;
    min-height: 44px;
    padding: 0 0.5em;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-variant-numeric: tabular-nums;
  }
  .sn-board :global(button.chip) {
    cursor: pointer;
  }
  .chip :global(sub),
  .sn-board :global(.chip sub) {
    font-weight: 400;
    color: var(--fg-muted);
    font-size: 0.72em;
    margin-left: 1px;
  }
  .chip.root,
  .sn-board :global(.chip.root) {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent);
  }
  .chip.c,
  .sn-board :global(.chip.c) {
    border-style: dashed;
    border-color: var(--ok);
  }
  .chip.gone,
  .sn-board :global(.chip.gone) {
    background: transparent;
    border: 1px dashed var(--line);
    color: var(--fg-faint);
    text-decoration: line-through;
  }
  /* Kept only for snapshots: hatched, the space the head no longer uses. */
  .chip.pin,
  .sn-board :global(.chip.pin) {
    background-image: repeating-linear-gradient(
      135deg,
      transparent 0 5px,
      color-mix(in srgb, var(--fg-faint) 45%, transparent) 5px 6.5px
    );
  }
  /* What the last sync changed (D24.1): a static ring, so it reads under reduced
     motion too; it fades in only when motion is allowed. */
  .chip.hit,
  .sn-board :global(.chip.hit) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .sn-board :global(.chip.hit:not(.sel)) {
      animation: hit var(--dur-2) var(--ease);
    }
  }
  @keyframes hit {
    from {
      outline-color: transparent;
      outline-offset: 6px;
    }
  }
  .sn-board :global(.only) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    font-size: var(--step--1);
    color: var(--fg-muted);
  }
  .sn-board :global(.only .chip) {
    min-height: 1.9rem;
    min-width: 2.4rem;
    font-size: 0.78rem;
  }
  /* Selected: a thick inner ring and a tinted fill, so it never reads as the
     keyboard focus ring (an outline outside the chip). */
  .chip.sel,
  .sn-board :global(.chip.sel) {
    box-shadow: inset 0 0 0 3px var(--fg);
    background-color: var(--accent-soft);
  }
  .sn-board :global(.pending .chip) {
    opacity: 0.55;
  }
  .sn-board :global(.tag) {
    font-size: 0.7rem;
    line-height: 1.2;
    color: var(--accent);
    max-width: 7.5rem;
  }
  .sn-board :global(.tag.delete) {
    color: var(--bad);
  }
  .sn-board :global(.tag.task) {
    font-size: var(--step--1);
    white-space: nowrap;
    max-width: none;
  }
  .sn-board :global(.refuse) {
    font-size: var(--step--1);
    color: var(--fg-muted);
  }
  .sn-board :global(.btn.sm) {
    padding: 0.35em 0.9em;
  }
  .sn-board :global(.freed) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    margin-top: var(--space-3);
  }
  .sn-quick {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    min-height: 44px;
    margin-top: var(--space-3);
    font-size: var(--step--1);
    /* On a long board (a phone) the row stays on screen while the board is. */
    position: sticky;
    bottom: 0;
    z-index: 1;
    padding: var(--space-2) 0;
    background: var(--bg);
    border-top: 1px solid var(--line);
  }
  /* The sticky row must not cover the chip that has focus. */
  :global(html:has([data-snaps])) {
    scroll-padding-bottom: 7rem;
  }
  .sn-quick[hidden] {
    display: none;
  }
  .sn-quick :global(sub) {
    font-size: 0.72em;
  }
  .sn-quick :global(.q-name) {
    font-weight: 600;
  }
  .sn-quick :global(.btn.sm) {
    padding: 0.35em 0.9em;
  }
  .sn-quick :global(.tag) {
    color: var(--accent);
  }
  .sn-quick :global(.tag.delete) {
    color: var(--bad);
  }
  .sn-legend {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-size: var(--step--1);
    color: var(--fg-muted);
  }
  .sn-legend li {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }
  .sn-legend .chip {
    min-height: 1.8rem;
    min-width: 2.4rem;
    font-size: 0.78rem;
  }
  .sn-panels {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-5);
    margin-top: var(--space-6);
  }
  .sn-panels h3 {
    font-family: var(--font-caption);
    font-style: italic;
    font-weight: 400;
    font-size: var(--step-1);
    color: var(--accent);
    letter-spacing: 0;
    margin-bottom: var(--space-3);
  }
  .sn-owner :global(h4) {
    margin: 0 0 var(--space-2);
    font-size: var(--step-0);
    font-weight: 600;
  }
  .sn-owner :global(h4 sub) {
    font-weight: 400;
  }
  .sn-owner :global(p) {
    font-size: var(--step--1);
    margin-top: var(--space-2);
    max-width: 40rem;
  }
  .sn-log ol {
    margin: 0;
    padding-left: 1.6em;
    display: grid;
    gap: var(--space-2);
    font-size: var(--step--1);
  }
  .sn-log :global(li.free) {
    color: var(--fg-muted);
  }
  .sn-log :global(li.dead b),
  .sn-log :global(li.snapshot code),
  .sn-log :global(li.clone code) {
    color: var(--accent);
  }
  .sn-log :global(li.synced) {
    color: var(--fg-muted);
    list-style: none;
  }
  .sn-log :global(li.refused) {
    color: var(--bad);
  }
  .text-version {
