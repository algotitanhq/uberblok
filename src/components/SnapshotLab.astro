const s0 = opening();
const sum = summary(s0, S);
---

<figure class="sn" data-snaps data-strings={JSON.stringify(S)} data-lang={lang} aria-label={S.figure}>
  <div class="sn-bar" hidden>
    <p class="txg"><span class="muted">{S.openTxg}</span> <strong data-txg>{s0.txg}</strong></p>
    <div class="buttons">
      <button class="btn btn--primary" type="button" data-act="sync">{S.sync.replace("{txg}", String(s0.txg))}</button>
      <button class="btn" type="button" data-act="snapshot">{S.snapshot}</button>
      <button class="btn" type="button" data-act="reset">{S.reset}</button>
    </div>
    <p class="sn-waiting muted" data-waiting set:html={waiting(s0, S)} />
  </div>
  <p class="visually-hidden" data-summary>{sum}</p>
  <p class="visually-hidden" data-say aria-live="polite"></p>
  <div class="sn-board" data-board set:html={board(s0, S, false)} />
  <ul class="sn-legend" aria-hidden="true">
    <li><span class="chip">A<sub>8</sub></span>{S.legendBirth}</li>
    <li><span class="chip root">R<sub>8</sub></span>{S.legendRoot}</li>
    <li><span class="chip c">A<sub>12</sub></span>{S.legendClone}</li>
    <li><span class="chip gone">A<sub>8</sub></span>{S.legendFreed}</li>
  </ul>
  <noscript><p class="muted">{t.noScript}</p></noscript>
  <div class="sn-panels" hidden>
    <section class="sn-owner" aria-labelledby={`sn-owner-${lang}`}>
      <h3 id={`sn-owner-${lang}`}>{S.ownerLabel}</h3>
      <div data-owner set:html={ownerPanel(s0, S, null, true)} />
    </section>
    <section class="sn-log" aria-labelledby={`sn-log-${lang}`}>
      <h3 id={`sn-log-${lang}`}>{S.logLabel}</h3>
      <ol data-log></ol>
    </section>
  </div>
  <details class="text-version">
    <summary>{t.textVersion}</summary>
    <div data-describe set:html={describe(s0, S)} />
  </details>
</figure>

<script>
  import { strings, fill, wait, reducedMotion } from "../lib/svg";
  import { opening, sync, change, cancelChange, ask, cancelTask, taskRefusal, type State, type Change, type Dir } from "../lib/snapshots";
  import { board, describe, summary, waiting, ownerPanel, eventLine, type SnStrings } from "../lib/snapshots-view";

  for (const root of document.querySelectorAll<HTMLElement>("[data-snaps]")) {
    const S = strings<SnStrings>(root);
    const q = <E extends Element = HTMLElement>(sel: string) => root.querySelector(sel) as E;
    const boardEl = q("[data-board]");
    const ownerEl = q("[data-owner]");
    const logEl = q("[data-log]");
    // One live region, one announcement per action: what the action did, in one text.
    const say = (text: string) => (q("[data-say]").textContent = text.replace(/\s+/g, " ").trim());
    const syncBtn = q<HTMLButtonElement>("[data-act=sync]");
    const snapBtn = q<HTMLButtonElement>("[data-act=snapshot]");
    let s: State = opening();
    let selected: number | null = null;
    let freedLast: number[] = [];
    let run = 0;

    // Keep focus on the same control across a re-render.
    const keyOf = (el: Element | null) => {
      if (!(el instanceof HTMLElement) || !root.contains(el)) return null;
      for (const a of ["data-act", "data-task", "data-cancel-task", "data-write", "data-change", "data-cancel"]) if (el.hasAttribute(a)) return `[${a}="${el.getAttribute(a)}"]`;
      if (el.dataset.b !== undefined) return `[data-b="${el.dataset.b}"][data-at="${el.dataset.at}"]`;
      return null;
    };

    function render(focusKey: string | null = keyOf(document.activeElement)) {
      boardEl.innerHTML = board(s, S, true, freedLast);
      if (selected !== null && s.blocks[selected]?.freed !== undefined && !freedLast.includes(selected)) selected = null;
      for (const c of boardEl.querySelectorAll<HTMLElement>("[data-b]")) {
        const on = Number(c.dataset.b) === selected;
        c.classList.toggle("sel", on);
        if (c.tagName === "BUTTON") c.setAttribute("aria-pressed", String(on));
      }
      ownerEl.innerHTML = ownerPanel(s, S, selected, true);
      q("[data-txg]").textContent = String(s.txg);
      syncBtn.textContent = fill(S.sync, { txg: s.txg });
      const why = taskRefusal(s, { kind: "snapshot" });
      snapBtn.disabled = !!why;
      snapBtn.title = why === "EAGAIN" ? S.snapEagain : why === "limit" ? S.snapLimit : "";
      q("[data-waiting]").innerHTML = waiting(s, S) + (why === "limit" ? ` ${S.snapLimit}` : "");
      q("[data-summary]").textContent = summary(s, S);
      q("[data-describe]").innerHTML = describe(s, S);
      if (focusKey) {
        const el = root.querySelector<HTMLElement>(focusKey);
        if (el) el.focus({ preventScroll: true });
        else if (focusKey.startsWith("[data-change") || focusKey.startsWith("[data-cancel=")) ownerEl.querySelector<HTMLElement>("button")?.focus({ preventScroll: true });
      }
    }

    // FLIP: each chip that moved (tree -> deadlist, or into a new row) slides from where it was.
    function rects() {
      const m = new Map<string, DOMRect>();
      for (const c of boardEl.querySelectorAll<HTMLElement>("[data-b]")) m.set(`${c.dataset.b}|${c.dataset.at}`, c.getBoundingClientRect());
      const byBlock = new Map<string, DOMRect>();
      for (const [k, r] of m) byBlock.set(k.split("|")[0], r);
      return { m, byBlock };
    }

    async function doSync() {
      const me = ++run;
      const before = rects();
      const ev = sync(s);
      freedLast = ev.flatMap((e) => (e.k === "kill" && e.freed ? [e.block] : e.k === "destroy" ? e.freed : []));
      render();
      logEl.replaceChildren();
      if (!reducedMotion()) {
        for (const c of boardEl.querySelectorAll<HTMLElement>("[data-b]")) {
          const k = `${c.dataset.b}|${c.dataset.at}`;
          if (before.m.has(k)) continue;
          const from = before.byBlock.get(c.dataset.b!);
          if (!from) {
            c.animate([{ opacity: 0, transform: "translateY(-6px)" }, { opacity: 1, transform: "none" }], { duration: 420, easing: "cubic-bezier(0.2, 0.7, 0.2, 1)" });
            continue;
          }
          const to = c.getBoundingClientRect();
          c.animate([{ transform: `translate(${from.left - to.left}px, ${from.top - to.top}px)` }, { transform: "none" }], { duration: 640, easing: "cubic-bezier(0.2, 0.7, 0.2, 1)" });
        }
        for (const c of boardEl.querySelectorAll<HTMLElement>(".freed .chip")) c.animate([{ opacity: 1 }, { opacity: 0.45 }], { duration: 900, fill: "none" });
      }
      for (const e of ev) {
        const li = document.createElement("li");
        li.className = e.k === "kill" ? (e.freed ? "free" : "dead") : e.k;
        li.innerHTML = eventLine(s, S, e);
        logEl.append(li);
        await wait(e.k === "born" ? 60 : 140);
        if (me !== run) return;
      }
      say(ev.length ? [...logEl.children].slice(-ev.length).map((li) => li.textContent).join(" ") : (q("[data-summary]").textContent ?? ""));
    }

    root.addEventListener("click", (e) => {
      const el = (e.target as Element).closest<HTMLElement>("button");
      if (!el || !root.contains(el)) return;
      const d = el.dataset;
      if (d.act === "sync") return void doSync();
      run++;
      if (d.act === "snapshot") ask(s, { kind: "snapshot" });
      else if (d.act === "reset") {
        s = opening();
        selected = null;
        freedLast = [];
        logEl.replaceChildren();
      } else if (d.b !== undefined) {
        selected = Number(d.b);
      } else if (d.write) {
        const [dir, slot] = d.write.split(":");
        change(s, dir as Dir, Number(slot), "write");
      } else if (d.change) {
        const [dir, slot, c] = d.change.split(":");
        change(s, dir as Dir, Number(slot), c as Change);
      } else if (d.cancel) {
        const [dir, slot] = d.cancel.split(":");
        cancelChange(s, dir as Dir, Number(slot));
      } else if (d.task) {
        const [kind, id] = d.task.split(":");
        ask(s, kind === "clone" ? { kind: "clone", origin: id } : { kind: "destroy", snap: id });
      } else if (d.cancelTask !== undefined) cancelTask(s, Number(d.cancelTask));
      else return;
      render();
      say((d.b !== undefined ? ownerEl : d.act === "reset" ? q("[data-summary]") : q("[data-waiting]")).textContent ?? "");
    });

    render(null);
    q(".sn-bar").hidden = false;
    q(".sn-panels").hidden = false;
  }
</script>

