---
// The figure of the Snapshots and clones room: fs, its snapshots and one clone,
// each drawn as its ds_bp, a root block and four data blocks labelled with
// their birth txg, with their deadlists. The visitor queues changes and sync
// tasks in the open txg and syncs it; src/lib/snapshots.ts (a transcription of
// dsl_dataset_block_kill, dsl_deadlist_insert, the snapshot, clone and destroy
// sync functions) decides every outcome, and src/lib/snapshots-view.ts draws
// it, at build time for the opening state (readable without JavaScript) and in
// the browser after. Refs: ANALYSIS.md, room "Snapshots and clones";
// simplifications: DECISIONS.md D5.2.
import type { Lang } from "../lib/rooms";
import { UI } from "../lib/ui";
import { gh } from "../lib/openzfs";
import { fr } from "../lib/fr";
import { opening } from "../lib/snapshots";
import { board, describe, summary, waiting, ownerPanel, type SnStrings } from "../lib/snapshots-view";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const DS = "module/zfs/dsl_dataset.c";
const refs = {
  birth: gh("module/zfs/metaslab.c", 6061),
  kill: gh(DS, 294),
  free: gh(DS, 312, 315),
  insert: gh("module/zfs/dsl_deadlist.c", 487, 501),
  snapshot: gh(DS, 1830, 1839),
  clone: gh(DS, 1213, 1227),
  destroy: gh("module/zfs/dsl_destroy.c", 415, 424),
  eexist: gh("module/zfs/dsl_destroy.c", 83, 86),
  eagain: gh(DS, 1534, 1539),
  order: gh("module/zfs/dsl_pool.c", 747, 753),
};
