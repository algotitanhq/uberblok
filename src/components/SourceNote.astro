---
// A collapsible "Source" note (DECISIONS.md D21.1): the code behind a paragraph,
// kept out of the prose. A plain <details>, so it opens inline with no script;
// at 64rem and wider, SourcePanel moves its body into the side panel instead.
// The label slot names the source; the default slot holds an Excerpt and notes.
import { UI } from "../lib/ui";
import type { Lang } from "../lib/rooms";

interface Props {
  lang: Lang;
}
const t = UI[Astro.props.lang];
---

<details class="source-note" data-source-note>
  <summary>
    <svg class="marker" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
      <path d="M4 2.5 7.5 6 4 9.5" fill="none" stroke="currentColor" stroke-width="1.5"></path>
    </svg>
    <span class="tag">{t.source}</span>
    <span class="label" data-source-label><slot name="label" /></span>
  </summary>
  <div class="source-body" data-source-body>
    <slot />
  </div>
</details>

<style>
  .source-note {
    margin-top: var(--space-4);
  }
  summary {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-4) 0 var(--space-3);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: var(--step--1);
    color: var(--fg-muted);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover,
  .source-note[open] summary {
    color: var(--fg);
    border-color: var(--accent);
  }
  .marker {
    flex: none;
    color: var(--accent);
  }
  .source-note[open]:not(.in-panel) .marker {
    transform: rotate(90deg);
  }
  .tag {
    font-family: var(--font-caption);
    font-style: italic;
    font-size: var(--step-0);
    color: var(--accent);
  }
  .label {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .label :global(code) {
    font-size: 0.95em;
  }
  .in-panel summary {
    background: var(--surface-2);
  }
  .source-body {
    padding-bottom: var(--space-2);
  }
  .source-body > :global(.excerpt:first-child) {
    margin-top: var(--space-4);
  }
</style>
