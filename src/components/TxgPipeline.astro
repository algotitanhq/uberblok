---
// The figure of the Transaction groups room: the open / quiescing / syncing
// pipeline, run by the model in src/lib/txg.ts (the two threads of txg.c and
// their wait conditions). Every event the figure shows names its code; the
// refs below are the permalinks, all listed in ANALYSIS.md (room "Transaction
// groups"). What the model simplifies: DECISIONS.md D3.1.
import type { Lang } from "../lib/rooms";
import { UI } from "../lib/ui";
import { gh } from "../lib/openzfs";
import { fr } from "../lib/fr";
import { DIRTY_MAX, DIRTY_SYNC, SYNC_PERCENT, TXG_TIMEOUT } from "../lib/txg";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const refs = {
  hold: gh("module/zfs/txg.c", 333, 338),
  kick: gh("module/zfs/dsl_pool.c", 997, 1002),
  rele: gh("module/zfs/txg.c", 372, 375),
  drained: gh("module/zfs/txg.c", 422, 428),
  "wait-synced": gh("module/zfs/txg.c", 714, 717),
  "wait-open": gh("module/zfs/dmu.c", 1101, 1106),
  "wake-timeout": gh("module/zfs/txg.c", 542, 553),
