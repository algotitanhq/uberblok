---

<figure class="txg" data-txg data-strings={JSON.stringify({ ...S, consts })}>
  <div class="stages" role="img" aria-label={S.figure}>
    {
      (["open", "quiescing", "syncing"] as const).map((st) => (
        <section class={`stage stage--${st}`} data-stage={st}>
          <h3 class="stage-name">{S[st]}</h3>
          <p class="role">{S[`${st}Role`]}</p>
          <p class="var">
            <code>{st === "open" ? "tx_open_txg" : st === "quiescing" ? "tx_quiescing_txg" : "tx_syncing_txg"}</code>
          </p>
          <div class="slot"></div>
        </section>
      ))
    }
  </div>
  <noscript><p class="muted">{t.noScript}</p></noscript>
  <div class="live" hidden>
    <div class="disk" data-hit="disk">
      <span class="disk-label">{S.disk}</span>
      <span class="ub" data-ub></span>
    </div>
    <dl class="threads">
      <div data-hit="sync-thread"><dt>{S.syncThread} <code>txg_sync_thread</code></dt><dd data-sync-thread></dd><div class="timer" aria-hidden="true"><span></span></div></div>
      <div data-hit="quiesce-thread"><dt>{S.quiesceThread} <code>txg_quiesce_thread</code></dt><dd data-quiesce-thread></dd></div>
    </dl>
    <div class="controls">
      <div class="buttons">
        <button class="btn btn--primary" type="button" data-act="step">{S.step}</button>
        <button class="btn" type="button" data-act="write">{S.write}</button>
        <button class="btn" type="button" data-act="zsync"><code>{S.zsync}</code></button>
        <button class="btn" type="button" data-act="free">{S.free}</button>
      </div>
      <div class="buttons">
        <button class="btn" type="button" data-act="play" aria-pressed="false">{S.play}</button>
        <button class="btn" type="button" data-act="steady" aria-pressed="false">{S.steady}</button>
        <button class="btn" type="button" data-act="reset">{S.reset}</button>
        <p class="clock"><span data-clock></span> <span class="muted">· {S.clockNote}</span></p>
      </div>
    </div>
    <p class="narration" aria-live="polite"></p>
    <div class="log">
      <h4>{S.log}</h4>
      <ol reversed></ol>
    </div>
  </div>
  <details class="text-version">
    <summary>{t.textVersion}</summary>
    <ol>{textVersion.map((x) => <li>{x}</li>)}</ol>
  </details>
</figure>

<script>
  import { h, strings, fill, reducedMotion } from "../lib/svg";
  import { create, advance, step, write, zpoolSync, longFree, holds, timeLeft, CPUS, TXG_MASK, type Ev, type Model } from "../lib/txg";

  type S = Record<string, string> & { consts: Record<string, number> };
  const RING = 32; // uberblock slots at ashift 12 (Hall room)

  for (const root of document.querySelectorAll<HTMLElement>("[data-txg]")) {
    const t = strings<S>(root);
    const q = <E extends Element = HTMLElement>(sel: string) => root.querySelector(sel) as E;
    const slot = (st: string) => q(`[data-stage="${st}"] .slot`);
    const btn = (a: string) => q<HTMLButtonElement>(`[data-act="${a}"]`);
    const narration = q(".narration");
    const log = q("ol[reversed]");
    const cards = new Map<number, HTMLElement>();
    // Writers already drawn: only a new one drops in (D24.1).
    const drawn = new Set<number>();
    let m: Model;
    let playing = false;
    let last = 0;
    let raf = 0;

    // A decimal comma in French and Spanish (D16.3).
    const fmt = (x: number) => (document.documentElement.lang === "en" ? x.toFixed(1) : x.toFixed(1).replace(".", ","));
    // Singular for 1, and for 0 in French.
    const one = (n: number) => n === 1 || (n === 0 && document.documentElement.lang === "fr");
    const text = (e: Ev) => (e.kind === "sync" ? (e.n === 0 ? t.sync0 : one(Number(e.n)) ? t.sync1 : t.sync) : t[e.kind]);
    const vars = (e: Ev) => ({
      ...t.consts,
      txg: e.txg,
      cpu: e.cpu ?? "",
      n: e.n ?? "",
      next: e.txg + 1,
      prev: e.txg - 1,
      slot: e.txg % RING,
      ub: m.ub,
    });

    function card(txg: number): HTMLElement {
      let c = cards.get(txg);
      if (!c) {
        c = h("div", { class: "card" });
        c.dataset.card = String(txg);
        cards.set(txg, c);
      }
      return c;
    }

    function cpuGrid(txg: number) {
      const g = txg & TXG_MASK;
      const cells = [];
      for (let c = 0; c < CPUS; c++) {
        const ws = m.writers.filter((w) => w.cpu === c && w.txg === txg);
        cells.push(
          h("li", { class: ws.length ? "busy" : undefined, "data-cpu": String(c) },
            h("span", { class: "c" }, fill(t.cpu, { c })),
            h("span", { class: "dots", "aria-hidden": "true" }, ...ws.map((w) => h("i", { class: drawn.has(w.id) ? undefined : "new" }))),
            h("span", { class: "n" }, String(m.count[c][g])),
          ),
        );
      }
      return h("div", { class: "holds" }, h("p", { class: "k" }, t.holds), h("ul", {}, ...cells));
    }

    function render() {
      const placed = new Set<number>();
      const first = new Map<number, DOMRect>();
      for (const [txg, c] of cards) if (c.isConnected) first.set(txg, c.getBoundingClientRect());
      const put = (st: string, txg: number, ...kids: (Node | string)[]) => {
        const c = card(txg);
        c.className = `card card--${st}`;
        c.replaceChildren(h("p", { class: "num" }, `txg ${txg}`), ...kids);
        if (c.parentElement !== slot(st)) slot(st).replaceChildren(c);
        placed.add(txg);
      };
      // Open
      const d = m.dirty[m.open & TXG_MASK];
      put("open", m.open, cpuGrid(m.open),
        h("div", { class: "meter" },
          h("span", { class: "bar" }, h("span", { style: `width:${Math.min(100, (d / (t.consts.dsync * 2)) * 100)}%` }), h("span", { class: "mark", style: "left:50%" })),
          h("span", { class: "k" }, fill(one(d) ? t.dirty1 : t.dirty, { n: d }), " · ", fill(t.dirtyNote, { s: t.consts.dsync })),
        ));
      // Quiescing, or quiesced and waiting for the sync thread
      const qt = m.quiescing || m.quiesced;
      if (qt) {
        put("quiescing", qt, cpuGrid(qt),
          h("p", { class: "state" }, m.quiescing ? fill(one(holds(m, qt)) ? t.drain1 : t.drain, { n: holds(m, qt) }) : t.quiesced));
      } else slot("quiescing").replaceChildren(h("p", { class: "none" }, t.empty));
      // Once quiesced, the txg sits in tx_quiesced_txg and tx_quiescing_txg is 0 (txg.c L662-L663)
      q('[data-stage="quiescing"] .var code').textContent = m.quiesced ? "tx_quiesced_txg" : "tx_quiescing_txg";
      // Syncing
      const s = m.sync;
      if (s) {
        const rows = s.passes.map((b, i) =>
          h("li", { class: s.pass > i + 1 || s.phase !== "passes" ? "done" : s.pass === i + 1 ? "now" : undefined, "data-pass": String(i + 1) },
            h("span", { class: "k" }, fill(t.passLabel, { n: i + 1 })),
            h("span", { class: "bar" }, h("span", { style: `width:${Math.min(100, b * 8)}%` })),
            h("span", { class: "k" }, fill(one(b) ? t.passBlock : t.passBlocks, { n: b })),
          ),
        );
        if (s.noop) rows.splice(1);
        rows.push(h("li", { class: s.phase === "config" ? "now" : s.phase === "done" ? "done" : undefined, "data-pass": "config" },
          h("span", { class: "k cfg" }, s.noop ? t.noopCfg : t.config)));
        put("syncing", s.txg, h("ol", { class: "passes" }, ...rows));
      } else slot("syncing").replaceChildren(h("p", { class: "none" }, t.empty));
      for (const txg of [...cards.keys()]) if (!placed.has(txg)) cards.delete(txg);
      for (const w of m.writers) drawn.add(w.id);
      // FLIP: a txg card glides from one stage to the next.
      if (!reducedMotion())
        for (const [txg, c] of cards) {
          const a = first.get(txg);
          if (!a) continue;
          const b = c.getBoundingClientRect();
          const dx = a.left - b.left, dy = a.top - b.top;
          if (Math.abs(dx) + Math.abs(dy) > 2)
            c.animate([{ transform: `translate(${dx}px, ${dy}px)` }, { transform: "none" }], { duration: 450, easing: "cubic-bezier(0.2, 0.7, 0.2, 1)" });
        }
      status();
      q(".stages").setAttribute("aria-label", `${t.figure}. ${fill(t.aria, { open: m.open, q: qt ? `txg ${qt}` : t.empty, s: s ? `txg ${s.txg}` : t.empty, ub: m.ub })}`);
    }

    function status() {
      q("[data-ub]").textContent = fill(t.ubOnDisk, { txg: m.ub, slot: m.ub % RING });
      const left = timeLeft(m);
      q("[data-sync-thread]").textContent =
        m.syncState === "wait" ? fill(t.sWait, { left: fmt(left), timeout: t.consts.timeout })
          : m.syncState === "want" ? (m.quiesced ? fill(t.sTake, { txg: m.quiesced }) : fill(t.sWant, { txg: m.quiescing || m.open }))
            : fill(t.sSync, { txg: m.syncing });
      q<HTMLElement>(".timer span").style.width = m.syncState === "wait" ? `${(1 - left / t.consts.timeout) * 100}%` : "0";
      q("[data-quiesce-thread]").textContent =
        m.quiesceState === "drain" ? fill(t.qDrain, { txg: m.quiescing }) : m.quiesced ? fill(t.qWaitFull, { txg: m.quiesced }) : t.qWait;
      q("[data-clock]").textContent = fill(t.clock, { t: fmt(m.t) });
    }

    // The part of the figure an event changed: it gets an outline until the next
    // event, so each step shows one effect (D24.1). Static, so it shows under
    // reduced motion too.
    function target(e: Ev): Element | null {
      const inCard = (sel: string) => root.querySelector(`.card[data-card="${e.txg}"] ${sel}`);
      switch (e.kind) {
        case "hold":
        case "rele":
          return inCard(`[data-cpu="${e.cpu}"]`);
        case "kick":
          return inCard(".meter");
        case "quiesce":
        case "drained":
        case "handoff":
        case "sync":
          return root.querySelector(`.card[data-card="${e.txg}"]`);
        case "pass":
        case "converged":
          return inCard(`[data-pass="${e.n}"]`);
        case "noop":
          return inCard('[data-pass="1"]');
        case "uberblock":
        case "no-uberblock":
          return q('[data-hit="disk"]');
        case "want-quiesce":
        case "wait-open":
          return q('[data-hit="quiesce-thread"]');
        default: // wake-*, wait-synced, synced
          return q('[data-hit="sync-thread"]');
      }
    }
    function mark(e: Ev | undefined) {
      for (const x of root.querySelectorAll(".hit")) x.classList.remove("hit");
      const el = e && target(e);
      if (el) el.classList.add("hit");
    }

    // Returns the event the narration shows: the last one after a press, the last
    // stage change while playing, so a screen reader is not flooded.
    function tell(evs: Ev[], announce: boolean): Ev | undefined {
      if (!evs.length) return;
      for (const e of evs) log.prepend(h("li", {}, h("span", { class: "at" }, `${fmt(e.t)} s`), " ", fill(text(e), vars(e))));
      while (log.children.length > 8) log.lastElementChild!.remove();
      const e = announce ? evs[evs.length - 1] : [...evs].reverse().find((x) => x.major);
      if (e) {
        narration.textContent = fill(text(e), vars(e));
        if (e.kind === "uberblock") {
          const ub = q("[data-ub]");
          ub.classList.remove("flash");
          void ub.offsetWidth;
          ub.classList.add("flash");
        }
      }
      return e;
    }

    function frame(now: number) {
      const dt = Math.min(0.25, (now - last) / 1000);
      last = now;
      const evs = advance(m, dt);
      if (evs.length) {
        const e = tell(evs, false);
        render();
        if (e) mark(e);
      } else status();
      raf = requestAnimationFrame(frame);
    }

    function setPlaying(on: boolean) {
      playing = on;
      btn("play").setAttribute("aria-pressed", String(on));
      btn("play").textContent = on ? t.pause : t.play;
      cancelAnimationFrame(raf);
      if (on) {
        last = performance.now();
        raf = requestAnimationFrame(frame);
      }
    }

    const act = (f: () => Ev | Ev[]) => () => {
      const r = f();
      const evs = Array.isArray(r) ? r : [r];
      const e = tell(evs, true);
      render();
      mark(e);
    };
    btn("write").addEventListener("click", act(() => write(m)));
    btn("zsync").addEventListener("click", act(() => zpoolSync(m)));
    btn("free").addEventListener("click", act(() => longFree(m)));
    btn("step").addEventListener("click", act(() => step(m)));
    btn("steady").addEventListener("click", () => {
      m.steady = m.steady ? 0 : 1;
      m.nextSteady = m.t + m.steady;
      btn("steady").setAttribute("aria-pressed", String(!!m.steady));
    });
    btn("play").addEventListener("click", () => setPlaying(!playing));
    btn("reset").addEventListener("click", init);
    // Off screen or in a background tab, the figure pauses.
    document.addEventListener("visibilitychange", () => document.hidden && playing && setPlaying(false));

    function init() {
      setPlaying(false);
      m = create(41);
      btn("steady").setAttribute("aria-pressed", "false");
      cards.clear();
      drawn.clear();
      log.replaceChildren();
      // Two writes under way, started 0.3 s apart so that each ends on its own step.
      write(m);
      advance(m, 0.3);
      write(m);
      m.log = [];
      narration.textContent = fill(t.idle, { open: m.open, synced: m.synced });
      render();
      mark(undefined);
    }

    init();
    q(".live").hidden = false;
  }
</script>

