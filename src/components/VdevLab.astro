---
// The figure of the vdevs room: a pool's vdev tree, the classes its blocks
// land in, the I/O of each block down the tree, and the replacement of a
// disk. src/lib/vdevs.ts decides every outcome, src/lib/vdevs-view.ts draws
// it in 2D (SVG) and src/lib/vdevs-3d.ts in 3D, loaded only on demand
// (src/lib/lazy3d.ts). Shown without JavaScript: the default pool after a
// metadata block and a large file block. Refs: ANALYSIS.md, room "The vdevs";
// simplifications: DECISIONS.md D11.2 to D11.4. No code links in the figure,
// a line under the controls says what the last action did (D26.1).
import type { Lang } from "../lib/rooms";
import { UI } from "../lib/ui";
import { fr } from "../lib/fr";
import { createPool, writeBlock, DEFAULT_OPTIONS, KINDS } from "../lib/vdevs";
import { treeSvg, lastHtml, opsHtml, classesHtml, auxHtml, legendHtml, nodeOptions, describe, dropLine, topsOf, type VdStrings } from "../lib/vdevs-view";
import { VDEVS_STRINGS } from "../lib/vdevs-strings";
import "../styles/vdevs.css";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const S = { ...Object.fromEntries(Object.entries(VDEVS_STRINGS[lang]).map(([k, v]) => [k, lang === "fr" ? fr(v) : v])), refs: {}, lang } as unknown as VdStrings;
const t = UI[lang];
const first = writeBlock(createPool(DEFAULT_OPTIONS), "meta");
const second = writeBlock(first.pool, "large");
const p0 = second.pool;
const io0 = { block: second.block, trace: second.trace, type: "write" as const };
const sel0 = "sdd";
const now0 = dropLine(S, p0, second.block, second.trace);
const helpId = `vd-help-${lang}`;
---

<figure class="vd" data-vdevs data-strings={JSON.stringify(S)} data-help={helpId} aria-label={S.figure}>
  <div class="vd-bar" hidden>
    <div class="buttons" role="group" aria-label={S.poolLabel}>
      <span class="glabel">{S.poolLabel}</span>
      <button class="btn" type="button" data-opt="log" aria-pressed="true">{S.optLog}</button>
      <button class="btn" type="button" data-opt="special" aria-pressed="true">{S.optSpecial}</button>
      <button class="btn" type="button" data-opt="dedup" aria-pressed="false">{S.optDedup}</button>
    </div>
    <div class="buttons" role="group" aria-label={S.smallLabel}>
      <span class="glabel"><code>{S.smallLabel}</code></span>
      <button class="btn" type="button" data-small="0" aria-pressed="true">0</button>
      <button class="btn" type="button" data-small="16384" aria-pressed="false">{lang === "fr" ? "16 Kio" : lang === "es" ? "16\u00a0KiB" : "16 KiB"}</button>
      <span class="glabel">{S.fillLabel}</span>
      <button class="btn" type="button" data-fill="low" aria-pressed="true">{S.fillLow}</button>
      <button class="btn" type="button" data-fill="over75" aria-pressed="false">{S.fillOver75}</button>
      <button class="btn" type="button" data-fill="full" aria-pressed="false">{S.fillFull}</button>
    </div>
    <div class="buttons" role="group" aria-label={S.dropLabel}>
      <span class="glabel">{S.dropLabel}</span>
      {KINDS.map((k) => <button class="btn btn--primary" type="button" data-kind={k}><span class={`kd kd-${k}`} aria-hidden="true"></span>{S[`b_${k}`]}</button>)}
    </div>
    <div class="buttons">
      <button class="btn" type="button" data-act="read">{S.readBack}</button>
      <button class="btn" type="button" data-act="restart">{S.restart}</button>
      <button class="btn" type="button" data-view3d aria-pressed="false" hidden>{S.view3d}</button>
    </div>
  </div>
  <p class="vd-now" data-now aria-hidden="true" set:html={now0} />
  <div class="vd-grid">
    <div class="vd-stage">
      <div data-tree set:html={treeSvg(S, p0, io0.trace, sel0, topsOf(io0.block))} />
      <div class="vd-3d" data-3d hidden></div>
      <p class="vd-help muted" id={helpId} data-help-text hidden>{S.view3dHelp}</p>
      <p class="muted" id={`${helpId}-no3d`} data-no3d hidden>{S.no3d}</p>
      <div class="vd-key" set:html={legendHtml(S)} />
    </div>
    <div class="vd-side">
      <section class="panel" aria-labelledby={`vd-last-${lang}`}>
        <h3 id={`vd-last-${lang}`}>{S.lastTitle}</h3>
        <div data-last set:html={lastHtml(S, p0, io0)} />
      </section>
      <section class="panel" aria-labelledby={`vd-cls-${lang}`}>
        <h3 id={`vd-cls-${lang}`}>{S.classTitle}</h3>
        <div data-classes set:html={classesHtml(S, p0, io0.block.cls)} />
      </section>
    </div>
  </div>
  <div class="vd-bar vd-sel" hidden>
    <label class="vd-pick"><span class="glabel">{S.nodeLabel}</span> <select data-pick set:html={nodeOptions(S, p0, sel0)}></select></label>
    <div class="buttons" role="group" aria-label={S.replaceLabel}>
      <button class="btn" type="button" data-rep="new">{S.replaceNew}</button>
      <button class="btn" type="button" data-rep="spare">{S.replaceSpare.replace("{spare}", p0.spares[0])}</button>
      <button class="btn" type="button" data-rep="dspare">{S.replaceDspare.replace("{spare}", p0.spares[1])}</button>
      <button class="btn" type="button" data-act="resilver">{S.resilverDone}</button>
    </div>
  </div>
  <div class="vd-panels">
    <section class="panel" aria-labelledby={`vd-ops-${lang}`}>
      <h3 id={`vd-ops-${lang}`}>{S.opsTitle}</h3>
      <div data-ops set:html={opsHtml(S, p0, sel0)} />
    </section>
    <section class="panel vd-aux" aria-labelledby={`vd-aux-${lang}`}>
      <h3 id={`vd-aux-${lang}`}>{S.auxTitle}</h3>
      <div data-aux set:html={auxHtml(S, p0)} />
    </section>
  </div>
  <p class="visually-hidden" data-live aria-live="polite"></p>
  <noscript><p class="muted">{t.noScript}</p></noscript>
  <details class="text-version">
    <summary>{t.textVersion}</summary>
    <div data-describe set:html={describe(S, p0, io0)} />
  </details>
</figure>

<script>
  import { strings, reducedMotion } from "../lib/svg";
  import { createPool, writeBlock, ioTrace, replace, resilverDone, canReplace, sameBlock, DEFAULT_OPTIONS, type Options, type Pool, type Kind } from "../lib/vdevs";
  import {
    treeSvg, lastHtml, opsHtml, classesHtml, auxHtml, nodeOptions, describe, spoken, topsOf,
    fill, dropLine, readLine, replaceLine, resilverLine, poolLine, selectLine, type VdStrings, type LastIo,
  } from "../lib/vdevs-view";
  import { no3dReason, once } from "../lib/lazy3d";
  import type { Scene3d } from "../lib/vdevs-3d";

  const load3d = once(() => import("../lib/vdevs-3d"));

  for (const root of document.querySelectorAll<HTMLElement>("[data-vdevs]")) {
    const S = strings<VdStrings>(root);
    const q = <E extends Element = HTMLElement>(sel: string) => root.querySelector(sel) as E;
    let opts: Options = { ...DEFAULT_OPTIONS };
    let pool: Pool;
    let io: LastIo | null;
    // The last block written: "Read it back" still reads it after a replacement.
    let last: LastIo["block"] | null = null;
    let selected = "sdd";
    let scene: Scene3d | null = null;
    let is3d = false;
    const no3d = no3dReason();

    function start() {
      const a = writeBlock(createPool(opts), "meta");
      const b = writeBlock(a.pool, "large");
      pool = b.pool;
      io = { block: b.block, trace: b.trace, type: "write" };
      last = b.block;
    }

    /**
     * The visible line, and one announcement per action: the live region is
     * emptied, then filled on the next frame, so that the same text twice is
     * announced twice; it reads the line without its code links.
     */
    function say(html: string) {
      const el = q("[data-now]");
      el.hidden = false;
      el.innerHTML = html;
      const live = q("[data-live]");
      live.textContent = "";
      requestAnimationFrame(() => (live.textContent = spoken(html)));
    }

    function render(animate: boolean) {
      if (!pool.vdevs[selected]) selected = pool.vdevs.sdd ? "sdd" : "root";
      // The last write's vdevs and class are marked until the next action.
      const wrote = io?.type === "write" ? io.block : null;
      q("[data-tree]").innerHTML = treeSvg(S, pool, io?.trace ?? null, selected, topsOf(wrote));
      q("[data-aux]").innerHTML = auxHtml(S, pool);
      q("[data-last]").innerHTML = lastHtml(S, pool, io);
      q("[data-ops]").innerHTML = opsHtml(S, pool, selected);
      q("[data-classes]").innerHTML = classesHtml(S, pool, wrote?.cls ?? null);
      q("[data-describe]").innerHTML = describe(S, pool, io);
      q<HTMLSelectElement>("[data-pick]").innerHTML = nodeOptions(S, pool, selected);
      for (const b of root.querySelectorAll<HTMLElement>("[data-opt]")) b.setAttribute("aria-pressed", String(opts[b.dataset.opt as "log"]));
      for (const b of root.querySelectorAll<HTMLElement>("[data-small]")) b.setAttribute("aria-pressed", String(Number(b.dataset.small) === opts.smallblk));
      for (const b of root.querySelectorAll<HTMLElement>("[data-fill]")) {
        b.setAttribute("aria-pressed", String(b.dataset.fill === opts.specialFill));
        // The fill of special means nothing without a special vdev.
        b.setAttribute("aria-disabled", String(!opts.special));
      }
      for (const b of root.querySelectorAll<HTMLElement>("[data-rep]")) b.setAttribute("aria-disabled", String(!!canReplace(pool, selected, b.dataset.rep as "new")));
      q("[data-act='read']").setAttribute("aria-disabled", String(!last));
      if (scene) scene.draw(pool, io, selected, animate && !reducedMotion());
      if (animate && !reducedMotion() && !is3d) {
        for (const el of root.querySelectorAll<SVGGraphicsElement>("[data-tree] .n.on, [data-tree] .edge.on")) {
          const d = Number(el.getAttribute("data-depth") ?? 0);
          el.animate([{ opacity: 0.15 }, { opacity: 1 }], { duration: 260, delay: d * 180, fill: "backwards", easing: "cubic-bezier(0.2, 0.7, 0.2, 1)" });
        }
      }
    }

    function select(id: string, announce = true) {
      if (!pool.vdevs[id]) return;
      selected = id;
      render(false);
      if (announce) say(selectLine(S, pool, id));
    }

    async function set3d(on: boolean, announce: boolean) {
      const btn = q("[data-view3d]");
      // One load at a time: a second click while Three.js loads does nothing.
      if (btn.getAttribute("aria-busy") === "true") return say(S.view3dLoading);
      if (on && !scene) {
        btn.setAttribute("aria-busy", "true");
        btn.textContent = S.view3dLoading;
        try {
          const mod = await load3d();
          scene = mod.mount(q("[data-3d]"), { onPick: (id) => select(id), label: S.canvasLabel, describedBy: root.dataset.help });
        } catch {
          q("[data-no3d]").hidden = false;
          on = false;
        }
        btn.removeAttribute("aria-busy");
        btn.textContent = S.view3d;
      }
      is3d = on;
      q("[data-3d]").hidden = !on;
      q("[data-help-text]").hidden = !on;
      q("[data-tree]").hidden = on;
      btn.setAttribute("aria-pressed", String(on));
      if (on && scene) scene.draw(pool, io, selected, false);
      if (announce) say(on ? S.say3d : S.say2d);
    }

    const off = (el: Element) => el.getAttribute("aria-disabled") === "true";

    root.addEventListener("click", (e) => {
      const target = e.target as Element;
      const node = target.closest<SVGGElement>("[data-tree] [data-node]");
      if (node) return select(node.dataset.node!);
      const el = target.closest<HTMLElement>("button");
      if (!el || !root.contains(el)) return;
      if (el.dataset.opt) {
        const k = el.dataset.opt as "log" | "special" | "dedup";
        opts = { ...opts, [k]: !opts[k] };
        start();
        render(false);
        say(poolLine(S, pool));
      } else if (el.dataset.small !== undefined) {
        opts = { ...opts, smallblk: Number(el.dataset.small) };
        pool = { ...pool, opts: { ...pool.opts, smallblk: opts.smallblk } };
        render(false);
        say(fill(S.saySmall, { v: el.textContent ?? "" }));
      } else if (el.dataset.fill) {
        if (off(el)) return say(S.why_noSpecial);
        opts = { ...opts, specialFill: el.dataset.fill as Options["specialFill"] };
        pool = { ...pool, opts: { ...pool.opts, specialFill: opts.specialFill } };
        render(false);
        say(fill(S.sayFill, { v: el.textContent ?? "" }));
      } else if (el.dataset.kind) {
        const r = writeBlock(pool, el.dataset.kind as Kind);
        pool = r.pool;
        io = { block: r.block, trace: r.trace, type: "write" };
        last = r.block;
        render(true);
        say(dropLine(S, pool, r.block, r.trace));
      } else if (el.dataset.act === "read") {
        if (off(el) || !last) return say(S.why_noBlock);
        const b = last;
        const trace = ioTrace(pool, b, "read");
        io = { block: b, trace, type: "read" };
        render(true);
        say(readLine(S, pool, b, trace));
      } else if (el.dataset.act === "restart") {
        pool = createPool(opts);
        io = null;
        last = null;
        render(false);
        say(S.sayRestart);
      } else if (el.dataset.rep) {
        const by = el.dataset.rep as "new" | "spare" | "dspare";
        const why = canReplace(pool, selected, by);
        if (why) return say(S[`why_${why}`]);
        const old = selected;
        const r = replace(pool, old, by);
        if (last) last = sameBlock(pool, r.pool, last);
        pool = r.pool;
        selected = r.node;
        io = null;
        render(false);
        say(replaceLine(S, pool, old, r.node, r.added));
      } else if (el.dataset.act === "resilver") {
        const before = pool;
        const r = resilverDone(pool);
        if (last) last = sameBlock(pool, r.pool, last);
        pool = r.pool;
        io = null;
        render(false);
        say(resilverLine(S, before, pool, r.collapsed, r.kept));
      } else if (el.hasAttribute("data-view3d")) {
        if (no3d) return say(S[no3d]);
        void set3d(!is3d, true);
      }
    });

    q<HTMLSelectElement>("[data-pick]").addEventListener("change", (e) => select((e.target as HTMLSelectElement).value));

    start();
    render(false);
    for (const b of root.querySelectorAll<HTMLElement>(".vd-bar")) b.hidden = false;
    // 2D first, always: 3D only on a press of the button (DECISIONS.md D14.1).
    // Without WebGL or under reduced motion, the button stays, disabled, with its reason.
    q("[data-view3d]").hidden = false;
    if (no3d) {
      q("[data-view3d]").setAttribute("aria-disabled", "true");
      q("[data-view3d]").setAttribute("aria-describedby", q("[data-no3d]").id);
      q("[data-no3d]").textContent = S[no3d];
      q("[data-no3d]").hidden = false;
    }
  }
</script>
