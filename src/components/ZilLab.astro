---
// The figure of the ZIL and SLOG room: an application writing to a file, what
// the next write puts in its record, the records and lwbs in memory, and on
// disk the log header, the chain of log blocks and the devices they live on.
// The visitor picks the log device, logbias, O_DSYNC, O_DIRECT and a size,
// writes, fsyncs, syncs the txg, cuts the power, imports and mounts; each
// action then shows one step per press of Next step, and a ring marks what the
// step changed (D30.1). src/lib/zil.ts (a transcription of zil.c, zfs_log.c and
// zio.c) decides every outcome, and src/lib/zil-view.ts draws it, at build time
// for the opening state (readable without JavaScript) and in the browser after.
// Refs: ANALYSIS.md, room "ZIL and SLOG"; simplifications: DECISIONS.md D8.2.
import type { Lang } from "../lib/rooms";
import { UI } from "../lib/ui";
import { fr } from "../lib/fr";
import { empty, SIZES, KIB } from "../lib/zil";
import { ZIL_STRINGS } from "../lib/zil-strings";
import { decision, writes, memory, disk, describe, summary, type ZilStrings } from "../lib/zil-view";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const S0 = ZIL_STRINGS[lang];
const S = { ...Object.fromEntries(Object.entries(S0).map(([k, v]) => [k, lang === "fr" ? fr(v) : v])), lang } as unknown as ZilStrings;
const t = UI[lang];
const s0 = empty();
const kib = (n: number) => (lang === "fr" ? `${n} Kio` : lang === "es" ? `${n}\u00a0KiB` : `${n} KiB`);
---

<figure class="zl" data-zl data-strings={JSON.stringify(S)} aria-label={S.figure}>
  <div class="zl-bar" hidden>
    <div class="buttons" role="group" aria-label={S.poolLabel}>
      <span class="glabel">{S.poolLabel}</span>
      <button class="btn" type="button" data-pool="none" aria-pressed="true">{S.slogNone}</button>
      <button class="btn" type="button" data-pool="slog" aria-pressed="false">{S.slogSlog}</button>
      <button class="btn" type="button" data-pool="full" aria-pressed="false">{S.slogFull}</button>
    </div>
    <div class="buttons" role="group" aria-label={S.biasLabel}>
      <span class="glabel"><code>{S.biasLabel}</code></span>
      <button class="btn" type="button" data-bias="latency" aria-pressed="true">latency</button>
      <button class="btn" type="button" data-bias="throughput" aria-pressed="false">throughput</button>
    </div>
    <div class="buttons" role="group" aria-label={S.flagsLabel}>
      <span class="glabel">{S.flagsLabel}</span>
      <button class="btn" type="button" data-flag="dsync" aria-pressed="false"><code>O_DSYNC</code></button>
      <button class="btn" type="button" data-flag="direct" aria-pressed="false"><code>O_DIRECT</code></button>
    </div>
    <div class="buttons" role="group" aria-label={S.sizeLabel}>
      <span class="glabel">{S.sizeLabel}</span>
      {SIZES.map((n, i) => <button class="btn" type="button" data-size={n} aria-pressed={i === 0 ? "true" : "false"}>{kib(n / KIB)}</button>)}
    </div>
    <div class="buttons actions">
      <button class="btn btn--primary" type="button" data-act="write"><code>{S.writeBtn}</code></button>
      <button class="btn btn--primary" type="button" data-act="fsync"><code>{S.fsyncBtn}</code></button>
      <button class="btn" type="button" data-act="sync" data-sync>{S.syncBtn.replace("{txg}", String(s0.txg))}</button>
      <button class="btn btn--danger" type="button" data-act="crash">{S.crashBtn}</button>
      <button class="btn" type="button" data-act="import" disabled><code>{S.importBtn}</code></button>
      <button class="btn" type="button" data-act="mount" disabled><code>{S.mountBtn}</code></button>
      <button class="btn" type="button" data-act="reset">{S.reset}</button>
    </div>
  </div>
  <p class="visually-hidden" data-summary>{summary(s0, S)}</p>
  <p class="visually-hidden" data-status aria-live="polite"></p>

  <section class="panel decision" aria-labelledby={`zl-dec-${lang}`}>
    <h3 id={`zl-dec-${lang}`} set:html={S.decisionLabel} />
    <div data-decision set:html={decision(s0, S, SIZES[0], { dsync: false, direct: false })} />
  </section>

  <div class="zl-grid">
    <section class="panel app" aria-labelledby={`zl-app-${lang}`}>
      <h3 id={`zl-app-${lang}`}>{S.appLabel}</h3>
      <div data-writes set:html={writes(s0, S)} />
    </section>
    <section class="panel mem" aria-labelledby={`zl-mem-${lang}`}>
      <h3 id={`zl-mem-${lang}`}>{S.memLabel}</h3>
      <div data-memory set:html={memory(s0, S)} />
    </section>
    <section class="panel disk" aria-labelledby={`zl-disk-${lang}`}>
      <h3 id={`zl-disk-${lang}`}>{S.diskLabel}</h3>
      <div data-disk set:html={disk(s0, S)} />
    </section>
  </div>

  <ul class="key" aria-label={S.keyLabel}>
    <li><span class="wr wr-copied">WR_COPIED</span> {S.keyCopied}</li>
    <li><span class="wr wr-need-copy">WR_NEED_COPY</span> {S.keyNeedCopy}</li>
    <li><span class="wr wr-indirect">WR_INDIRECT</span> {S.keyIndirect}</li>
    <li><span class="kcell written" aria-hidden="true">b1</span> {S.keyWritten}</li>
    <li><span class="kcell end" aria-hidden="true">b2</span> {S.keyEnd}</li>
    <li><span class="kcell freed" aria-hidden="true">b0</span> {S.keyFreed}</li>
    <li class="khit" hidden><span class="kring" aria-hidden="true"></span> {S.keyHit}</li>
  </ul>

  <div class="stepbar" hidden>
    <div class="stepbtns">
      <button class="btn btn--primary" type="button" data-step="next" aria-disabled="true">{S.next}</button>
      <button class="btn" type="button" data-step="skip" aria-disabled="true">{S.skip}</button>
    </div>
    <p class="narration" aria-live="polite" data-now>{S.idle}</p>
  </div>

  <noscript><p class="muted noscript">{t.noScript}</p></noscript>
  <section class="zl-log" aria-labelledby={`zl-log-${lang}`} hidden>
    <h3 id={`zl-log-${lang}`}>{S.logLabel}</h3>
    <ol data-log><li class="muted">{S.logEmpty}</li></ol>
  </section>
  <details class="text-version">
    <summary>{t.textVersion}</summary>
    <div data-describe set:html={describe(s0, S)} />
  </details>
</figure>

<script>
  import { strings, reducedMotion, fill } from "../lib/svg";
  import { empty, write, fsync, sync, crash, importPool, mount, clone, SIZES, type Zil, type Ev, type Flags, type SlogMode, type Logbias } from "../lib/zil";
  import { decision, writes, memory, disk, describe, summary, eventLine, eventClass, frameAt, targets, drawnBefore, type ZilStrings, type Frame } from "../lib/zil-view";

  for (const root of document.querySelectorAll<HTMLElement>("[data-zl]")) {
    const S = strings<ZilStrings>(root);
    const q = <E extends Element = HTMLElement>(sel: string) => root.querySelector(sel) as E;
    const logEl = q("[data-log]");
    const now = q("[data-now]");
    let s: Zil = empty();
    let size = SIZES[0];
    const flags: Flags = { dsync: false, direct: false };
    // The action being shown one step per press: its events, the state before it, and how many
    // steps are shown so far.
    let ev: Ev[] = [];
    let before: Zil = clone(s);
    let shown = 0;
    const stepping = () => shown < ev.length;

    const keyOf = (el: Element | null) => {
      if (!(el instanceof HTMLElement) || !root.contains(el)) return null;
      for (const k of ["act", "pool", "bias", "flag", "size", "step"]) if (el.dataset[k]) return `[data-${k}="${el.dataset[k]}"]`;
      return null;
    };

    function controls() {
      const busy = stepping();
      // A sync or a mount is drawn from the state before it until its last step: the buttons
      // follow the figure, not the model, so Sync still names the txg being synced.
      const shownState = busy && drawnBefore(ev) ? before : s;
      const ph = shownState.phase;
      // Steps that do not apply in this phase are disabled; while an action still has steps to
      // show, every control but the step buttons and Start again is aria-disabled instead, so
      // that the focused button keeps the focus and a press can say why.
      for (const b of root.querySelectorAll<HTMLButtonElement>("[data-act]")) {
        const a = b.dataset.act!;
        b.disabled = a === "import" ? ph !== "crashed" : a === "mount" ? ph !== "imported" : a === "reset" ? false : ph !== "running";
      }
      for (const b of root.querySelectorAll<HTMLButtonElement>(".zl-bar button:not([data-act=reset])")) {
        if (busy) b.setAttribute("aria-disabled", "true");
        else b.removeAttribute("aria-disabled");
      }
      for (const b of root.querySelectorAll<HTMLButtonElement>("[data-step]")) b.setAttribute("aria-disabled", String(!busy));
      for (const b of root.querySelectorAll<HTMLButtonElement>("[data-pool]")) {
        b.setAttribute("aria-pressed", String(b.dataset.pool === s.pool.slog));
        // The devices are the pool's: they do not change between a crash and the mount.
        b.disabled = ph !== "running";
      }
      for (const b of root.querySelectorAll<HTMLElement>("[data-bias]")) b.setAttribute("aria-pressed", String(b.dataset.bias === s.logbias));
      for (const b of root.querySelectorAll<HTMLElement>("[data-flag]")) b.setAttribute("aria-pressed", String(flags[b.dataset.flag as keyof Flags]));
      for (const b of root.querySelectorAll<HTMLElement>("[data-size]")) b.setAttribute("aria-pressed", String(Number(b.dataset.size) === size));
      q("[data-sync]").textContent = fill(S.syncBtn, { txg: shownState.txg });
    }

    function draw(f?: Frame) {
      q("[data-writes]").innerHTML = writes(s, S, f);
      q("[data-memory]").innerHTML = memory(s, S, f);
      q("[data-disk]").innerHTML = disk(s, S, f);
    }

    function render(focusKey: string | null = keyOf(document.activeElement)) {
      draw();
      q("[data-decision]").innerHTML = decision(s, S, size, flags);
      q("[data-summary]").textContent = summary(s, S);
      q("[data-describe]").innerHTML = describe(s, S);
      // The panels are drawn again with no ring, so the ring's key goes too.
      q(".khit").hidden = true;
      controls();
      refocus(focusKey);
    }

    function refocus(focusKey: string | null) {
      if (!focusKey) return;
      const el = root.querySelector<HTMLButtonElement>(focusKey);
      if (el && !el.disabled) el.focus({ preventScroll: true });
      else {
        const next = s.phase === "crashed" ? "import" : s.phase === "imported" ? "mount" : "write";
        q(`[data-act="${next}"]`).focus({ preventScroll: true });
      }
    }

    const plain = (html: string) => html.replace(/<[^>]+>/g, "");
    /** A message in the narration, announced even when it repeats. */
    function tell(t: string) {
      now.textContent = "";
      requestAnimationFrame(() => (now.textContent = t));
    }
    function say(t: string) {
      const el = q("[data-status]");
      el.textContent = "";
      requestAnimationFrame(() => (el.textContent = t));
    }
    /** After a toggle, the new decision is read out. */
    const sayDecision = () => say(plain(q("[data-decision] .verdict").innerHTML + " " + q("[data-decision] .reasons").innerHTML.replace(/<\/li>/g, " ")));

    // The ring: what the last step changed, until the next step. A class, so it reads under
    // reduced motion too; it fades in only when motion is allowed.
    function ring(e: Ev | undefined): Element[] {
      for (const x of root.querySelectorAll(".hit")) x.classList.remove("hit", "hit-first");
      const els = e ? targets(e).flatMap((sel) => [...root.querySelectorAll(sel)]) : [];
      for (const x of els) x.classList.add("hit");
      els[0]?.classList.add("hit-first");
      q(".khit").hidden = !els.length;
      return els;
    }
    // The figure is taller than most screens: after a step, bring the ringed parts into view
    // above the bar, which sticks to the bottom of the screen. All of them when they fit
    // together, otherwise the first, which is the one the narration names.
    function show(els: Element[]) {
      const rs = els.map((x) => x.getBoundingClientRect()).filter((r) => r.width || r.height);
      if (!rs.length) return;
      const room = Math.min(q(".stepbar").getBoundingClientRect().top, innerHeight) - 8;
      const top = Math.min(...rs.map((r) => r.top));
      const bottom = Math.max(...rs.map((r) => r.bottom));
      const [t, b] = bottom - top <= room - 8 ? [top, bottom] : [rs[0].top, rs[0].bottom];
      if (t >= 8 && b <= room) return;
      const by = t < 8 || b - t > room - 8 ? t - 8 : b - room;
      window.scrollBy({ top: by, behavior: reducedMotion() ? "auto" : "smooth" });
    }

    function logLine(e: Ev) {
      const li = document.createElement("li");
      li.className = eventClass(e);
      li.innerHTML = eventLine(S, e);
      logEl.append(li);
    }

    /** Shows the steps up to `upTo` (exclusive) of the action in progress. */
    function advance(upTo: number, focusKey: string | null) {
      if (!ev.length) return;
      for (let k = shown; k < upTo; k++) logLine(ev[k]);
      shown = upTo;
      const k = shown - 1;
      const last = shown >= ev.length;
      if (last) render(focusKey);
      else {
        draw(frameAt(before, s, ev, k));
        controls();
        refocus(focusKey);
      }
      const line = eventLine(S, ev[k], true);
      now.innerHTML = ev.length > 1 ? `${fill(S.stepOf, { k: shown, n: ev.length })} ${line}` : line;
      show(ring(ev[k]));
    }

    function act(f: () => Ev[]) {
      const focusKey = keyOf(document.activeElement);
      before = clone(s);
      ev = f();
      shown = 0;
      logEl.replaceChildren();
      // A refusal changes nothing: the line says why, with no step to show.
      if (ev.every((e) => e.k === "refused")) {
        for (const e of ev) logLine(e);
        shown = ev.length;
        now.textContent = plain(eventLine(S, ev[0], true));
        ring(undefined);
        render(focusKey);
        return;
      }
      // The first step shows at once; Next step moves the focus there if the action has more.
      advance(1, stepping() ? '[data-step="next"]' : focusKey);
    }

    root.addEventListener("click", (e) => {
      const el = (e.target as Element).closest<HTMLElement>("button");
      if (!el || !root.contains(el)) return;
      const d = el.dataset;
      const focusKey = keyOf(el);
      if (d.act === "reset") {
        s = empty();
        before = clone(s);
        ev = [];
        shown = 0;
        size = SIZES[0];
        flags.dsync = flags.direct = false;
        logEl.innerHTML = `<li class="muted">${S.logEmpty}</li>`;
        now.textContent = S.idle;
        q("[data-status]").textContent = "";
        ring(undefined);
        render();
        return;
      }
      if (d.step) {
        if (!stepping()) {
          tell(ev.length ? S.done : S.idle);
          return;
        }
        // The focus stays in the bar, which is on screen: after Show every step the reader sees
        // the end of the action, not the top of the figure.
        advance(d.step === "skip" ? ev.length : shown + 1, focusKey);
        return;
      }
      if (el.getAttribute("aria-disabled") === "true") {
        if (stepping()) tell(S.busy);
        return;
      }
      if (d.pool) {
        s.pool = { slog: d.pool as SlogMode };
        render();
        sayDecision();
      } else if (d.bias) {
        s.logbias = d.bias as Logbias;
        render();
        sayDecision();
      } else if (d.flag) {
        const k = d.flag as keyof Flags;
        flags[k] = !flags[k];
        render();
        sayDecision();
      } else if (d.size) {
        size = Number(d.size);
        render();
        sayDecision();
      } else if (d.act === "write") act(() => write(s, size, { ...flags }));
      else if (d.act === "fsync") act(() => fsync(s));
      else if (d.act === "sync") act(() => sync(s));
      else if (d.act === "crash") act(() => crash(s));
      else if (d.act === "import") act(() => importPool(s));
      else if (d.act === "mount") act(() => mount(s));
    });

    // The bar sticks to the bottom of the screen: a part of the figure reached with Tab is
    // scrolled above it, never left under it.
    root.addEventListener("focusin", (e) => {
      const el = e.target as Element;
      if (el.closest(".stepbar")) return;
      const top = q(".stepbar").getBoundingClientRect().top;
      const r = el.getBoundingClientRect();
      if (top < innerHeight && r.bottom > top - 8) window.scrollBy({ top: r.bottom - top + 8 });
    });

    render(null);
    q(".zl-bar").hidden = false;
    q(".stepbar").hidden = false;
    q(".zl-log").hidden = false;
  }
</script>

<style>
  .zl {
    margin: var(--space-6) 0 0;
  }
  .zl-bar {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .zl-bar[hidden],
  .zl-log[hidden] {
    display: none;
  }
  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }
  .buttons.actions {
    margin-top: var(--space-2);
  }
  .glabel {
    font-size: var(--step--1);
    color: var(--fg-muted);
    margin-right: var(--space-2);
    min-width: 9.5rem;
  }
  .zl-bar .btn[aria-pressed="true"] {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--fg);
  }
  .zl-bar .btn[aria-pressed="true"]::before {
    content: "✓ ";
    color: var(--accent);
  }
  .zl-bar .btn[disabled],
  .zl-bar .btn[aria-disabled="true"] {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .zl-bar .btn--danger {
    border-color: var(--bad);
    color: var(--bad);
  }
  .panel {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: var(--space-3) var(--space-4);
    min-width: 0;
  }
  .panel h3 {
    margin: 0 0 var(--space-2);
    font-family: var(--font-body);
    letter-spacing: 0;
    font-size: var(--step-0);
    font-weight: 600;
  }
  .panel :global(h4) {
    margin: var(--space-3) 0 var(--space-2);
    font-family: var(--font-body);
    letter-spacing: 0;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--fg-muted);
  }
  .panel :global(h4:first-child) {
    margin-top: 0;
  }
  .panel :global(.none) {
    font-size: var(--step--1);
    color: var(--fg-faint);
    list-style: none;
  }
  .decision :global(.verdict) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    margin-bottom: var(--space-2);
  }
  .decision :global(.verdict .wr) {
    font-size: var(--step-0);
    padding: 2px 8px;
  }
  .decision :global(.for) {
    font-size: var(--step--1);
    color: var(--fg-muted);
  }
  .decision :global(.reasons) {
    margin: 0;
    padding-left: 1.3em;
    display: grid;
    gap: var(--space-1);
    font-size: var(--step--1);
    max-width: 60rem;
  }
  .decision :global(.commit) {
    margin-top: var(--space-2);
    font-size: var(--step--1);
    color: var(--fg-muted);
  }
  .zl :global(.wr) {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    border: 1px solid currentColor;
    border-radius: 3px;
    padding: 0 5px;
    white-space: nowrap;
  }
  .zl :global(.wr.wr-copied) {
    color: var(--ok);
  }
  .zl :global(.wr.wr-need-copy) {
    color: var(--accent);
  }
  .zl :global(.wr.wr-indirect) {
    color: var(--code-function);
  }
  .zl-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .zl-grid .disk {
    grid-column: 1 / -1;
  }
  .app :global(.writes) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }
  .app :global(.w) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    align-items: center;
    border-left: 3px solid var(--line-strong);
    padding-left: var(--space-2);
  }
  .app :global(.wid) {
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  .app :global(.wst) {
    color: var(--fg-muted);
  }
  .app :global(.w.logged) {
    border-left-color: var(--accent);
  }
  .app :global(.w.synced) {
    border-left-color: var(--ok);
  }
  .app :global(.w.replayed) {
    border-left-color: var(--ok);
    background: var(--ok-soft);
  }
  .app :global(.w.lost) {
    border-left-color: var(--bad);
  }
  .app :global(.w.lost .wid) {
    text-decoration: line-through;
    color: var(--bad);
  }
  .app :global(.more) {
    color: var(--fg-muted);
  }
  .zl :global(.tag) {
    font-size: 0.72rem;
    color: var(--fg-muted);
    border: 1px dashed var(--line-strong);
    border-radius: 3px;
    padding: 0 5px;
  }
  .zl :global(.tag.wait) {
    color: var(--accent);
    border-color: var(--accent);
  }
  .mem :global(.itxs),
  .mem :global(.lwbs),
  .mem :global(.recs) {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mem :global(.itxs) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--step--1);
  }
  .mem :global(.itx) {
    border: 1px solid var(--line-strong);
    border-radius: 3px;
    padding: 2px 6px;
    background: var(--surface-2);
    font-variant-numeric: tabular-nums;
  }
  .mem :global(.lwbs) {
    display: grid;
    gap: var(--space-2);
  }
  .mem :global(.lwb) {
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    padding: var(--space-2) var(--space-3);
    background: var(--surface-2);
  }
  .mem :global(.lwb.done) {
    border-color: var(--ok);
  }
  .mem :global(.lh) {
    font-size: var(--step--1);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    align-items: center;
    margin-bottom: var(--space-1);
  }
  .mem :global(.lb) {
    color: var(--fg-muted);
