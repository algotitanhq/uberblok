// The question-first format (DECISIONS.md D21.1, D31.1): the question, a plain
// answer, the figures, then the code in Source notes. Links to the code live in
// the notes only.
const lang = "fr";
const r = room("compression-dedup-encryption");
const Z = "module/zfs/zio.c";
const DDT = "module/zfs/ddt.c";
const SPA = "include/sys/spa.h";
const CRYPT = "module/os/linux/zfs/zio_crypt.c";
const L = {
  execute: gh(Z, 2452, 2454),
  compressData: gh("module/zfs/zio_compress.c", 148, 149),
  bpe: gh(SPA, 356, 357),
  minAlloc: gh("module/zfs/vdev.c", 428, 437),
  gcd: gh("module/zfs/vdev.c", 1523, 1536),
  dedupEmpty: gh("module/zfs/dmu.c", 2465, 2472),
  embed: gh(Z, 2005, 2017),
  embeddedLayout: gh(SPA, 265, 323),
  roundup: gh(Z, 1783, 1789),
  asize: gh("module/zfs/vdev.c", 368, 370),
  holeBirth: gh(Z, 2107, 2115),
  overQuota: gh(DDT, 1136, 1163),
  ddtLookup: gh(DDT, 1374, 1387),
  quotaComment: gh(DDT, 113, 127),
  fill: gh(DDT, 724, 726),
  addref: gh(DDT, 880, 888),
  rewrite: gh(Z, 3971, 3981),
  childWrite: gh(Z, 4110, 4114),
  extend: gh(Z, 3780, 3789),
  key: gh("include/sys/ddt.h", 95, 105),
  value: gh("include/sys/ddt.h", 150, 169),
  log: gh(DDT, 144, 156),
  logFlags: gh(DDT, 303, 310),
  quotaAuto: gh("module/zcommon/zpool_prop.c", 143, 145),
  encodeParams: gh(CRYPT, 751, 773),
  encodeMac: gh(CRYPT, 809, 827),
  iv2: gh(SPA, 531, 538),
  macros: gh(SPA, 452, 470),
  noEmbed: gh(SPA, 320, 322),
  writePolicy: gh("module/zfs/dmu.c", 2523, 2526),
  suites: gh(CRYPT, 39, 40),
  lens: gh("include/sys/zio.h", 129, 131),
  fold: gh("module/zfs/zio_checksum.c", 324, 341),
  scrubRaw: gh("module/zfs/dsl_scan.c", 4841),
  eacces: gh("module/zfs/dsl_crypt.c", 2818, 2823),
  clear: gh(CRYPT, 115, 120),
};
---

<Base
  lang={lang}
  roomId="compression-dedup-encryption"
  title="Qu’arrive-t-il à un bloc compressé, dédupliqué ou chiffré ? · Uberblok"
  description="ZFS ne garde un bloc compressé que s’il gagne un huitième, compté en secteurs entiers ; la déduplication cherche la somme de contrôle de chaque bloc dans une table ; le chiffrement range son sel, son IV et son MAC dans le pointeur de bloc, si bien que le scrub n’a pas besoin de la clé. En interactif, avec le code d’OpenZFS."
>
  <article class="wrap">
    <header class="room-head">
      <p class="kicker">Salle {roomNumber(r.id)} · {r.title.fr}</p>
      <h1>Qu’arrive-t-il à un bloc compressé, dédupliqué ou chiffré ?</h1>
      <div class="prose answer">
        <p class="lead">
          ZFS écrit les fichiers par blocs, de 128 Kio par défaut, et un disque les range en secteurs entiers de
          512 octets ou de 4 Kio. Avant qu’un bloc soit écrit, trois fonctionnalités facultatives agissent sur lui, dans cet
          ordre : la compression, le chiffrement, puis la déduplication. ZFS ne garde un bloc compressé que si cela
          économise au moins un huitième de sa taille, compté en secteurs entiers ; sinon, il le range tel quel. Avec la
          compression active, un bloc de zéros n’est pas écrit du tout, et un bloc qui se compresse en 112 octets ou
          moins peut tenir dans son pointeur de bloc. Un pointeur de bloc est la petite fiche qu’un bloc parent garde pour chaque enfant, avec son adresse, sa taille et sa somme de contrôle.
        </p>
        <p>
          La déduplication évite d’écrire un bloc qui est déjà sur le disque. Quand elle est active, ZFS cherche la
          somme de contrôle de chaque bloc dans une table, la table de déduplication. S’il l’y trouve, le nouveau
          pointeur de bloc prend l’adresse de la copie déjà écrite, un compteur de références augmente, et rien n’est
          écrit. Sinon, le bloc est écrit et une nouvelle entrée note son adresse. Le prix, c’est une recherche à chaque
          écriture, doublon ou non, et une table qui grossit avec les données et qu’il faut tenir à jour sur le disque.
        </p>
        <p>
          Pour chiffrer un bloc, ZFS a besoin d’un sel et d’un vecteur d’initialisation (IV), deux valeurs qui rendent le chiffrement de chaque bloc différent. Il calcule aussi un code d’authentification (MAC), qui prouve que le bloc n’a pas été modifié. ZFS range les trois dans le pointeur de bloc, à la place de l’adresse de la troisième copie et de la moitié de la somme de contrôle, avec quelques bits dans un compteur dont un bloc de données n’a pas besoin. L’autre moitié est une somme de contrôle des octets chiffrés : un scrub peut donc vérifier
          chaque bloc sans la clé.
        </p>
      </div>
    </header>

    <section class="section" aria-labelledby="compress">
      <h2 id="compress"><span class="n">1</span> Compresser un bloc</h2>
      <div class="prose">
        <p>
          La figure suit un bloc à travers les tests du chemin d’écriture. Choisissez les données, la taille du bloc,
          celle du secteur et la compression. La ligne sous les réglages dit ce qui s’est passé, et ce que le choix a
          changé est entouré.
        </p>
        <p>
          Avec des données compressibles, la sortie reste sous la limite, le trait plein à sept huitièmes du bloc
          arrondis au secteur inférieur, et le bloc prend moins de secteurs sur le disque. Des données déjà compressées
          dépassent la limite et le bloc est rangé tel quel. Que des zéros donne un trou, et des données presque vides
          tiennent dans le pointeur de bloc.
        </p>
        <p>
          Choisissez ensuite un bloc de 4 Kio sur des secteurs de 4 Kio. Sept huitièmes d’un secteur, arrondis au
          secteur inférieur, ne font plus rien : le bloc ne reste compressé que s’il tombe à 112 octets ou moins, et il va alors dans son pointeur de bloc. Le tableau sous
          la figure montre les mêmes données pour les trois tailles de secteur.
        </p>
      </div>
      <CompressLab lang={lang} />
    </section>

    <section class="section" aria-labelledby="dedup">
      <h2 id="dedup"><span class="n">2</span> Écrire deux fois le même bloc</h2>
      <div class="prose">
        <p>
          Chaque bouton Écrire écrit un bloc de ce contenu, dans un nouveau groupe de transactions (le lot de modifications que
          ZFS valide à quelques secondes d’intervalle). La figure s’ouvre après trois écritures : A, B, puis de nouveau
          A, qui a été trouvé dans la table.
        </p>
        <p>
          Écrivez C : C n’est pas dans la table, le bloc est donc écrit et la table reçoit une entrée pour sa somme de contrôle.
          Écrivez C une deuxième fois : il est trouvé, le compteur de l’entrée passe à 2 et aucun bloc n’est écrit. Le
          compteur de recherches augmente à chaque écriture.
        </p>
        <p>
          Recommencez, écrivez A, puis activez « Table de déduplication au-dessus de son quota » et écrivez B. B n’obtient pas d’entrée et
          il est écrit comme n’importe quel bloc. Écrivez A : il est encore trouvé dans la table, et encore dédupliqué.
        </p>
      </div>
      <DedupLab lang={lang} />
    </section>

    <section class="section" aria-labelledby="crypt">
      <h2 id="crypt"><span class="n">3</span> Décharger la clé, puis lancer un scrub</h2>
      <div class="prose">
        <p>
          À gauche, les 16 mots d’un pointeur de bloc. Pour un bloc de données chiffré, les mots surlignés sont ceux qui
          diffèrent d’un bloc ordinaire : la troisième adresse, la moitié haute du compteur de remplissage et la
          seconde moitié de la somme de contrôle.
        </p>
        <p>
          À droite, un petit fichier chiffré : son bloc de dnodes, qui décrit le fichier, un bloc indirect qui pointe
          vers les données, et trois blocs de données. Désactivez « Clé chargée » pour décharger la clé : les données s’affichent chiffrées. Lancez un
          scrub : chaque bloc passe encore. Lisez le fichier : la lecture échoue au premier bloc de données, qui ne
          peut pas être déchiffré. Inversez un bit, puis relancez le scrub : le bloc abîmé est repéré, avec ou sans la
          clé.
        </p>
      </div>
      <CryptLab lang={lang} />
    </section>

    <section class="section" aria-labelledby="code">
      <h2 id="code">Dans le code</h2>
      <p class="prose">
        Les figures suivent dix endroits du code d’OpenZFS. Ouvrez une note Source pour voir les lignes, tirées de la
        version zfs-2.4.4.
      </p>

      <div class="step">
        <h3>L’ordre des étapes</h3>
        <p class="prose">
          Chaque étape d’une écriture est un bit, et une écriture parcourt ses étapes du bit le plus bas au plus haut. La compression vient avant le
          chiffrement, et la somme de contrôle est calculée sur les octets qui seront écrits. La recherche de
          déduplication vient ensuite : elle utilise donc la somme de contrôle du bloc compressé et chiffré.
        </p>
        <SourceNote lang={lang}>
          <Fragment slot="label"><code>enum zio_stage</code>, zio_impl.h</Fragment>
          <Excerpt
            lang={lang}
            path="include/sys/zio_impl.h"
            from={135}
            to={144}
            symbol="enum zio_stage"
            notes={[
              { from: 135, to: 138, text: "La compression, puis le chiffrement, puis la somme de contrôle de ce qui sera écrit." },
              { from: 140, text: "Le nop-write, qui saute une écriture dont la nouvelle somme de contrôle est égale à l’ancienne. Les figures le laissent de côté." },
              { from: 142, to: 144, text: `Les étapes de déduplication. Une écriture passe <a href="${L.execute}">au bit suivant présent dans son pipeline</a> : elles viennent donc en dernier.` },
            ]}
          />
        </SourceNote>
      </div>

      <div class="step">
        <h3>La limite</h3>
        <p class="prose">
          Avant de compresser, <code>zio_get_compression_max_size</code> calcule la taille permise pour la sortie :
          sept huitièmes du bloc, arrondis vers le bas à un nombre entier de secteurs. Gagner moins d’un secteur ne sert à rien, puisqu’un bloc occupe des secteurs entiers sur le disque.
        </p>
        <SourceNote lang={lang}>
          <Fragment slot="label"><code>zio_get_compression_max_size</code>, zio.c</Fragment>
          <Excerpt
            lang={lang}
            path={Z}
            from={1797}
            to={1807}
            symbol="zio_get_compression_max_size"
            notes={[
              { from: 1797, to: 1798, text: "Sept huitièmes de la source : au moins 12,5 % doivent être économisés, une « valeur héritée », dit le commentaire." },
              { from: 1800, to: 1802, text: "Pour ZLE, qui ne compresse que les suites de zéros, la limite n’est pas arrondie." },
              { from: 1804, text: `Arrondi vers le bas à un multiple de <code>spa_gcd_alloc</code>, qui, sur un pool de disques simples d’un seul ashift, est <a href="${L.minAlloc}">le secteur</a> (<a href="${L.gcd}">le plus grand commun diviseur des tailles d’allocation des vdevs</a>).` },
              { from: 1806, to: 1807, text: `S’il reste moins d’un secteur, seule une sortie qui tient dans un pointeur de bloc vaut la peine : <code>BPE_PAYLOAD_SIZE</code>, <a href="${L.bpe}">14 mots de 8 octets</a>, 112 octets.` },
            ]}
          />
        </SourceNote>
      </div>

      <div class="step">
        <h3>Des zéros, trop gros, ou assez petit pour le pointeur</h3>
        <p class="prose">
          <code>zio_write_compress</code> cherche d’abord un bloc de zéros, puis lance le compresseur avec la limite
          comme taille de sortie. L’issue dépend de la taille qu’il renvoie.
        </p>
        <SourceNote lang={lang}>
          <Fragment slot="label"><code>zio_write_compress</code>, zio.c</Fragment>
          <Excerpt
            lang={lang}
            path={Z}
            from={1986}
            to={2004}
            symbol="zio_write_compress"
            notes={[
              { from: 1986, to: 1987, text: `Que des zéros : PSIZE 0. Ce test ne tourne qu’avec la compression active. Compression coupée et déduplication active, ZFS <a href="${L.dedupEmpty}">active un mode qui ne détecte que les zéros</a>, car « storing many references to an all zeros block in the dedup table would be expensive » (garder beaucoup de références à un bloc de zéros dans la table coûterait cher).` },
              { from: 1991, to: 1995, text: `Le compresseur reçoit la limite comme taille de sortie ; <a href="${L.compressData}">il renvoie la taille de la source</a> quand sa sortie ne tient pas.` },
              { from: 1996, to: 1997, text: `PSIZE 0 donne un trou : rien n’est alloué. Si le bloc existait déjà, le trou <a href="${L.holeBirth}">garde sa taille et naît dans ce txg</a>, pour qu’un envoi incrémental le voie.` },
              { from: 1998, to: 2001, text: "Rien d’économisé : la compression est coupée pour ce bloc, rangé à sa taille complète." },
              { from: 2002, to: 2004, text: `Au plus 112 octets, non chiffré, au niveau 0, avec <code>embedded_data</code> active : les données sont <a href="${L.embed}">encodées dans le pointeur de bloc</a>, dont <a href="${L.embeddedLayout}">les mots portent alors les données</a>, et l’écriture s’arrête là.` },
            ]}
          />
        </SourceNote>
      </div>

      <div class="step">
        <h3>L’arrondi au secteur</h3>
        <p class="prose">
          Toute autre sortie est arrondie à des secteurs entiers. Si la taille arrondie n’est pas plus petite que le
          bloc, le bloc est finalement rangé non compressé.
        </p>
        <SourceNote lang={lang}>
          <Fragment slot="label"><code>zio_write_compress</code>, l’arrondi, zio.c</Fragment>
          <Excerpt
            lang={lang}
            path={Z}
            from={2027}
            to={2035}
            symbol="zio_write_compress"
            notes={[
              { from: 2027, to: 2028, text: `<code>zio_roundup_alloc_size</code> <a href="${L.roundup}">arrondit à l’allocation minimale, ou au multiple du secteur au-dessus</a>.` },
              { from: 2029, to: 2032, text: "Pas plus petit que le bloc : rangé non compressé. La limite arrondie vers le bas rend ce cas rare ; ZLE, dont la limite n’est pas arrondie, peut l’atteindre, comme une sortie de 112 octets d’un bloc chiffré, qui ne peut pas aller dans le pointeur." },
              { from: 2034, to: 2035, text: `La fin du dernier secteur est mise à zéro et PSIZE est la taille arrondie : la propriété <code>compressratio</code> compte ce remplissage. Sur un seul disque, l’espace alloué est PSIZE <a href="${L.asize}">arrondi au secteur</a>.` },
            ]}
          />
        </SourceNote>
      </div>

      <div class="step">
        <h3>Chercher la somme de contrôle</h3>
        <p class="prose">
          Un bloc d’un dataset avec la déduplication active passe par <code>zio_ddt_write</code>, qui cherche sa somme de
          contrôle dans la table de déduplication. Au-dessus de son quota, la table refuse les nouvelles entrées, et un
          bloc qu’elle n’a jamais vu est écrit normalement.
        </p>
        <SourceNote lang={lang}>
          <Fragment slot="label"><code>zio_ddt_write</code>, la recherche, zio.c</Fragment>
          <Excerpt
            lang={lang}
            path={Z}
            from={3823}
            to={3832}
            symbol="zio_ddt_write"
            notes={[
              { from: 3823, text: `Chaque écriture dédupliquée cherche son pointeur de bloc, par sa somme de contrôle. Une entrée, c’est <a href="${L.key}">une clé de 40 octets</a> et <a href="${L.value}">une valeur de 256 octets, ou de 72 dans le format « flat », plus récent</a>.` },
              { from: 3824, to: 3832, text: `NULL vient de <a href="${L.ddtLookup}"><code>ddt_lookup</code></a> quand la clé n’est dans aucune table et que <a href="${L.overQuota}">la table dépasse son quota</a>. Le bit D est effacé et le bloc suit le chemin d’écriture ordinaire. Une clé trouvée est encore renvoyée : <a href="${L.quotaComment}">seules les nouvelles entrées sont refusées</a>. Le quota par défaut, <code>auto</code>, <a href="${L.quotaAuto}">ne fixe aucune taille</a> et ne plafonne la table que sur un pool doté d’un vdev dedup ou special ; sur un pool de disques simples, la table grandit avec les données.` },
            ]}
          />
        </SourceNote>
      </div>

      <div class="step">
        <h3>Un bloc trouvé n’écrit rien</h3>
        <p class="prose">
          Quand l’entrée contient déjà une adresse, le nouveau pointeur de bloc est rempli à partir d’elle et le compteur de références augmente. La naissance logique du nouveau pointeur est le groupe de transactions en cours, et sa naissance
          physique celui où les données ont été écrites : c’est pourquoi la figure affiche « né au txg 102, physique
          100 ».
        </p>
        <SourceNote lang={lang}>
          <Fragment slot="label"><code>zio_ddt_write</code>, bloc trouvé, zio.c</Fragment>
          <Excerpt
            lang={lang}
            path={Z}
            from={3983}
            to={3986}
            symbol="zio_ddt_write"
            notes={[
              { from: 3983, text: `<code>ddt_bp_fill</code> copie les adresses de l’entrée dans le nouveau pointeur de bloc, <a href="${L.fill}">avec le txg en cours comme naissance logique et celui de l’entrée comme naissance physique</a>. Une réécriture <a href="${L.rewrite}">remplit d’abord le pointeur avec son txg de naissance d’origine</a>, et ne fait rien si cela donne le même pointeur de bloc.` },
              { from: 3984, text: `<a href="${L.addref}"><code>ddt_phys_addref</code></a> ajoute une référence.` },
              { from: 3985, to: 3986, text: "La fonction rend la main sans aucune E/S d’écriture." },
            ]}
          />
        </SourceNote>
      </div>

      <div class="step">
        <h3>Un bloc absent est écrit, et son entrée remplie</h3>
        <p class="prose">
          Une nouvelle entrée n’a pas encore d’adresse. Le bloc est écrit par une E/S enfant, et quand cette écriture a
          son adresse, l’adresse est copiée dans l’entrée pour la prochaine fois.
        </p>
        <SourceNote lang={lang}>
          <Fragment slot="label"><code>zio_ddt_write</code>, bloc absent, zio.c</Fragment>
          <Excerpt
            lang={lang}
            path={Z}
            from={4161}
            to={4165}
            symbol="zio_ddt_write"
            notes={[
              { from: 4161, text: "Le compteur de la nouvelle entrée passe de 0 à 1 dès maintenant, avant la fin de l’écriture ; c’est annulé si l’écriture échoue." },
              { from: 4165, text: `L’<a href="${L.childWrite}">écriture enfant</a> part ; quand elle a son adresse, <a href="${L.extend}"><code>zio_ddt_child_write_ready</code> la copie dans l’entrée</a>.` },
            ]}
          />
        </SourceNote>
      </div>

      <div class="step">
        <h3>Garder la table sur le disque</h3>
        <p class="prose">
          Les entrées modifiées pendant un groupe de transactions doivent rejoindre la table sur le disque, rangée sous
          forme d’objets ZAP. Un commentaire de <code>ddt.c</code> explique pourquoi cela coûtait cher. La
          fonctionnalité <code>fast_dedup</code> ajoute un journal pour cela, et la propriété
          <code>dedup_table_quota</code> peut plafonner la taille de la table.
        </p>
        <SourceNote lang={lang}>
          <Fragment slot="label">Le journal de déduplication, ddt.c</Fragment>
          <Excerpt
            lang={lang}
            path={DDT}
            from={138}
            to={142}
            symbol="DDT: the dedup log"
            notes={[
              { from: 138, to: 142, text: `Sans le journal, chaque entrée modifiée était réécrite à la fin de son txg : toute la feuille de ZAP lue, une entrée mise à jour, la feuille réécrite. Avec <code>fast_dedup</code>, les entrées modifiées sont <a href="${L.log}">ajoutées à un journal puis vidées vers le ZAP un peu à chaque txg</a> ; seules les tables créées avec cette fonctionnalité <a href="${L.logFlags}">reçoivent le journal</a>.` },
            ]}
          />
        </SourceNote>
      </div>

      <div class="step">
        <h3>Où vont les valeurs du chiffrement</h3>
        <p class="prose">
          Un commentaire de <code>spa.h</code> décrit le pointeur d’un bloc chiffré. Le MAC prend la moitié de la somme
          de contrôle, le sel et le début de l’IV prennent la troisième adresse, et la fin de l’IV prend la moitié haute
          du compteur de remplissage.
        </p>
        <SourceNote lang={lang}>
          <Fragment slot="label"><code>blkptr_t</code>, chiffré, spa.h</Fragment>
          <Excerpt
            lang={lang}
            path={SPA}
            from={250}
            to={257}
            symbol="blkptr_t, chiffré"
            notes={[
              { from: 250, to: 254, text: `Le MAC prend la seconde moitié de la somme de contrôle (<a href="${L.encodeMac}"><code>zio_crypt_encode_mac_bp</code></a>) ; la première moitié détecte encore les dégâts, avec ou sans clé.` },
              { from: 254, to: 256, text: `Le sel et les 64 premiers bits de l’IV dans la troisième adresse (<a href="${L.encodeParams}"><code>zio_crypt_encode_params_bp</code></a>) : un bloc chiffré <a href="${L.writePolicy}">garde donc au plus deux copies</a>. Un pointeur de bloc qui porte des données <a href="${L.noEmbed}">ne peut pas être chiffré</a> : il n’a plus de mots libres.` },
              { from: 256, to: 257, text: `Les 32 derniers bits de l’IV dans <a href="${L.iv2}">la moitié haute du compteur de remplissage</a>. Le même bit X <a href="${L.macros}">marque trois sortes de blocs</a> : chiffré, seulement authentifié, ou bloc indirect qui porte une somme de contrôle des MAC du dessous. Le chiffrement est <a href="${L.suites}">AES-GCM ou AES-CCM</a>, avec <a href="${L.lens}">un sel de 8 octets, un IV de 12 octets et un MAC de 16 octets</a>.` },
            ]}
          />
        </SourceNote>
      </div>

      <div class="step">
        <h3>Un scrub sans la clé</h3>
        <p class="prose">
          Quand elle vérifie un bloc qui utilise le chiffrement, <code>zio_checksum_error_impl</code> ne compare que la
          première moitié de la somme de contrôle. Le scrub lit les blocs sans les déchiffrer : cette comparaison lui
          suffit, et elle marche avec la clé déchargée.
        </p>
        <SourceNote lang={lang}>
          <Fragment slot="label"><code>zio_checksum_error_impl</code>, zio_checksum.c</Fragment>
          <Excerpt
            lang={lang}
            path="module/zfs/zio_checksum.c"
            from={515}
            to={525}
            symbol="zio_checksum_error_impl"
            notes={[
              { from: 515, to: 516, text: "Un pointeur de bloc qui utilise le chiffrement, sauf un bloc d’objset, qui porte ses MAC en lui-même." },
              { from: 517, to: 520, text: `Pour une somme de contrôle qui n’est pas faite pour la déduplication (fletcher-4, par exemple), les mots 2 et 3 sont repliés dans 0 et 1, <a href="${L.fold}">comme l’a fait l’écriture</a>.` },
              { from: 522, to: 525, text: `Les mots du MAC sont ignorés des deux côtés ; le déchiffrement vérifie le MAC. Le scrub lit <a href="${L.scrubRaw}">en brut</a> et s’arrête donc ici ; une lecture qui doit déchiffrer <a href="${L.eacces}">échoue avec <code>EACCES</code></a> quand la clé n’est pas chargée. Le cœur du dnode <a href="${L.clear}">reste en clair</a> pour la même raison.` },
            ]}
          />
        </SourceNote>
      </div>
      <SourcePanel lang={lang} />
    </section>

    <section class="section simplified" aria-labelledby="simplified">
      <h2 id="simplified">Ce que les figures laissent de côté</h2>
      <div class="prose muted">
        <p>
          La sortie du compresseur est une donnée de la figure, pas le calcul d’un vrai compresseur, et les choix
          proposés sont des exemples. LZ4 représente tous les compresseurs sauf ZLE, puisqu’ils suivent tous la même
          limite. Les niveaux de compression sont laissés de côté, comme la règle qui arrête de compresser les
          réécritures à partir de la huitième passe de synchronisation. Le pool est fait de disques simples d’un seul
          ashift, où l’allocation minimale et le secteur sont égaux ; le RAID-Z et les pools mixtes ne sont pas montrés.
        </p>
        <p>
          La figure de déduplication écrit un bloc par groupe de transactions, en une seule copie, à des adresses
          inventées. La vérification octet par octet (<code>dedup=verify</code>), les collisions de sommes de contrôle,
          les copies supplémentaires et l’élagage, qui retire les vieilles entrées jamais dupliquées, sont laissés de côté ; le journal de déduplication est seulement décrit, plus haut, dans « Dans le code ». Le scrub parcourt d’abord la table de déduplication, si bien qu’un
          bloc référencé de nombreuses fois n’est vérifié qu’une fois. Le code ne donne aucun chiffre de mémoire par
          téraoctet ni de taux de déduplication : les deux dépendent des données.
        </p>
        <p>
          Le texte chiffré, le sel, l’IV et le MAC de la figure de chiffrement sont des substituts, pas de l’AES ; la
          somme de contrôle est un fletcher-4 des octets de la figure. La clé qui chiffre les données est une clé
          maîtresse aléatoire, rangée sur le disque chiffrée par la clé de l’utilisateur : changer de phrase secrète ne
          rechiffre aucune donnée, et instantanés et clones partagent cette clé. Avec la déduplication, le sel et l’IV
          viennent des données au lieu d’être aléatoires, si bien que des blocs chiffrés ne sont dédupliqués qu’au sein
          d’un même dataset et de ses clones. La rotation de clé, qui prend un nouveau sel après 400 millions de blocs,
          et le chiffrement du journal d’intention sont laissés de côté. La suite du trajet d’un bloc est dans
          <a href={roomUrl(lang, "metaslabs")}>Metaslabs et space maps</a> ; un envoi incrémental choisit les blocs
          par leur naissance logique, si bien qu’un bloc dédupliqué après un instantané est encore envoyé, comme le
          montre <a href={roomUrl(lang, "send-receive")}>send / receive</a>.
        </p>
      </div>
    </section>
