import RoomNav from "../../components/RoomNav.astro";
import { gh } from "../../lib/openzfs";
import { room, roomUrl, roomNumber } from "../../lib/rooms";

// The question-first format (DECISIONS.md D21.1, D29.1): the question, a plain
// answer, the figure, then the code in Source notes. Links to the code live in
// the notes only.
const lang = "fr";
const r = room("send-receive");
const TR = "module/zfs/dmu_traverse.c";
const SEND = "module/zfs/dmu_send.c";
const RECV = "module/zfs/dmu_recv.c";
const L = {
  fromtxg: gh(SEND, 2370),
  minTxg: gh(TR, 653),
  flags: gh(SEND, 2088),
  getBirth: gh(TR, 78, 84),
  birthComment: gh("include/sys/spa.h", 483, 488),
  holesDefault: gh(TR, 44),
  zeroHoles: gh(TR, 249, 276),
  holeFile: gh(SEND, 1018, 1034),
  holeMeta: gh(SEND, 1012, 1017),
  dumpFree: gh(SEND, 367, 403),
  dnodeRange: gh(SEND, 1098, 1108),
  dnodeLoop: gh(TR, 534, 543),
  overlay: gh("include/sys/zfs_ioctl.h", 374, 387),
  payloadSum: gh(SEND, 295, 298),
  end: gh(SEND, 2619, 2626),
  recvBegin: gh(RECV, 1304, 1306),
  recvSum: gh(RECV, 2849, 2851),
  queue: gh(RECV, 3500, 3513),
  endCheck: gh(RECV, 3000, 3007),
  cleanup: gh(RECV, 3582, 3588),
  loop: gh(RECV, 463, 464),
  guids: gh(SEND, 2049, 2050),
};
---

<Base
  lang={lang}
  roomId="send-receive"
  title="Comment ZFS n’envoie-t-il que ce qui a changé ? send / receive · Uberblok"
  description="zfs send trouve ce qui a changé entre deux instantanés grâce au txg de naissance de chaque bloc, saute sans les lire les sous-arbres inchangés et écrit un flux dont le récepteur vérifie chaque enregistrement avant de l’appliquer. En interactif, avec le code d’OpenZFS."
>
  <article class="wrap">
    <header class="room-head">
      <p class="kicker">Salle {roomNumber(r.id)} · {r.title.fr}</p>
      <h1>Comment ZFS n’envoie-t-il que ce qui a changé ?</h1>
      <div class="prose answer">
        <p class="lead">
          Pour garder la copie d’un système de fichiers sur une autre machine, un outil qui travaille fichier par fichier, comme rsync, doit trouver ce qui a changé depuis la dernière copie. Il liste ou lit chaque fichier des deux côtés, à chaque fois, et il ne voit un changement qu’à travers les dates, les tailles ou les contenus qu’il compare. Sur un gros système de fichiers où peu de choses ont changé, presque tout ce travail ne trouve rien.
        </p>
        <p>
          ZFS ne compare pas les fichiers. Chaque pointeur vers un bloc note le groupe de transactions, ou txg, dans lequel le bloc a été écrit. Un txg est un lot de modifications écrites ensemble sur le disque, et son numéro ne fait que croître. Un instantané pris au txg F ne contient aucun bloc écrit après F : ce qui a changé entre deux instantanés, ce sont donc les blocs du plus récent écrits après le txg du plus ancien. Quand ZFS modifie un bloc, il écrit aussi une nouvelle copie de chaque bloc au-dessus, jusqu’à la racine. Un bloc dont le txg est ancien n’a donc rien de nouveau en dessous de lui. Un envoi incrémental parcourt l’instantané le plus récent depuis le haut et saute chaque bloc plus ancien que F, avec tout ce qu’il y a en dessous, sans le lire.
        </p>
        <p>
          Ce que le parcours trouve devient un flux d’enregistrements : un WRITE pour chaque bloc de données, un FREE pour chaque plage vidée, un OBJECT pour chaque fichier. Chaque enregistrement porte une somme de contrôle de tout le flux qui le précède, et le côté réception la vérifie avant d’appliquer l’enregistrement. Un flux abîmé en route s’arrête au premier enregistrement fautif, et la réception est défaite. Un flux incrémental nomme aussi l’instantané dont il part, et le récepteur le refuse s’il ne détient pas cet instantané.
        </p>
      </div>
    </header>

    <section class="section" aria-labelledby="lab">
      <h2 id="lab"><span class="n">1</span> Envoyer @s4, depuis l’instantané de votre choix</h2>
      <div class="prose">
        <p>
          Le système de fichiers <code>tank/fs</code> a quatre instantanés, pris aux txg 10, 20, 30 et 40 (l’histoire au-dessus de l’arbre dit ce que chaque txg a changé). La figure envoie le dernier, <code>@s4</code>. À gauche se trouve son arbre, chaque pointeur de bloc avec le txg de naissance de son bloc. Au milieu, le flux, et à droite, le côté réception.
        </p>
        <p>
          Choisissez d’abord Aucun, pour un flux complet, et appuyez plusieurs fois sur Étape suivante. F vaut 0 : chaque pointeur est visité et chaque bloc part, soit 21 enregistrements et 11 672 octets. Choisissez ensuite <code>@s3</code>, que le récepteur détient déjà, et avancez de nouveau. Un pointeur né au txg 30 ou avant passe en pointillés, les blocs en dessous pâlissent, et ils ne sont jamais lus : 7 enregistrements, 2 184 octets. Chaque étape encadre ce qu’elle a fait : d’abord le pointeur testé et les enregistrements écrits, puis l’enregistrement que le récepteur a vérifié et les blocs que cet enregistrement a changés. Inversez un bit pour abîmer le flux en route : le récepteur s’arrête à l’en-tête suivant.
        </p>
      </div>
      <SendLab lang={lang} />
    </section>

    <section class="section" aria-labelledby="code">
      <h2 id="code">Dans le code</h2>
      <p class="prose">
        La figure suit six endroits de <code>dmu_send.c</code>, <code>dmu_traverse.c</code> et <code>dmu_recv.c</code>. Ouvrez une note Source pour voir les lignes, tirées de la version zfs-2.4.4.
      </p>

      <div class="step">
        <h3>Là où le parcours commence</h3>
        <p class="prose">
          <code>send_traverse_thread</code> lance le parcours de l’instantané envoyé. Sa borne basse est <code>fromtxg</code>, le txg où l’instantané de départ a été pris, ou 0 pour un flux complet. La figure l’appelle F.
        </p>
        <SourceNote lang={lang}>
          <Fragment slot="label"><code>send_traverse_thread</code>, dmu_send.c</Fragment>
          <Excerpt
            lang={lang}
            path={SEND}
            from={1211}
            to={1213}
            symbol="send_traverse_thread"
            notes={[
              {
                from: 1211,
                to: 1212,
                text: `<code>fromtxg</code> est <a href="${L.fromtxg}">le txg de création de l’instantané de départ</a>, 0 pour un flux complet. Dans le parcours, il devient <a href="${L.minTxg}"><code>td_min_txg</code></a>.`,
              },
              {
                from: 1213,
                text: `<code>TRAVERSE_LOGICAL</code> s’ajoute <a href="${L.flags}">aux drapeaux de l’envoi</a>, et chaque bloc que le parcours visite passe par <code>send_cb</code>.`,
              },
            ]}
          />
        </SourceNote>
      </div>

      <div class="step">
        <h3>Le test qui saute un sous-arbre</h3>
        <p class="prose">
          <code>traverse_visitbp</code> s’exécute pour chaque pointeur de bloc que le parcours atteint, et une seule comparaison décide. Un bloc né à la borne ou avant était déjà dans l’instantané de départ. La fonction rend la main sans le lire, et rien de ce qui est en dessous n’est atteint non plus. C’est sûr parce que la <a href={roomUrl(lang, "copy-on-write")}>copie sur écriture</a> donne une nouvelle naissance à chaque bloc au-dessus d’un changement.
        </p>
        <SourceNote lang={lang}>
          <Fragment slot="label"><code>traverse_visitbp</code>, dmu_traverse.c</Fragment>
          <Excerpt
            lang={lang}
            path={TR}
            from={277}
            to={279}
            symbol="traverse_visitbp"
            notes={[
              {
                from: 277,
                text: `Avec <code>TRAVERSE_LOGICAL</code>, <code>get_birth_time</code> <a href="${L.getBirth}">rend la naissance logique</a>, le txg où les données ont été écrites. <a href="${L.birthComment}">Le commentaire qui définit les deux naissances</a> dit que la naissance physique diffère pour la déduplication, le clonage de blocs et les blocs réécrits, et que la logique est celle de la réplication incrémentale.`,
              },
              {
                from: 278,
                text: `Rendre la main ici saute le bloc et tout son sous-arbre : dans la figure, le pointeur passe en pointillés et ce qui est en dessous pâlit. Un trou de naissance 0 prend <a href="${L.zeroHoles}">la branche du dessus</a> et il est visité, car <code>send_holes_without_birth_time</code> vaut <a href="${L.holesDefault}">1 par défaut</a>.`,
              },
            ]}
          />
        </SourceNote>
      </div>

      <div class="step">
        <h3>Des blocs aux enregistrements</h3>
        <p class="prose">
          <code>send_cb</code> reçoit chaque bloc que le parcours visite. Un bloc de données devient un WRITE, un trou devient un FREE. Dans un bloc de dnodes visité, le dnode de chaque fichier (l’enregistrement qui décrit le fichier) devient un OBJECT, qu’il ait changé ou non, et chaque emplacement vide devient FREEOBJECTS. C’est pourquoi envoyer <code>@s4</code> depuis <code>@s3</code> envoie encore des OBJECT pour a et b : supprimer c a réécrit le bloc de dnodes que les trois fichiers partagent.
        </p>
        <SourceNote lang={lang}>
          <Fragment slot="label"><code>send_cb</code>, dmu_send.c</Fragment>
          <Excerpt
            lang={lang}
            path={SEND}
            from={1140}
            to={1146}
            symbol="send_cb"
            notes={[
              {
                from: 1140,
                to: 1142,
                text: `Un trou s’écrit en <a href="${L.holeFile}">FREE de sa plage</a>, ou, parmi les blocs de dnodes, en <a href="${L.holeMeta}">FREEOBJECTS</a>. <a href="${L.dumpFree}"><code>dump_free</code></a> fusionne un FREE dans le précédent quand il le prolonge : c’est pourquoi les deux trous de b partent en un seul enregistrement.`,
              },
              {
                from: 1143,
                to: 1146,
                text: `Un bloc de données devient un WRITE avec ses données ; REDACT sert aux envois expurgés. Un dnode devient un OBJECT <a href="${L.dnodeRange}">quelques lignes plus haut</a>, et <a href="${L.dnodeLoop}">chaque dnode d’un bloc de dnodes visité</a> arrive jusqu’à cette fonction.`,
              },
            ]}
          />
        </SourceNote>
      </div>

      <div class="step">
        <h3>Une somme de contrôle qui court le long du flux</h3>
        <p class="prose">
          <code>dump_record</code> écrit l’en-tête de chaque enregistrement. Juste avant, il prolonge une somme fletcher-4 courante sur l’en-tête et range sa valeur dans les 32 derniers octets de l’en-tête. La valeur de chaque enregistrement couvre donc chaque octet du flux qui le précède.
        </p>
        <SourceNote lang={lang}>
          <Fragment slot="label"><code>dump_record</code>, dmu_send.c</Fragment>
          <Excerpt
            lang={lang}
            path={SEND}
            from={268}
            to={283}
            symbol="dump_record"
            notes={[
              { from: 268, to: 270, text: "La somme courante est prolongée sur l’en-tête, jusqu’à ses 32 derniers octets." },
              {
                from: 271,
                to: 277,
                text: `Sauf pour BEGIN, la somme va dans ces 32 octets, <code>drr_checksum</code>, que <a href="${L.overlay}">chaque type d’enregistrement a au même endroit</a>.`,
              },
              {
                from: 281,
                to: 283,
                text: `Puis les 32 octets sont ajoutés à la somme, et <a href="${L.payloadSum}">la charge utile</a> qui les suit. END porte <a href="${L.end}">la somme de tout le flux</a>. La figure montre les 32 bits de poids faible de chaque valeur.`,
              },
            ]}
          />
        </SourceNote>
      </div>

      <div class="step">
        <h3>Le récepteur vérifie avant d’appliquer</h3>
        <p class="prose">
          <code>receive_read_payload_and_next_header</code> tient la même somme courante côté réception et la compare à chaque en-tête qui arrive. Un enregistrement ne part vers l’écriture qu’une fois vérifié l’en-tête qui le suit : un enregistrement dont les octets ont été abîmés n’est jamais appliqué.
        </p>
        <SourceNote lang={lang}>
          <Fragment slot="label"><code>receive_read_payload_and_next_header</code>, dmu_recv.c</Fragment>
          <Excerpt
            lang={lang}
            path={RECV}
            from={2861}
            to={2868}
            symbol="receive_read_payload_and_next_header"
            notes={[
              {
                from: 2861,
                to: 2866,
                text: `<code>drc_cksum</code> est la somme du récepteur : elle <a href="${L.recvBegin}">part de BEGIN</a> et vient d’être prolongée <a href="${L.recvSum}">sur cet en-tête</a>. Une différence arrête la réception avec <code>ECKSUM</code>. Une somme entièrement nulle n’est pas vérifiée.`,
              },
              {
                from: 2868,
                text: `La valeur rangée est ajoutée à la somme, comme l’a fait l’émetteur. Alors seulement, l’enregistrement qui précède est <a href="${L.queue}">mis en file pour l’écriture</a>. END est <a href="${L.endCheck}">vérifié une fois de plus</a>, et sur une erreur <a href="${L.cleanup}">ce que la réception a créé est détruit</a>.`,
              },
            ]}
          />
        </SourceNote>
      </div>

      <div class="step">
        <h3>Un flux pour un instantané que le récepteur n’a pas</h3>
        <p class="prose">
          Un flux incrémental n’a de sens qu’au-dessus de l’instantané dont il part. Son premier enregistrement nomme cet instantané par son GUID, un numéro propre à chaque instantané. <code>recv_begin_check_existing_impl</code> le cherche parmi les instantanés du système de fichiers qui reçoit, avant que rien ne soit écrit.
        </p>
        <SourceNote lang={lang}>
          <Fragment slot="label"><code>recv_begin_check_existing_impl</code>, dmu_recv.c</Fragment>
          <Excerpt
            lang={lang}
            path={RECV}
            from={473}
            to={479}
            symbol="recv_begin_check_existing_impl"
            notes={[
              {
                from: 473,
                to: 477,
                text: `<a href="${L.loop}">La boucle</a> va de l’instantané le plus récent aux plus anciens, jusqu’à celui qui a le <code>fromguid</code> du flux, que l’émetteur <a href="${L.guids}">a écrit dans BEGIN</a>.`,
              },
              { from: 478, to: 479, text: "Aucun ne l’a : <code>ENODEV</code>, et rien n’est reçu." },
            ]}
          />
        </SourceNote>
      </div>
      <SourcePanel lang={lang} />
    </section>

    <section class="section simplified" aria-labelledby="simplified">
      <h2 id="simplified">Ce que la figure laisse de côté</h2>
      <p class="prose muted">
        La figure est petite : des fichiers de quatre blocs de 512 octets sous un bloc indirect, des blocs de quatre dnodes (un vrai bloc de dnodes de 16 Kio en contient 32), un meta-dnode dessiné avec ses deux blocs de dnodes, pas de tampon bonus. L’envoi s’y déroule d’une traite là où le code relie plusieurs fils (parcours, fusion, lecture, fil principal) par des files qui gardent l’ordre, et le récepteur démarre une fois le flux complet, là où le code reçoit par un tube au fil de l’écriture. Les en-têtes suivent la disposition de <code>dmu_replay_record_t</code>, seuls les champs utilisés par la figure étant remplis, et le récepteur applique chaque enregistrement comme <code>receive_process_record</code> le distribue, selon son type. Les flux expurgés, bruts (chiffrés), compressés et reprenables, les données embarquées, WRITE_BYREF et les blocs spill ne sont pas montrés, pas plus que des débits, qui dépendent des disques et du réseau, pas de ce code.
      </p>
    </section>
  </article>
  <RoomNav lang={lang} roomId="send-receive" />
</Base>

