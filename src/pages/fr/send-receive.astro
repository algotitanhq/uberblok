import SendLab from "../../components/SendLab.astro";
import Excerpt from "../../components/Excerpt.astro";
import RoomNav from "../../components/RoomNav.astro";
import { gh } from "../../lib/openzfs";
import { room, roomUrl, roomNumber } from "../../lib/rooms";

const lang = "fr";
const r = room("send-receive");
const TR = "module/zfs/dmu_traverse.c";
const SEND = "module/zfs/dmu_send.c";
const RECV = "module/zfs/dmu_recv.c";
const IOC = "include/sys/zfs_ioctl.h";
const L = {
  record: gh(IOC, 246, 259),
  types: gh(IOC, 247, 252),
  begin: gh(IOC, 235, 244),
  magic: gh(IOC, 171),
  overlay: gh(IOC, 374, 387),
  size: gh(SEND, 266, 267),
  logical: gh(TR, 80, 81),
  getBirth: gh(TR, 78, 84),
  birthComment: gh("include/sys/spa.h", 483, 488),
  minTxg: gh(TR, 653),
  holesDefault: gh(TR, 44),
  fromtxg: gh(SEND, 2370),
  flags: gh(SEND, 2088),
  doDump: gh(SEND, 2568, 2574),
  dnodeLoop: gh(TR, 402, 404),
  objectRange: gh(SEND, 894, 898),
  dumpDnode: gh(SEND, 732, 742),
  bonus: gh(SEND, 793),
  freeEnd: gh(SEND, 796, 799),
  dumpFree: gh(SEND, 367, 403),
  freeAtOnce: gh(SEND, 396, 398),
  writeFlush: gh(SEND, 482, 486),
  freeobjMerge: gh(SEND, 683, 698),
  maxobj: gh(SEND, 653, 666),
  holeMeta: gh(SEND, 1012, 1017),
  holeFile: gh(SEND, 1018, 1034),
  fullFrees: gh(SEND, 326, 328),
  payloadSum: gh(SEND, 295, 298),
  end: gh(SEND, 2619, 2626),
  guids: gh(SEND, 2049, 2050),
  enodev: gh(RECV, 463, 479),
  recvBegin: gh(RECV, 1304, 1306),
  recvPayload: gh(RECV, 2813),
  queue: gh(RECV, 3500, 3513),
  endCheck: gh(RECV, 3000, 3007),
  cleanup: gh(RECV, 3582, 3588),
  writer: gh(RECV, 3285, 3294),
  recvObject: gh(RECV, 1968, 1989),
  recvFreeobjects: gh(RECV, 2208, 2215),
  recvFree: gh(RECV, 2666, 2684),
  recvFreeCase: gh(RECV, 3235, 3240),
};
---

<Base
  lang={lang}
  roomId="send-receive"
  title="send / receive · Uberblok"
  description="Comment zfs send trouve la différence entre deux instantanés par les seuls txg de naissance, saute d’un coup les sous-arbres inchangés et l’écrit en un flux qui se vérifie lui-même. Interactif, avec le code d’OpenZFS."
>
  <article class="wrap">
    <header class="room-head">
      <p class="kicker">Salle {roomNumber(r.id)}</p>
      <h1>{r.title.fr}</h1>
      <div class="prose problem">
        <p class="lead">
          Garder une copie d’un système de fichiers sur une autre machine semble simple : comparer les deux côtés et
          copier ce qui diffère. Mais comparer, c’est lire. Pour trouver les quelques blocs modifiés depuis la veille, un
          outil qui procède fichier par fichier lit, ou au moins liste, chaque fichier des deux côtés, à chaque fois, et ne
          voit un changement qu’à travers les contenus qu’il compare ou les dates et tailles auxquelles il se fie.
        </p>
        <p>
          ZFS ne compare pas. Chaque pointeur de bloc garde le txg où son bloc est né, et un instantané pris au txg F ne
          contient aucun bloc né après F. La différence entre deux instantanés, ce sont donc les blocs du plus récent nés
          après le txg du plus ancien. La copie sur écriture réécrit chaque bloc au-dessus d’un bloc modifié : un
          sous-arbre dont la racine est ancienne n’a pas changé en dessous, et une seule comparaison à son sommet le saute
          en entier, sans le lire. Ce que le parcours trouve devient un <em>flux</em> d’enregistrements, chacun, sauf le
          premier, portant une somme de contrôle de tout ce qui le précède, que le côté réception vérifie enregistrement
          par enregistrement, avant d’appliquer chacun.
        </p>
      </div>
    </header>

    <section class="section" aria-labelledby="lab">
      <h2 id="lab"><span class="n">1</span> Envoyer @s4, depuis l’instantané de votre choix</h2>
      <div class="prose">
        <p>
          <code>tank/fs</code> a quatre instantanés, un par txg de son histoire. La figure envoie le dernier,
          <code>@s4</code> : son arbre, chaque pointeur de bloc avec son txg de naissance logique. Choisissez
          l’instantané de départ que le récepteur détient déjà, ou aucun pour un flux complet, puis déroulez l’envoi pas à
          pas : à chaque pointeur de bloc, la naissance est comparée à F, le txg de l’instantané de départ, les
          enregistrements tombent dans le flux avec leur somme de contrôle, et le récepteur les vérifie et les applique
          jusqu’à ce que ses fichiers soient ceux de <code>@s4</code>. « Inverser un bit » abîme le flux en route.
        </p>
      </div>
      <SendLab lang={lang} />
    </section>

    <section class="section" aria-labelledby="depths">
      <h2 id="depths">L’idée, à trois profondeurs</h2>

      <div class="depth">
        <h3>En une phrase</h3>
        <p class="lead prose">
          Un envoi incrémental parcourt l’arbre de l’instantané le plus récent et saute chaque pointeur de bloc né au txg
          du plus ancien ou avant, avec tout ce qui est en dessous, puis écrit le reste en un flux d’enregistrements dont
          le récepteur vérifie la somme de contrôle courante avant de les rejouer.
        </p>
      </div>

      <div class="depth">
        <h3>En un paragraphe</h3>
        <p class="prose">
          <code>zfs send -i @from @to</code> parcourt l’arbre de <code>@to</code> avec une borne basse, F, le txg où
          <code>@from</code> a été créé. Un pointeur de bloc né à F ou avant était déjà dans <code>@from</code>, et tout le
          sous-arbre en dessous aussi, puisque la <a href={roomUrl(lang, "copy-on-write")}>copie sur écriture</a> donne une
          nouvelle naissance à chaque bloc au-dessus d’une modification : le parcours s’arrête là, sans le lire. Tout ce qu’il
          visite devient des enregistrements : un OBJECT pour chaque dnode rencontré, un WRITE pour chaque bloc de données,
          un FREE pour chaque trou, un FREEOBJECTS pour chaque emplacement de dnode vide. Le flux commence par BEGIN, qui
          nomme les deux instantanés par leur GUID, et finit par END. Chaque enregistrement sauf BEGIN porte la somme
          fletcher-4 de tous les octets du flux jusqu’à cette somme ; le récepteur tient la même somme et refuse le flux au
          premier en-tête en désaccord, avant d’appliquer l’enregistrement qu’il suit. Sans instantané de départ, F vaut 0,
          tous les blocs sont visités et le flux reconstruit le système de fichiers entier.
        </p>
      </div>

      <div class="depth">
        <h3>En détail</h3>
        <div class="prose">
          <p>
            <strong>Un flux d’enregistrements.</strong> Un flux d’envoi est une suite de
            <a href={L.record}><code>dmu_replay_record_t</code></a>, chacun un en-tête de 312 octets d’<a href={L.types}>un
            des onze types</a>, parfois suivi d’une charge utile : les données d’un WRITE suivent son en-tête. BEGIN porte
            le nombre magique <a href={L.magic}><code>0x2F5bacbacULL</code></a>, <a href={L.begin}>le GUID de l’instantané
            envoyé et celui de l’instantané de départ</a>.
          </p>
          <p><strong>La borne.</strong> Le parcours qui alimente un envoi commence ici.</p>
        </div>
        <Excerpt
          lang={lang}
          path={SEND}
          from={1203}
          to={1221}
          symbol="send_traverse_thread"
          notes={[
            {
              from: 1211,
              to: 1213,
              text: `Le dataset est parcouru depuis <code>fromtxg</code>, le <a href="${L.fromtxg}">txg de création</a> de l’instantané de départ, 0 pour un flux complet. <code>TRAVERSE_LOGICAL</code> rejoint les <a href="${L.flags}">drapeaux de l’envoi</a>, dont <code>TRAVERSE_PRE</code> : le rappel d’un bloc passe avant ses enfants.`,
            },
            {
              from: 1217,
              to: 1218,
              text: `Un marqueur de fin de flux suit la dernière plage. Les plages que <code>send_cb</code> met en file rejoignent le fil principal par d’autres files, dans l’ordre, et <a href="${L.doDump}">y deviennent des enregistrements</a>.`,
            },
          ]}
        />
        <div class="prose after">
          <p><strong>Le test qui saute un sous-arbre.</strong> Chaque pointeur de bloc de l’instantané y passe.</p>
        </div>
        <Excerpt
          lang={lang}
          path={TR}
          from={249}
          to={279}
          symbol="traverse_visitbp"
          notes={[
            {
              from: 249,
              to: 276,
              text: `Un trou de naissance 0 n’a jamais été écrit, ou date d’avant la fonctionnalité <code>hole_birth</code>. Ces lignes le sauteraient dans certains cas, mais seulement si <code>send_holes_without_birth_time</code> vaut 0, et il vaut <a href="${L.holesDefault}">1 par défaut</a> : ces trous sont visités. La figure n’en a pas ; un trou percé dans b porte le txg de la libération, et passe par le test ci-dessous.`,
            },
            {
              from: 277,
              to: 278,
              text: `La règle. <code>td_min_txg</code> est <a href="${L.minTxg}">la borne</a>, F. Né à F ou avant, le bloc est dans l’instantané de départ : la fonction retourne avant de le lire ou d’appeler le rappel, et rien en dessous n’est atteint. Dans la figure, la puce passe en pointillés et son sous-arbre s’efface.`,
            },
          ]}
        />
        <div class="prose after">
          <p>
            <strong>Naissance logique.</strong> <code>get_birth_time</code> <a href={L.getBirth}>renvoie la naissance
            logique</a> quand <code>TRAVERSE_LOGICAL</code> est posé, ce qui est le cas pour un envoi. Un pointeur de bloc
            a deux naissances, et <a href={L.birthComment}>le commentaire qui les définit</a> dit que la physique peut être plus
            petite que la logique pour la déduplication et le clonage de blocs, plus grande pour les blocs déplacés et
            réécrits, et que la logique est celle de la réplication incrémentale. L’envoi <a href={L.logical}>compare la
            logique</a>, le txg où l’utilisateur a modifié la donnée : un bloc dédupliqué ou cloné sur une copie plus
            ancienne est bien envoyé, puisque l’utilisateur l’a écrit après F, et un bloc seulement réécrit ou déplacé
            sur le disque n’est pas renvoyé.
          </p>
          <p><strong>Chaque dnode d’un bloc de dnodes.</strong> Quand un bloc de dnodes est visité, chacun de ses dnodes <a href={L.dnodeLoop}>est confié à ceci</a>.</p>
        </div>
        <Excerpt
          lang={lang}
          path={TR}
          from={534}
          to={550}
          symbol="traverse_dnode"
          notes={[
            {
              from: 534,
              to: 543,
              text: "Le rappel est appelé pour le dnode lui-même. Aucune naissance n’est testée ici : chaque dnode d’un bloc de dnodes visité arrive à <code>send_cb</code>, modifié ou non.",
            },
            {
              from: 545,
              to: 550,
              text: "Puis chacun des pointeurs de bloc du dnode passe par <code>traverse_visitbp</code>, et par son test.",
            },
          ]}
        />
        <div class="prose after">
          <p>
            Voilà pourquoi, en envoyant <code>@s4</code> depuis <code>@s3</code>, le flux contient des OBJECT pour a et
            b, dont les données n’ont pas changé : la suppression de c a réécrit le bloc de dnodes qu’ils partagent avec
            lui. Leurs blocs de données restent sautés, un niveau plus bas.
          </p>
          <p><strong>Des blocs visités aux enregistrements.</strong> Le rappel décide de ce que produit chaque visite.</p>
        </div>
        <Excerpt
          lang={lang}
          path={SEND}
          from={1098}
          to={1120}
          symbol="send_cb"
          notes={[
            {
              from: 1098,
              to: 1108,
              text: "Un dnode devient une plage OBJECT, sauf le meta-dnode, l’objet 0.",
            },
            {
              from: 1109,
              to: 1116,
              text: `Un bloc de dnodes devient un OBJECT_RANGE, que <a href="${L.objectRange}">seul un flux brut écrit</a>.`,
            },
            {
              from: 1117,
              to: 1120,
              text: "Le bloc objset et chaque bloc indirect qui n’est pas un trou ne produisent aucun enregistrement : ils ne sont lus que pour atteindre ce qui est en dessous.",
            },
          ]}
        />
        <Excerpt
          lang={lang}
          path={SEND}
          from={1130}
          to={1146}
          symbol="send_cb"
          notes={[
            {
              from: 1130,
              to: 1135,
              text: "Rien au-delà de la fin de l’objet.",
            },
            {
              from: 1140,
              to: 1146,
              text: `Il reste un bloc de données (un WRITE) ou un trou (un FREE de <a href="${L.holeFile}">sa plage</a> ; un trou parmi les blocs de dnodes <a href="${L.holeMeta}">libère des objets</a>). REDACT relève des envois expurgés.`,
            },
          ]}
        />
        <div class="prose after">
          <p>
            Une plage OBJECT va à <a href={L.dumpDnode}><code>dump_dnode</code></a>. Un emplacement de dnode sans objet
            devient FREEOBJECTS ; un fichier devient OBJECT, avec son tampon bonus en <a href={L.bonus}>charge utile</a>,
            suivi aussitôt d’<a href={L.freeEnd}>un FREE de la fin du fichier jusqu’à <code>DMU_OBJECT_END</code></a>, pour
            qu’un récepteur dont la copie était plus longue la coupe. <a href={L.dumpFree}><code>dump_free</code></a> garde un
            FREE en attente et y fusionne le suivant quand il le prolonge, d’où un seul FREE pour les deux trous de b ; un
            FREE jusqu’à la fin est <a href={L.freeAtOnce}>écrit aussitôt</a>, et tout autre enregistrement
            <a href={L.writeFlush}>écrit d’abord celui en attente</a>. Les FREEOBJECTS sont <a href={L.freeobjMerge}>fusionnés
            de même</a>, et les objets au-delà du dernier bloc de dnodes <a href={L.maxobj}>sont abandonnés</a>. Un flux
            complet porte aussi des libérations, <a href={L.fullFrees}>pour pouvoir être reçu comme un clone</a>.
          </p>
          <p><strong>La somme de contrôle qui court le long du flux.</strong></p>
        </div>
        <Excerpt
          lang={lang}
          path={SEND}
          from={257}
          to={283}
          symbol="dump_record"
          notes={[
            {
              from: 268,
              to: 270,
              text: "La somme fletcher-4 courante est prolongée sur l’enregistrement, jusqu’à ses 32 derniers octets.",
            },
            {
              from: 271,
              to: 277,
              text: `Sauf pour BEGIN, cette valeur va dans ces 32 octets, <code>drr_checksum</code>, <a href="${L.overlay}">superposé à tous les types d’enregistrement</a>.`,
            },
            {
              from: 281,
              to: 283,
              text: `Puis les 32 octets sont sommés, et <a href="${L.payloadSum}">la charge utile</a> après eux. Le <code>drr_checksum</code> de chaque enregistrement est donc le fletcher-4 de tous les octets du flux qui le précèdent, y compris son propre en-tête jusqu’à la somme. La figure montre les 32 bits de poids faible de son dernier mot.`,
            },
          ]}
        />
        <div class="prose after">
          <p>
            END en porte un de plus : <a href={L.end}><code>drr_end.drr_checksum</code></a>, la somme de tout ce qui le
            précède.
          </p>
          <p><strong>Le côté réception vérifie avant d’appliquer.</strong></p>
        </div>
        <Excerpt
          lang={lang}
          path={RECV}
          from={2843}
          to={2868}
          symbol="receive_read_payload_and_next_header"
          notes={[
            {
              from: 2843,
              to: 2851,
              text: `Le récepteur tient sa propre somme : elle <a href="${L.recvBegin}">commence sur tout l’enregistrement BEGIN</a>, se prolonge <a href="${L.recvPayload}">sur chaque charge utile</a>, et ici sur l’en-tête suivant, jusqu’à sa somme de contrôle.`,
            },
            {
              from: 2861,
              to: 2866,
              text: "Un en-tête dont le <code>drr_checksum</code> diffère arrête la réception : <code>ECKSUM</code>. Une somme entièrement nulle n’est pas vérifiée.",
            },
            {
              from: 2868,
              text: "La valeur stockée est ensuite sommée, comme l’a fait l’émetteur.",
            },
          ]}
        />
        <div class="prose after">
          <p>
            Cela se passe quand la charge utile d’un enregistrement et l’en-tête suivant ont été lus, et c’est seulement
            alors que l’enregistrement est <a href={L.queue}>mis en file pour l’écrivain</a> : un enregistrement dont les
            octets ont été abîmés n’est jamais appliqué. END est vérifié une fois de plus, <a href={L.endCheck}>son
            <code>drr_end.drr_checksum</code> contre la somme qui le précède</a>. En cas d’erreur,
            <a href={L.cleanup}>ce que la réception a créé est détruit</a> : le récepteur détient toujours l’instantané de
            départ. Avant tout cela, le BEGIN d’un flux incrémental <a href={L.guids}>nomme l’instantané de départ par son
            GUID</a>, et le récepteur <a href={L.enodev}>le refuse (<code>ENODEV</code>) s’il ne détient pas d’instantané à
            ce GUID</a>.
          </p>
          <p><strong>Des enregistrements répartis par type.</strong> Le fil d’écriture <a href={L.writer}>sort chaque enregistrement de la file</a> et le confie ici.</p>
        </div>
        <Excerpt
          lang={lang}
          path={RECV}
          from={3188}
          to={3213}
          symbol="receive_process_record"
          notes={[
            {
              from: 3189,
              to: 3196,
              text: `OBJECT va à <code>receive_object</code>, qui <a href="${L.recvObject}">crée l’objet, ou garde celui qui existe</a>.`,
            },
            {
              from: 3197,
              to: 3203,
              text: `FREEOBJECTS va à <code>receive_freeobjects</code>, qui <a href="${L.recvFreeobjects}">libère chaque objet existant de la plage</a> : c disparaît.`,
            },
            {
              from: 3204,
              to: 3206,
              text: `WRITE va à <code>receive_process_write_record</code>. FREE, <a href="${L.recvFreeCase}">plus bas</a>, va à <code>receive_free</code>, qui <a href="${L.recvFree}">libère la plage dans l’objet</a>.`,
            },
          ]}
        />
        <div class="prose after">
          <p>
            <strong>Ce que le récepteur obtient.</strong> Parti des fichiers de l’instantané de départ, il retrouve par
            les enregistrements du flux exactement <code>@s4</code> : la figure compare les deux à la fin, pour chaque
            instantané de départ, et ses tests le vérifient contre les enregistrements de chaque flux établis à la main.
          </p>
        </div>
      </div>
    </section>

    <section class="section simplified" aria-labelledby="simplified">
      <h2 id="simplified">Ce que la figure laisse de côté</h2>
      <p class="prose muted">
        La figure est petite : des fichiers de quatre blocs de 512 octets sous un bloc indirect, des blocs de quatre
        dnodes (un vrai bloc de dnodes de 16 Kio en contient 32), un meta-dnode dessiné avec ses deux blocs de dnodes,
        pas de tampon bonus. L’envoi s’y déroule d’une traite là où le code relie plusieurs fils (parcours, fusion,
        lecture, fil principal) par des files qui gardent l’ordre, et le récepteur démarre une fois le flux complet, là où
        le code reçoit par un tube au fil de l’écriture. Les en-têtes suivent la disposition de
        <code>dmu_replay_record_t</code>, seuls les champs utilisés par la figure étant remplis. Les flux expurgés, bruts
        (chiffrés), compressés et reprenables, les données embarquées, WRITE_BYREF et les blocs spill ne sont pas montrés ;
        pas plus que des débits, qui dépendent des disques et du réseau, pas de ce code.
      </p>
    </section>
  </article>
  <RoomNav lang={lang} roomId="send-receive" />
</Base>

