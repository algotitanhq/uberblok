const L = {
  itxAssign: gh(ZL, 693),
  tput: gh(Z, 2216, 2217),
  immediate: gh(Z, 2191),
  hasSlogs: gh("module/zfs/spa_misc.c", 2741, 2744),
  downgrade: gh(ZL, 645, 647),
  createWait: gh(Z, 1034, 1056),
  waiters: gh(Z, 1508, 1524),
  open: gh(Z, 1758),
  close: gh(Z, 1880),
  nextLwb: gh(Z, 1931),
  ready: gh(Z, 1972),
  issued: gh(Z, 2113),
  writeDone: gh(Z, 1605),
  flushDone: gh(Z, 1493),
  nextBlk: gh(Z, 2039),
  slogFlag: gh(Z, 2118, 2119),
  allocRest: gh("module/zfs/zio.c", 4567, 4595),
  vdevLogMg: gh("module/zfs/vdev.c", 1571, 1578),
  clean: gh(Z, 2862),
  parse: gh(Z, 499, 572),
  claimWrite: gh(Z, 634, 655),
  spaClaim: gh("module/zfs/spa.c", 5697, 5699),
  flags: gh("include/sys/zil.h", 76, 77),
