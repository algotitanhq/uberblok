---
// The root picks a language: the one chosen before (switch), else the first of English,
// French and Spanish in the browser's order of preference, else English (D32.1). In production the Worker answers `/` first
// with a 302 (worker/index.js, DECISIONS.md D20.1), which keeps the Referer; this page
// is the fallback (`astro preview`, a build served without the Worker), with every link
// visible for no-JS visitors.
import "../styles/global.css";
import Analytics from "../components/Analytics.astro";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Uberblok</title>
    <meta name="description" content="An interactive museum of ZFS. Un musée interactif de ZFS. Un museo interactivo de ZFS." />
    <link rel="alternate" hreflang="en" href={new URL("/en/", Astro.site).href} />
    <link rel="alternate" hreflang="fr" href={new URL("/fr/", Astro.site).href} />
    <link rel="alternate" hreflang="es" href={new URL("/es/", Astro.site).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (() => {
        let lang = null;
        try { lang = localStorage.getItem("lang"); } catch {}
        if (lang !== "fr" && lang !== "en" && lang !== "es") {
          // The first of English, French and Spanish in the browser's order of preference, else English.
          const prefs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language];
          lang = prefs.map((l) => String(l || "").toLowerCase().split("-")[0]).find((l) => l === "en" || l === "fr" || l === "es") || "en";
        }
        location.replace("/" + lang + "/");
      })();
    </script>
    <Analytics />
  </head>
  <body>
    <main class="wrap pick">
      <p><a href="/en/" hreflang="en">Uberblok, in English</a></p>
      <p lang="fr"><a href="/fr/" hreflang="fr">Uberblok, en français</a></p>
      <p lang="es"><a href="/es/" hreflang="es">Uberblok, en español</a></p>
    </main>
  </body>
</html>

<style>
  .pick {
    padding-block: var(--space-8);
    font-family: var(--font-display);
    font-size: var(--step-2);
  }
</style>
