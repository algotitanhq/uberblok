// Static site served by Cloudflare Workers: static assets, plus a Worker that runs for `/` only
// (worker/index.js: a 302 to the visitor's language, DECISIONS.md D20.1).
// Built by `npm run build` into dist/. Deployed by .github/workflows/ci.yml,
// only once PUBLIC_RELEASE is set (see README "Deploy"). No public preview URLs.
{
  "name": "uberblok",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": false
}
